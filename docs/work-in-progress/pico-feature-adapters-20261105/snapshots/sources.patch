+"""Private source/declared-state-model checks; NEVER execute Qt/native code."""
+from pathlib import Path
+import hashlib,json,re,struct,unittest
+from copy import deepcopy
+
+HERE=Path(__file__).resolve().parent
+ROOT=Path('/home/user/Documents/github/overte-pico-consolidated-20261027')
+SOURCE=(HERE/'SnapshotSettingsLease3.h').read_text()
+
+def body(name):
+    start=SOURCE.index(name)
+    start=SOURCE.index('{',start);level=1;end=start+1
+    # Header has no braces embedded in comments in the selected bodies.
+    while level:
+        if SOURCE[end]=='{':level+=1
+        elif SOURCE[end]=='}':level-=1
+        end+=1
+    return SOURCE[start+1:end-1]
+
+class SourceContract(unittest.TestCase):
+    def test_actual_original_inputs_and_friend_only_afterimages(self):
+        for row in json.loads((HERE/'original-pins.json').read_text()):
+            self.assertEqual(hashlib.sha256((ROOT/row['path']).read_bytes()).hexdigest(),row['sha256'])
+        for path in (HERE/'proposed').rglob('*.h'):
+            original=(HERE/'originals'/path.relative_to(HERE/'proposed')).read_text()
+            # Additions are ONLY gated forward declaration and friendship.
+            after=path.read_text().replace('        friend class overte::e2e::SnapshotSettingsLease3;\n','')
+            after=after.replace('#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)\nnamespace overte::e2e { class SnapshotSettingsLease3; }\n#endif\n','')
+            self.assertEqual(original,after)
+    def test_capture_uses_actual_three_types_and_exact_private_fields(self):
+        self.assertIn('Setting::Handle<QString>& format',SOURCE)
+        self.assertIn('Setting::Handle<float>& duration',SOURCE)
+        self.assertIn('Setting::Handle<bool>& animated',SOURCE)
+        for field in ('_key','_value','_defaultValue','_isInitialized','_isSet','_isDeprecated','_manager'):
+            self.assertIn('handle.'+field,body('static HandleState<T> remember('))
+        for field in ('_settings','_handles','_featureBrowseWriteWorker','_featureBrowseWriteWorkerBirth'):
+            self.assertIn('_manager->'+field,body('bool read('))
+    def test_no_restore_write_or_initializing_handle_call(self):
+        code=re.sub(r'//[^\n]*','',SOURCE)
+        for operation in ('.get(','.isSet(','.set(','.deinit(','.maybeInit(','.sync(', 'invokeMethod(', 'processEvents(', 'wait('):
+            self.assertNotIn(operation,code)
+        self.assertNotIn('handle.remove(',code)
+        self.assertNotIn('_manager->remove(',code)
+        self.assertNotIn('_qSettings',code)
+        self.assertNotRegex(code,r'"settingsRestored",true')
+    def test_lock_body_has_no_serializer_or_external_callback(self):
+        read=body('bool read(')
+        lock=read[read.index('withTryReadLock'):read.index('},0);')]
+        self.assertNotIn('QDataStream',lock)
+        self.assertNotIn('callback',lock)
+        self.assertNotIn('journal',lock)
+        self.assertNotIn('invokeMethod',lock)
+        self.assertIn('result.format=remember(*_format)',lock)
+    def test_closed_command_and_one_shot_before_actual_read(self):
+        fields=re.search(r'command.keys\(\)!=QStringList\{([^}]+)\}',body('static bool commandShape(')).group(1)
+        self.assertEqual(re.findall(r'"([^"]+)"',fields),['expectedSha256','leaseId','restoreId','runId','schemaVersion'])
+        reserve=body('QVariantMap reserveRestoreIntent(')
+        self.assertLess(reserve.index('_state=State::IntentPending'),reserve.index('read(current)'))
+        self.assertIn('digest(current.bytes)!=_expectedSha',reserve)
+        self.assertIn('fresh(_started,_startedEpoch,120000)',reserve)
+        self.assertIn('fresh(_intentStarted,_intentEpoch,1500)',reserve)
+    def test_float_bits_and_absent_invalid_are_separate(self):
+        read=body('bool read(')
+        self.assertIn('result.present.contains(key)',read)
+        self.assertIn('QMetaType::Float',read)
+        self.assertIn('stream.writeRawData',read)
+        self.assertIn('binding!=QWeakPointer<Setting::Manager>{}',read)
+        self.assertIn('result.worker==_original.worker',read)
