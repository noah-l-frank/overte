+here=Path(__file__).parent
+for name,file in (
+    ('adapters.pico4.snapshot_settings_namespace','snapshot_settings_namespace.batch.py'),
+    ('adapters.pico4.snapshot_settings_query_originals','snapshot_settings_query_originals.batch.py'),
