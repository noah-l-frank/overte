+def drop_e2e(text):
+    """Structural preprocessor projection; not a compiler/preprocessor claim."""
+    stack=[];out=[]
+    for line in text.splitlines():
+        if line.lstrip().startswith(('#if ','#ifdef ','#ifndef ')):
+            exclude='OVERTE_E2E_FEATURE_TESTS' in line
+            stack.append((exclude,False));continue
+        if line.lstrip().startswith('#else'):
+            own,flip=stack.pop();stack.append((own,not flip));continue
+        if line.lstrip().startswith('#endif'):
+            stack.pop();continue
+        if any(own and not flip for own,flip in stack):continue
+        out.append(line)
+    return re.sub(r'\s+','', '\n'.join(out))
