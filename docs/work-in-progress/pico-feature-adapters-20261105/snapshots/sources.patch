++    def produce(self,command):
++        if command['operation']=='capture':
++            # Explicit Qt serialization model with >64KiB full original record.
++            opaque=b'DECLARED-QT-MEMENTO-NOT-QDATASTREAM:'+bytes(range(256))*254
++            self.typed_sha=sha(opaque)
++            original=dict(snapshotSettingsMementoVersion=3,runId=command['runId'],leaseId=self.lease_id,
++                managerInstance=self.packet['source']['managerInstance'],snapshotInstance=self.packet['source']['snapshotInstance'],
++                ownerInstance=self.owner_id,encoding='qt512-variant-map-native-fp-tail-v3',bytes=len(opaque),
++                base64=base64.b64encode(opaque).decode(),sha256=self.typed_sha,mutationSequence=0,
++                nativeReferencesRequireOriginalHolder=True,settingsRestored=False)
++            self.original_path=self.base_dir/'feature-pico-snapshot-lease-original.json'
++            self.original_bytes=canonical(original);assert 65536<len(self.original_bytes)<=98304
++            self.original_path.write_bytes(self.original_bytes);self.original_path.chmod(0o600)
++            self.pending_path=self.original_path.with_name(self.original_path.name+'.pending')
++            self.pending_bytes=command['commandId'].encode()+b'\n'+sha(self.original_bytes).encode()+b'\n'
++            self.pending_path.write_bytes(self.pending_bytes);self.pending_path.chmod(0o600)
++            for path in (self.original_path,self.pending_path):
++                owner=object.__new__(OriginalDescriptor);self.native_owners.append(owner)
++                OriginalDescriptor.__init__(owner,path,__import__('os').O_RDONLY|__import__('os').O_NOFOLLOW)
++            self.proof=dict(leaf=self.original_path.name,maximumFileBytes=98304,rootNode=node(self.base_dir),
++                sampleNode=node(self.original_path),sampleStamp=stamp(self.original_path),sha256=sha(self.original_bytes),bytes=len(self.original_bytes),
++                snapshotLeaseCheckpointVersion=3,pendingHeld=True,retired=False,pendingLeaf=self.pending_path.name,
++                pendingBytes=len(self.pending_bytes),pendingSha256=sha(self.pending_bytes),pendingStamp=stamp(self.pending_path))
++        for owner in self.native_owners:owner.require(owner.fd)
++        self.native_current=dict(snapshotSettingsLeaseVersion=3,runId=command['runId'],leaseId=self.lease_id,
++            currentSha256=self.typed_sha,originalSha256=self.typed_sha,requestedEpochMs=self.h.clock(),capturedEpochMs=self.h.clock(),
++            writerQualified=False,settingsRestored=False,nativeSnapshotLeaseEndpointVersion=3,commandId=command['commandId'],operation=command['operation'],
++            ownerInstance=self.owner_id,sequence=len(self.native_commands),intentDurable=False,originalDurable=True,mutationReady=False,
++            backendObserved=False,workerCacheObserved=False,originalCheckpoint=deepcopy(self.proof),intentCheckpoint={})
++        current=self.base_dir/'feature-pico-snapshot-settings-lease.json';current.write_bytes(canonical(self.native_current));current.chmod(0o600)
++        self.native_files=dict(current=current,**{'original-0':self.original_path,'original-1':self.original_path,'original-pending':self.pending_path})
++
++    def sdk(self,args,**options):
++        if args and args[0]=='declared-snapshot-settings2-sdk-never-executed':
++            words=shlex.split(args[4])
++            if words[4]==READ_SCRIPT:
++                assert len(words)==12 and words[5]=='overte-snapshot-lease3'
++                pid,start,requested,deadline,nonce,role=words[6:];assert pid+':'+start==self.h.adb.identity
++                assert int(deadline)-int(requested)==1500 and role in ROLES
++                self.native_reads.append(role)
++                if role not in self.native_files:return subprocess.CompletedProcess(args,1,stdout=b'',stderr=b'')
++                path=self.native_files[role];raw=path.read_bytes();info=self.stamp(path).encode()
++                if role=='original-0':raw=raw[:65536]
++                elif role=='original-1':raw=raw[65536:98304]
++                root=' '.join(hex(int(x))[2:] if i==2 else x for i,x in enumerate(node(self.base_dir))).encode()
++                output=HEAD+nonce.encode()+b'\n'+role.encode()+b'\n'+root+b'\n'+info+b'\n'+raw+TAIL+nonce.encode()+b'\n'+root+b'\n'+info+b'\n'
++                if self.native_fault is not None:output=self.native_fault(output,role,nonce)
++                return subprocess.CompletedProcess(args,0,stdout=output,stderr=b'')
++        return super().sdk(args,**options)
++
