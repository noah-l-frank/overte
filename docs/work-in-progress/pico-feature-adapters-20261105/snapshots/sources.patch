+"""Warm Host admission for private NativeLease3 capture/observe checkpoints.
+
+This grants neither restore writes nor Native/GPU/backend qualification. All
+four actual SDK returns use the existing Raw2 chunks and ONE family budget.
+"""
+# Copyright 2026 Overte contributors.
+# SPDX-License-Identifier: Apache-2.0
+import base64
