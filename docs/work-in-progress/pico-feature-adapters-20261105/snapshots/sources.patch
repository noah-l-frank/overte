++class NativeBoundary(Scope2Boundary):
++    def __init__(self,test):
++        super().__init__(test);MODELS.append(self);self.native_commands=[];self.native_reads=[];self.native_fault=None;self.ignore=False
++        self.native_files={};self.native_owners=[];self.lease_id='e'*32;self.owner_id='f'*32;self.native_current=None
++        self.base_dir=self.endpoint.parent
++        self.added_write=self.h.adb.write_debug_app_file;self.added_binary=self.h.adb.execute_bytes
++        def write(target,package,path,text):
++            command=json.loads(text)
++            if path==ANDROID_CONTROL_COMMAND and command.get('action')==ACTION:
++                self.native_commands.append(deepcopy(command))
++                if not self.ignore:self.produce(command)
++                return
++            return self.added_write(target,package,path,text)
++        def binary(_sdk,args,**options):
++            words=shlex.split(args[1]) if len(args)==2 and args[0]=='exec-out' else []
++            if len(words)>5 and words[4]==READ_SCRIPT:return self.binary_backend.execute_bytes(args,**options)
++            return self.added_binary(args,**options)
++        for change in (patch.object(self.h.adb,'write_debug_app_file',side_effect=write),
++                       patch.object(self.h.adb,'execute_bytes',MethodType(binary,self.h.adb))):
++            change.start();test.addCleanup(change.stop)
