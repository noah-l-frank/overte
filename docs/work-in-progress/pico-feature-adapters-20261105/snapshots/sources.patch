+# Explicit abstract state model for command-attempt/retention boundary negatives.
+# It is independent of C++ execution. Wire, Qt locks, clock calls and native
+# QVariant serialization are NOT qualified by these cases.
+class IntentModel:
+    def __init__(self):
+        self.state='captured';self.original={'present':False,'type':0,'bytes':b'','initialized':False,'set':False}
+        self.current=deepcopy(self.original);self.intent=None;self.reads=0;self.writes=0
+        self.manager=object();self.worker=object();self.original_worker=self.worker
+        self.epoch=100;self.elapsed=0;self.run='r';self.lease='l'
+    def sha(self):
+        row=self.current
+        return hashlib.sha256(repr(sorted(row.items())).encode()).hexdigest()
+    def reserve(self,run,lease,sha,*,delay=0,identity=True):
+        if self.state!='captured' or run!=self.run or lease!=self.lease:return False
+        self.state='intent-pending';self.intent={'sha':sha,'original':self.original}
+        if not identity or self.worker is not self.original_worker or self.elapsed>120000:
+            self.state='refused';return False
+        self.reads+=1;actual=self.sha();self.elapsed+=delay
+        if actual!=sha or delay>1500 or self.elapsed>120000:
+            self.state='refused';return False
+        return True
+
+class DeclaredIntentModel(unittest.TestCase):
+    def test_absent_invalid_not_present_invalid_or_wrong_type(self):
+        for update in ({'present':True},{'type':10,'bytes':b''},{'initialized':True},{'set':True}):
+            m=IntentModel();old=m.sha();m.current.update(update)
+            self.assertFalse(m.reserve('r','l',old));self.assertEqual(m.writes,0)
+            self.assertIs(m.intent['original'],m.original)
+    def test_float_negative_zero_and_nonfinite_payload_not_numeric_equality(self):
+        self.assertNotEqual(struct.pack('!f',0.),struct.pack('!f',-0.))
+        for bits in ('7fc00001','7fc00002','80000000','00000000'):
+            m=IntentModel();m.current['type']=38;m.current['bytes']=bytes.fromhex(bits)
+            before=m.sha();m.current['bytes']=bytes.fromhex('3f800000')
+            self.assertFalse(m.reserve('r','l',before));self.assertEqual(m.writes,0)
+    def test_lost_intent_return_no_second_attempt_or_original_loss(self):
+        m=IntentModel();self.assertTrue(m.reserve('r','l',m.sha()))
+        self.assertFalse(m.reserve('r','l',m.sha()));self.assertEqual(m.reads,1)
+        self.assertIs(m.intent['original'],m.original);self.assertEqual(m.writes,0)
+    def test_foreign_run_lease_zero_read(self):
+        for run,lease in [('foreign','l'),('r','foreign')]:
+            m=IntentModel();self.assertFalse(m.reserve(run,lease,m.sha()));self.assertEqual(m.reads,0)
+            self.assertEqual(m.state,'captured')
+    def test_late_read_sticky_no_fresh_attempt(self):
+        m=IntentModel();self.assertFalse(m.reserve('r','l',m.sha(),delay=1501))
+        self.assertFalse(m.reserve('r','l',m.sha()));self.assertEqual(m.reads,1)
+    def test_original_whole_clock_never_renews(self):
+        m=IntentModel();m.elapsed=119000
+        self.assertFalse(m.reserve('r','l',m.sha(),delay=1100));self.assertEqual(m.elapsed,120100)
+        self.assertEqual(m.state,'refused');self.assertEqual(m.writes,0)
+    def test_foreign_worker_or_manager_zero_current_read(self):
+        m=IntentModel();m.worker=object();self.assertFalse(m.reserve('r','l',m.sha()));self.assertEqual(m.reads,0)
+        m=IntentModel();self.assertFalse(m.reserve('r','l',m.sha(),identity=False));self.assertEqual(m.reads,0)
+
+if __name__=='__main__':unittest.main(verbosity=2)
