+#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)
+            SnapshotSettingsAccess snapshotAccess(this,overte::e2e::SnapshotSettingsBarrier3::Kind::Read);
+#endif
+
+            maybeInit();
+            return _isSet;
+        }
+
+#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)
+        QVariantMap featureSnapshotDurationState() const {
+#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)
+            SnapshotSettingsAccess snapshotAccess(this,overte::e2e::SnapshotSettingsBarrier3::Kind::Read);
+#endif
+
+            static_assert(std::is_same<T,float>::value,"Only the original Snapshot duration handle is observed");
+            if (!QCoreApplication::instance() || !QCoreApplication::arguments().contains("--testScript")) { return {}; }
+            // The bounded serializer is reused; Avatar key/barrier authority is not.
+            // Typed bytes retain negative zero and nonfinite values without JSON numeric conversion.
+            const auto value=overte::e2e::avatarPreferenceRaw(true,QVariant::fromValue(_value));
+            const auto fallback=overte::e2e::avatarPreferenceRaw(true,QVariant::fromValue(_defaultValue));
+            if(value.isEmpty() || fallback.isEmpty()) {return {};}
+            return {{"initialized",featureSnapshotCacheInitialized()},{"set",_isSet},{"value",value},{"defaultValue",fallback}};
+        }
+        QVariantMap featureSnapshotFormatState() const {
+#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)
+            SnapshotSettingsAccess snapshotAccess(this,overte::e2e::SnapshotSettingsBarrier3::Kind::Read);
+#endif
+
+            static_assert(std::is_same<T,QString>::value,"Only the original Snapshot string handle is observed");
+            if (!QCoreApplication::instance() || !QCoreApplication::arguments().contains("--testScript")) { return {}; }
+            return {{"initialized",featureSnapshotCacheInitialized()},{"set",_isSet},
+                {"value",QVariant::fromValue(_value)},{"defaultValue",QVariant::fromValue(_defaultValue)}};
+        }
+#endif
+
+        /**
+         * @brief Returns the default value for this setting
+         *
+         * @return const T& Default value for this setting
+         */
+        const T& getDefault() const {
+#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)
+            SnapshotSettingsAccess snapshotAccess(this,overte::e2e::SnapshotSettingsBarrier3::Kind::Read);
+#endif
+
+            return _defaultValue;
+        }
+
+        /**
+         * @brief Sets the value to the default
+         *
+         */
+        void reset() {
+            set(_defaultValue);
+        }
+
+        /**
+         * @brief Set the setting to the specified value.
+         *
+         * The value will be stored in the configuration file.
+         *
+         * @param value Value to set the setting to.
+         */
+        void set(const T& value) {
+#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)
+            SnapshotSettingsAccess snapshotAccess(this,overte::e2e::SnapshotSettingsBarrier3::Kind::Write);
+#endif
+
+#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)
+            AvatarPreferenceMutation avatarMutation(this);
+#endif
+            maybeInit();
+
+            // qCDebug(settings_handle) << "Setting" << this->getKey() << "to" << value;
+
+            if ((!_isSet && (value != _defaultValue)) || _value != value) {
+                _value = value;
+                _isSet = true;
+                save();
+            }
+            if (_isDeprecated) {
+                deprecate();
+            }
+        }
+
+        /**
+         * @brief Remove the value from the setting
+         *
+         * This returns the setting to an unset state. If read, it will be read as the default value.
+         *
+         */
+        void remove() {
+#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)
+            SnapshotSettingsAccess snapshotAccess(this,overte::e2e::SnapshotSettingsBarrier3::Kind::Write);
+#endif
+
+#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)
+            AvatarPreferenceMutation avatarMutation(this);
+#endif
+            maybeInit();
+            if (_isSet) {
+                _isSet = false;
+                save();
+            }
+        }
+
+#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)
+        QVariantMap e2ePreferenceSnapshot() const {
+            auto result=e2ePreferenceInterface();if(result.isEmpty()) {return {};}
+            const auto value=overte::e2e::avatarPreferenceRaw(true,QVariant::fromValue(_value));
+            const auto fallback=overte::e2e::avatarPreferenceRaw(true,QVariant::fromValue(_defaultValue));
+            if(value.isEmpty() || fallback.isEmpty()) {return {};}
+            result["nativePreferenceHandleVersion"]=1;result["value"]=value;result["default"]=fallback;result["deprecated"]=_isDeprecated;return result;
+        }
+#endif
+
+    protected:
+        virtual void setVariant(const QVariant& variant) override;
+        virtual QVariant getVariant() override { return QVariant::fromValue(get()); }
+
+    private:
+#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)
+        friend class overte::e2e::AvatarPreferenceSnapshot;
+        friend class overte::e2e::SnapshotSettingsLease3;
+#endif
+        void deprecate() {
+#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)
+            SnapshotSettingsAccess snapshotAccess(this,overte::e2e::SnapshotSettingsBarrier3::Kind::Write);
+#endif
+
+#if defined(OVERTE_E2E_FEATURE_TESTS) && defined(ANDROID_APP_PICO_INTERFACE)
+            AvatarPreferenceMutation avatarMutation(this);
+#endif
+            if (_isSet) {
+                if (get() != getDefault()) {
