+// In particular, a returned intent NEVER means settingsRestored. Source2 is
+// unchanged. Actual Qt/C++ execution and the future Snapshot callsite are untested.
+class SnapshotSettingsLease3 final {
+public:
+    enum class State { Cold, Capturing, Captured, IntentPending, Refused };
+    SnapshotSettingsLease3() = default;
+    SnapshotSettingsLease3(const SnapshotSettingsLease3&) = delete;
+    SnapshotSettingsLease3& operator=(const SnapshotSettingsLease3&) = delete;
+    SnapshotSettingsLease3(SnapshotSettingsLease3&&) = delete;
+    SnapshotSettingsLease3& operator=(SnapshotSettingsLease3&&) = delete;
+
+    // Native caller supplies the ACTUAL persistent Snapshot handles, not values
+    // decoded from a Host command. Direct private fields avoid get/isSet/init.
+    bool capture(QObject* snapshot, Setting::Handle<QString>& format,
+            Setting::Handle<float>& duration, Setting::Handle<bool>& animated,
+            const QSharedPointer<Setting::Manager>& actualManager,const QString& runId,
