+from adapters.chat_journey.source_chunks import json_digest
+from adapters.normal_feature_state import PrivateFeatureState
+from adapters.pico4.lifecycle_process_file import LifecycleProcessFile
+from adapters.pico4.snapshot_settings_codec import COPY_RESERVATION
+from adapters.script_journey.history import canonical,MAX_FRAMES,MAX_RAW
+
+NAME='snapshot-settings-native-lease3.json'
+ACTION='feature-pico-snapshot-settings-lease'
+NATIVE_LEAVES=5 # Current response, original+pending, future intent+pending.
+NATIVE_DESCRIPTOR_SLOTS=12 # Two publishers: root/file/pending original+alias pairs.
+NATIVE_RESOURCES=2*(98304+8192+2*512)+8192+NATIVE_DESCRIPTOR_SLOTS*512
+UNRESOLVED=[]
+
+
+def nonce(value):return type(value) is str and re.fullmatch('[0-9a-f]{32}',value) is not None
+def sha(value):return type(value) is str and re.fullmatch('[0-9a-f]{64}',value) is not None
+def digest(raw):return hashlib.sha256(raw).hexdigest()
+
+
+def command_shape(value,run):
+    exact(value,{'schemaVersion','action','commandId','runId','operation','leaseId','restoreId','expectedSha256'})
+    need(type(value['schemaVersion']) is int and value['schemaVersion']==3 and value['action']==ACTION
+        and type(value['action']) is str and type(value['runId']) is str and value['runId']==run
+        and nonce(value['commandId']) and type(value['operation']) is str and value['operation'] in ('capture','observe')
+        and type(value['restoreId']) is str and type(value['expectedSha256']) is str
+        and value['restoreId']==value['expectedSha256']==''
+        and (value['leaseId']=='' if value['operation']=='capture' else nonce(value['leaseId'])))
+
+
+def file_stamp(text):
+    fields=text.split();need(len(fields)==12)
+    def ns(date,clock,zone):
+        seconds,fraction=clock.split('.');need(len(fraction)==9)
+        epoch=int(datetime.strptime(date+' '+seconds+' '+zone,'%Y-%m-%d %H:%M:%S %z').timestamp())
+        return str(epoch*10**9+int(fraction))
+    return [str(int(x,16) if i==2 else int(x)) for i,x in enumerate(fields[:6])]+[
+        ns(*fields[6:9]),ns(*fields[9:12])]
+
+
+class SnapshotSettingsNativeLease3:
+    @classmethod
+    def create(cls,context):
+        from adapters.pico4.snapshot_settings_scope2_baseline import PicoSnapshotSettingsScope2Baseline
+        need(type(context) is PicoSnapshotSettingsScope2Baseline)
+        raw=context.raw;raw.lock.assert_held();context.bound()
+        need(raw.native_lease3 is raw.original_native_lease3 is None and raw.state['stage']=='ready'
+            and context.parent.state['stage']=='prepared' and not context.parent.state['deliveries']
+            and context.state['stage']=='captured' and context.reader.active is False)
+        owner=object.__new__(cls);raw.native_lease3=raw.original_native_lease3=owner
+        # Native3 has no retirement API: original checkpoint/pending custody
+        # remains unresolved even on a successful passive Host capture. Keep
+        # the SAME Raw owner strongly visible before any constructor I/O, so
+        # missing marker names cannot authorize generic product cleanup.
+        from adapters.pico4.snapshot_settings_query_originals import UNRESOLVED as raw_unresolved
+        if not any(item is raw for item in raw_unresolved):raw_unresolved.append(raw)
+        try:cls.__init__(owner,context);return owner
+        except BaseException:
+            owner.failed=True
+            if not any(x is owner for x in UNRESOLVED):UNRESOLVED.append(owner)
+            raw.poison();raise
+
+    def __init__(self,context):
+        self.context=self.original_context=context;self.raw=self.original_raw=context.raw
+        self.lock=context.lock;self.run=context.run
+        self.path=self.original_path=self.lock.path.with_name(NAME)
