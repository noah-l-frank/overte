+    const auto digest = state->receiptDigest(request,receipt);
+    if (digest.isEmpty()) { return {}; } // Only native-issued receipts of a retired acquisition.
+    auto nonce = receipt; if (nonce.startsWith("ios-")) { nonce.remove(0,4); }
