+    SnapshotSettingsAccess::SnapshotSettingsAccess(const Interface* handle,overte::e2e::SnapshotSettingsBarrier3::Kind kind) {
+        using Barrier=overte::e2e::SnapshotSettingsBarrier3;
+        if(!handle || !QCoreApplication::instance() || !QCoreApplication::arguments().contains("--testScript")
+                || Barrier::classify(handle->_key)==Barrier::Key::Unrelated) {return;}
+        const auto nested=Barrier::current();
+        if(nested) {
+            const auto bound=handle->_manager.lock();
+            if(bound && bound->_featureSnapshotLeaseBarrier!=nested) {
+                nested->invalidate();if(bound->_featureSnapshotLeaseBarrier) {bound->_featureSnapshotLeaseBarrier->invalidate();}
+            }
+            _access=std::make_unique<Barrier::Access>(nested,handle->_key,kind);return;
+        }
+        if(!DependencyManager::isSet<Manager>()) {return;}
+        const auto current=DependencyManager::get<Manager>();
+        const auto bound=handle->_manager.lock();
+        // A foreign original binding cannot silently adopt the current Manager.
+        if((bound && bound!=current) || (!bound && handle->_manager!=QWeakPointer<Manager>{})) {
+            if(current && current->_featureSnapshotLeaseBarrier) {current->_featureSnapshotLeaseBarrier->invalidate();}
+        }
+        _manager=bound ? bound : current;
+        if(_manager) {_access=std::make_unique<Barrier::Access>(_manager->_featureSnapshotLeaseBarrier,handle->_key,kind);}
+    }
+    SnapshotSettingsAccess::~SnapshotSettingsAccess()=default;
+    AvatarPreferenceMutation::AvatarPreferenceMutation(Interface* handle) {
+        if(!handle || !QCoreApplication::instance() || !QCoreApplication::arguments().contains("--testScript")
+                || !overte::e2e::avatarPreferenceKey(handle->_key) || !DependencyManager::isSet<Manager>()) {return;}
+        _manager=DependencyManager::get<Manager>();
+        if(_manager) {_mutation=std::make_unique<overte::e2e::AvatarPreferenceBarrier::Mutation>(_manager->_featureAvatarPreferencesBarrier,handle->_key);}
+    }
+    AvatarPreferenceMutation::~AvatarPreferenceMutation()=default;
+    QVariantMap Interface::e2ePreferenceInterface() const {
+        if(!overte::e2e::avatarPreferenceKey(_key) || !DependencyManager::isSet<Manager>()) {return {};}
+        const auto manager=DependencyManager::get<Manager>();if(!manager || !manager->_featureAvatarPreferencesBarrier.reading()) {return {};}
+        const auto original=_manager.lock();if(_isInitialized && (!original || original!=manager)) {return {};}
+        return {{"key",_key},{"isSet",_isSet},{"initialized",_isInitialized},{"managerBound",bool(original)}};
+    }
