+    def read_pico_tablet_snapshot(self, target: str, identity: str) -> dict:
+        attempts, interval = self.probe_retry_policy()
+        package = self.profile["package"]
+        for attempt in range(attempts):
+            raw = self.adb.read_debug_app_file(
