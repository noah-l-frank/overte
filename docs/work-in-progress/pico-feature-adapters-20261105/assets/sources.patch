+def quoted_bytes(text):
+    """Exact ensure_ascii JSON string length without constructing that string."""
+    need(type(text) is str)
+    count = 2
+    for character in text:
+        code = ord(character)
+        if character in ('"', '\\', '\b', '\f', '\n', '\r', '\t'):
+            count += 2
+        elif code < 32 or 127 <= code <= 65535:
+            count += 6
+        elif code > 65535:
+            count += 12
+        else:
+            count += 1
+    return count
