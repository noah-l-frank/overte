+"""PRIVATE declared Node producer attachment; unavailable to Native SDK birth.
+
+This is a counter profile, not a Native allocation or SourceReady authority.
+The original producer owns the original bank throughout. Both work claims are
+permanent before its fixture constructor; the real bank decides all admissions.
+"""
+from adapters.native_feature_observation import need
+from adapters.pico4.audio_raw_archive import AudioRawArchive
+from adapters.pico4.probe_originals import same_callable
+
+NODE_WORK=8*1048576
+HOST_WORK=1048576
+BODY_LIMIT=65536
+JOIN_METADATA=4096
+SOURCE_RESOURCE=4*65536 # Additive actual copied-file/descriptor/footer work, before any source file opens.
+PERMANENT=HOST_WORK+JOIN_METADATA+SOURCE_RESOURCE
+
+class SharedDeclaredPeople2:
+    def __init__(self,original):
+        need(type(original.bank) is AudioRawArchive and original.bank.path.parent==original.path
+            and original.bank.lock is original.lock and original.bank.identity.__self__ is original
+            and same_callable(original.bank.identity,original.identity)
+            and same_callable(original.bank.other_bill,original.bill)
+            and original.family is None and original.profile_work_booked is True)
+        self.original=original;self.bank=original.bank;self.path=original.path;self._family=None
+        self.pins=(original,original.bank,original.path,original.lock,original.identity,original.bill,original.producer_bill)
+        self.check()
+    def check(self):
+        original=self.original
+        need(type(self) is SharedDeclaredPeople2 and original is self.pins[0] and self.bank is self.pins[1]
+            and original.bank is self.bank and self.path is self.pins[2] and original.path is self.path
+            and original.lock is self.pins[3] and self.bank.lock is original.lock
+            and same_callable(original.identity,self.pins[4]) and same_callable(original.bill,self.pins[5])
+            and same_callable(original.producer_bill,self.pins[6]) and original.profile_work_booked is True
+            and original.family is self._family and original._family_owner is self._family)
+        original.identity();need(same_callable(self.bank.identity,original.identity)
+            and same_callable(self.bank.other_bill,original.bill))
+    def bind(self,family):
+        from adapters.pico4.avatar_people2_family import PicoParentPeople2Family
+        self.check()
+        need(self._family is None and type(family) is PicoParentPeople2Family
+            and family.declared_shared is self and family.bank is None and family.path==self.path)
+        self._family=family;self.original._family_owner=family;self.original.family=family
+        self.check()
+    def producer_bill(self):
+        self.check();value=self.original.producer_bill()
+        need(type(value) is dict and set(value)=={'parts','decodedBytes','storedBytes'}
+            and all(type(v) is int and v>=0 for v in value.values())
+            and value['decodedBytes']>=NODE_WORK and value['storedBytes']>=NODE_WORK)
+        return value
+
+
+def extent(raw):
+    """Additional declared-only token gate BEFORE any JSON graph exists."""
+    need(type(raw) is bytes and len(raw)<=BODY_LIMIT)
+    index=tokens=0
+    while index<len(raw):
+        if raw[index]==34:
+            index+=1
+            while index<len(raw) and raw[index]!=34:
+                if raw[index]==92:index+=1;need(index<len(raw))
+                index+=1
+            need(index<len(raw));index+=1;tokens+=1
+        else:index+=1;tokens+=1
+        need(tokens<=4096)
+    return tokens
