+# original wire is emitted verbatim between physical process/file bookends.
+printf 'OVT_PICO_PEOPLE_STATE2_SDK_V1\n%s\n%s\n%s\n%s\n%s\n%s\n' "$tx_nonce" "$tx_original_identity" "$tx_root_before" "$tx_file_before" "$tx_receipt_before" "$tx_receipt_bytes"
