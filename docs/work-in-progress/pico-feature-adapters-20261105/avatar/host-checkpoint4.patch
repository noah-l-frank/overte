+            name=actual['userName'];stamp=dict(people2RowVersion=1,familyId=f.native_family_id,
+                accountInstance=f.account_instance,accountGeneration=str(f.account_generation),principalSha256=f.principal_sha256,
+                authOriginSha256=f.auth_origin_sha256,tokenExpiryEpochMs=str(f.token_expiry_epoch_ms),modelGeneration=1,
+                modelRevision=source['revision'],index=actual['index'],usernameSha256=hashlib.sha256(name.encode('ascii')).hexdigest(),
+                connectionSha256=hashlib.sha256(actual['connection'].encode('ascii')).hexdigest())
+            for identifier in ('people.row.'+str(actual['index']),'people.remove.'+name):
+                token=hashlib.sha256(canonical(dict(stamp=stamp,id=identifier,sequence=self.sequence))).hexdigest()[:32]
+                rows.append(dict(id=identifier,token=token,enabled=True,focused=False,inputReady=True,
+                    consent=source['consent'],tab=source['tab'],peerSession='',userName=name,people2Row=stamp))
+        value=dict(avatarPeopleControlsVersion=1,open=source['open'],ready=True,
+            bridgeId=scope.family.parent.binding['sessionId'],generation=self.generation,lastCommandSequence=self.sequence,
+            elapsedMs=int((time.monotonic()-scope.started)*1000),processId=scope.family.parent.pid,controls=rows)
+        raw=canonical(value);assert len(raw)<=262144
+        token=scope.bank.reserve('declared-widget-original',dict(nodeModelOriginal=scope.current_source_ref),262144)
