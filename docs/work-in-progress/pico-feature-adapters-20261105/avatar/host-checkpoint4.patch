+def extent(raw):
+    """Closed prospective graph envelope before the external JSON parser."""
+    need(type(raw) is bytes and len(raw)<=CAP)
+    tokens=depth=index=0
+    while index<len(raw):
+        c=raw[index]
+        if c==34:
+            tokens+=1;index+=1;size=0
+            while index<len(raw) and raw[index]!=34:
+                if raw[index]==92:index+=1;need(index<len(raw))
+                size+=1;need(size<=4096);index+=1
