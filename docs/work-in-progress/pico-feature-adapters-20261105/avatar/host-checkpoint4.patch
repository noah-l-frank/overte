+            and original_reader.url==family.parent.phase.client.url and original_reader.url.startswith('https://'))
+        need(cls is People2BackendSource and (original_tls is None or type(original_tls) is ssl.SSLContext)
+            and type(original_instance) is str and len(original_instance)==32
+            and all(c in '0123456789abcdef' for c in original_instance))
+        need(all(type(row) is dict for row in PARTIALS)
+            and not any(row.get('family') is family for row in PARTIALS))
+        work=family.bank.reserve('external-people-witness-work',dict(externalPeopleWitnessWorkVersion=1),1,side_bytes=16384) # BEFORE allocation; pending through terminal.
+        held=dict(family=family,work=work,owner=None);PARTIALS.append(held)
+        owner=cls.__new__(cls);held['owner']=owner
+        owner.instance=original_instance
