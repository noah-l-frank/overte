+"""PRIVATE actual normal People row/Remove writer over one Source2 family.
+
+This component joins current account/model to actual widget originals. It does
+not supply an independent backend actor, consent completion or final cleanup.
+"""
+from copy import deepcopy
+from dataclasses import asdict
+import hashlib,secrets,shlex,subprocess,sys
+from adb_transport import AdbTransport
+from adapters.native_feature_observation import need,exact
+from adapters.pico4.assets_transport import READ_SCRIPT,read_body
+from adapters.pico4.avatar_people_ui import TokenAvatarPeopleUI,PicoAvatarPeopleIO,people2_row,project
+from adapters.pico4.avatar_urls import PicoAvatarUrls
+from adapters.pico4.navigation import NativeNavigationIO,decode
+from adapters.script_journey.history import canonical
+
+LIMIT=262144
+WIRE=LIMIT+4096
+# Same original full physical read, narrowed to navigation's existing limit.
+# No default Assets transport or protocol constant is modified.
+UI_SCRIPT=READ_SCRIPT.replace('head -c 4194305','head -c 262145').replace(
+    'check_process && check_time || exit 1',
+    'check_process && check_time || exit 1\n[ "$(stat -c \'%d %i %f %u %h\' files/overte-e2e)" = "$7" ] || exit 1')
+PARTIALS=[]
+
+def lexical_ui(raw):
+    """Bound the closed private UI parse workspace before JSON allocation."""
+    need(type(raw) is bytes and len(raw)<=LIMIT)
+    depth=tokens=i=0
+    while i<len(raw):
+        c=raw[i]
+        if c==34:
+            tokens+=1;i+=1;size=0
+            while i<len(raw) and raw[i]!=34:
+                if raw[i]==92:i+=1;need(i<len(raw))
+                size+=1;need(size<=24576);i+=1
+            need(i<len(raw));i+=1
+        else:
+            if c in (123,91):depth+=1;need(depth<=16)
+            if c in (125,93):depth-=1;need(depth>=0)
+            if c not in (9,10,13,32):tokens+=1
+            i+=1
+        need(tokens<=32768)
+    need(depth==0)
+
+class PicoPeople2UiWriter:
+    @classmethod
+    def birth(cls,family,adapter,target):
+        from adapters.pico4.avatar_people2_family import PicoParentPeople2Family
+        need(type(family) is PicoParentPeople2Family and family.ui_writer is None
+            and ((family.slot is not None and adapter.adb is family.sdk[0] and target==family.sdk[1])
+                or (family.sdk is None and family.declared_shared is not None and target=='DECLARED'
+                    and type(adapter.adb) is AdbTransport)))
+        family.check_total()
+        current=family.bill();raw=family.bank.bill()
+        need(current['parts']+raw['parts']+sum(row['parts'] for row in family.bank.state['pending'])
+            +(12 if family.declared_shared is None else 0)<=512)
+        owner=cls.__new__(cls);PARTIALS.append(owner);family.ui_writer=family._ui_writer=owner
+        owner.family=family;owner.adapter=adapter;owner.target=target;owner.rows=[]
+        owner.failed=False;owner.first_error=None;owner.acquired=None;owner.issued=None
+        owner.pending=None;owner.last_ui=None;owner.slots=[];owner.frame=None;owner.selected=None
+        owner.active_action=False;owner.deadline=None;owner.business_pending=False
+        owner.removal_before=None;owner.removal=None;owner.effect_acquired=None;owner.effect_graph=None
+        owner.binary=AdbTransport.execute_bytes
+        owner._pins=(family,adapter,target,adapter.adb,owner.binary)
+        try:owner.identity();return owner
+        except BaseException:owner.fail();raise
+
+    def identity(self):
+        need(not self.failed and self.family is self._pins[0] and self.adapter is self._pins[1]
+            and self.target is self._pins[2] and self.adapter.adb is self._pins[3]
+            and self.binary is self._pins[4] and self.family.ui_writer is self)
+        self.family.check_total();self.action_guard()
+
+    def action_guard(self):
+        need(type(self.active_action) is bool)
+        if self.active_action:need(type(self.deadline) in (int,float) and self.family.parent.monotonic()<self.deadline)
+
+    def fail(self):
+        self.failed=self.family.failed=True
+        if self.first_error is None:self.first_error=sys.exc_info()
+        if self.family.first_error is None:self.family.first_error=self.first_error
+
+    def retain(self,raw):
+        self.acquired=raw;need(self.issued is not None)
+        result=self.family.bank.retain(self.issued,raw);self.issued=None;self.acquired=None
+        return result
+
+    def record(self,role,value):
+        raw=canonical(value);need(len(raw)<=4096)
+        self.issued=self.family.bank.reserve(role,value,4096)
+        return self.retain(raw)
+
+    def bind_native(self,io):
+        self.identity();need(type(io) is NativeNavigationIO and io.adapter is self.adapter
+            and io.target==self.target and io.identity==self.family.parent.binding['processIdentity']
+            and len(self.slots)<16 and getattr(io._read,'__func__',None) is NativeNavigationIO._read)
+        def read(kind):
+            try:
