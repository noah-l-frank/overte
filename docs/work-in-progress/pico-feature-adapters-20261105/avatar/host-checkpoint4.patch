+        owner.role_tokens=owner._role_tokens=(original_role_tokens['primary'],original_role_tokens['peer']);owner.role_reads=[]
+        owner.failed=False;owner.first_error=None;owner.previous=None;owner.last=None;owner.issued=None
+        owner.origin=original_reader.url.removesuffix('/feature-fixture/v1')
