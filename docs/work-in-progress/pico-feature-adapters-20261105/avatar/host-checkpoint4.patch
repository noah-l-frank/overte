+"""PRIVATE explicit binding to the EXISTING binary SDK primitive.
+
+No device/SDK constructor or command has run for this afterimage. Device use,
+if later authorized, belongs to the Proxmox/Jenkins environment, never a local
+fallback. This wrapper itself supplies no phase/admission/Native authority.
+"""
+from adb_transport import AdbTransport
+from adapters.native_feature_observation import need,number
+from adapters.pico4.avatar_people2_transport import command
+
+
+class People2SDKExchange:
+    def __init__(self,original_adb,original_target,original_process_identity,original_family):
+        need(type(original_adb) is AdbTransport and type(original_target) is str and original_target
+            and type(original_process_identity) is str)
+        from adapters.pico4.avatar_people2_family import PicoParentPeople2Family
+        need(type(original_family) is PicoParentPeople2Family);self.family=self._family=original_family
+        self.adb=original_adb;self.target=original_target;self.identity=original_process_identity
+        # Bind the exact ordinary unbound primitive rather than resolving a
+        # descriptor/mutable instance method after an issued reservation.
+        self._binary=AdbTransport.execute_bytes
+        self._pins=(original_adb,original_target,original_process_identity,self._binary)
+
+    def __call__(self,value,*,timeout):
+        need(self.adb is self._pins[0] and self.target==self._pins[1] and self.identity==self._pins[2]
+            and self._binary is self._pins[3] and number(timeout,0,1.5) and timeout>0)
+        need(self.family is self._family);self.family.identity()
+        argv,original_stdin=command(value,self.identity)
+        if self.family.ui_writer is not None:self.family.ui_writer.action_guard()
+        # ONE actual SDK return, with literal original stdout and timeout cause
+        # left untouched for the owning Reader's pre-issued raw reservation.
+        return self._binary(self.adb,argv,target=self.target,timeout=timeout,check=False,input_bytes=original_stdin)
