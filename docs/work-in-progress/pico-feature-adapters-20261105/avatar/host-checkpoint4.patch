+[ "$(printf %s "$tx_file_before" | wc -c)" -le 512 ] && [ "$(printf %s "$tx_root_before" | wc -c)" -le 512 ] && [ "$(printf %s "$tx_receipt_before" | wc -c)" -le 512 ] || exit 1
