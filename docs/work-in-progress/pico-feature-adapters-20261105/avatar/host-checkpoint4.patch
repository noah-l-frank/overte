+"""Actual new DELETE and current model absence after a known normal input.
+
+Old input evidence is historical integrity here. The after source remains a
+fresh CURRENT claim under its original clock. No backend state is invented.
+"""
+from dataclasses import dataclass
+import hashlib,math
+from urllib.parse import quote
+from adapters.native_feature_observation import need
+from adapters.pico4.avatar_people2_reader import People2Frame,lexical,model_summary,reply_summary
+from adapters.pico4.probe_originals import strict_json
+
+@dataclass(frozen=True,slots=True)
+class People2Removal:
+    before_raw_sha256:str
+    after_raw_sha256:str
+    account_instance:str
+    account_generation:int
+    principal_sha256:str
+    username_sha256:str
+    model_generation:int
+    model_revision:int
+    delete_request:int
+    response_id:str
+    response_sha256:str
+    response_bytes:int
+    request_target:str
+
+def historical_input(writer,before,username):
+    family=writer.family;reader=family.reader
+    references=[r for r in family.refs if r['raw']['read']==before.raw_read and r['raw']['sha256']==before.raw_sha256]
+    need(len(references)==1)
+    wire=family.bank.literal(references[0]['raw']);writer.effect_acquired=wire
+    need(type(wire) is bytes and hashlib.sha256(wire).hexdigest()==before.raw_sha256)
+    body=wire[before.source_offset:before.source_offset+before.source_bytes]
+    need(hashlib.sha256(body).hexdigest()==before.body_sha256);lexical(body)
