+VERSION=1
+RECEIPT_LIMIT=4096
+FILE_LIMIT=262144
+COMMAND_LIMIT=1024
+HEADER=b'OVT_PICO_PEOPLE_STATE2_SDK_V1\n'
+FOOTER=b'\nOVT_PICO_PEOPLE_STATE2_SDK_END_V1 '
+SCRIPT=r'''
+umask 077
+tx_root=files/overte-e2e
+tx_file=$tx_root/feature-pico-avatar-people-state2.json
+tx_receipt=$tx_root/feature-pico-avatar-people-state2-receipt.json
+tx_pending=$tx_root/feature-pico-people-state2-request.pending
+tx_control=$tx_root/android-control-command.json
+tx_nonce=$1
+tx_pid=$2
+tx_birth=$3
+tx_command_sha=$4
+tx_wire_limit=$5
+tx_file_limit=$6
+tx_identity() {
+    tx_stat=$(cat /proc/"$tx_pid"/stat) || return 1
+    [ "${tx_stat%% *}" = "$tx_pid" ] || return 1
+    tx_fields=${tx_stat##*) }
+    set -- $tx_fields
+    [ "$#" -ge 20 ] || return 1
+    shift 19
+    [ "$1" = "$tx_birth" ] || return 1
+    printf '%s:%s' "$tx_pid" "$tx_birth"
+}
+tx_private_file() {
+    [ -f "$1" ] && [ ! -L "$1" ] && [ "$(stat -c %h "$1")" = 1 ] &&
+    [ "$(stat -c %a "$1")" = 600 ] && [ "$(stat -c %u "$1")" = "$(id -u)" ]
+}
+[ -d files ] && [ ! -L files ] && [ -d "$tx_root" ] && [ ! -L "$tx_root" ] || exit 1
+[ "$(stat -c %a "$tx_root")" = 700 ] && [ "$(stat -c %u "$tx_root")" = "$(id -u)" ] || exit 1
