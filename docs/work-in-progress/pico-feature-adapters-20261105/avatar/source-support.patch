+        # Charge FULL new work, then original Raw prospective admission BEFORE
+        # allocating this Reader or delegating any capture/guard constructor.
+        need(type(family) is People2FamilyScope and type(family.raw_holders) is list and type(family.bank) is AudioRawArchive)
+        need(not any(type(v) is cls for v in family.raw_holders))
