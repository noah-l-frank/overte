+            name=actual['userName'];stamp=dict(people2RowVersion=1,familyId=f.native_family_id,
+                accountInstance=f.account_instance,accountGeneration=str(f.account_generation),principalSha256=f.principal_sha256,
+                authOriginSha256=f.auth_origin_sha256,tokenExpiryEpochMs=str(f.token_expiry_epoch_ms),modelGeneration=1,
+                modelRevision=source['revision'],index=actual['index'],usernameSha256=hashlib.sha256(name.encode('ascii')).hexdigest(),
+                connectionSha256=hashlib.sha256(actual['connection'].encode('ascii')).hexdigest())
