+[ ! -e "$tx_pending" ] && [ ! -L "$tx_pending" ] || exit 1
+[ ! -e "$tx_root/feature-pico-emote-capture-pending.json" ] && [ ! -L "$tx_root/feature-pico-emote-capture-pending.json" ] || exit 1
