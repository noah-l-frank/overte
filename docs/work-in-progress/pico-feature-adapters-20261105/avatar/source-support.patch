+"""Declared Native serializer of actual running Node/QML observations.
+
+The two files/OFD windows are actual Host resources. They are never Native
+publisher, account-generation, allocator or Qt-execution qualification.
+"""
+import datetime,hashlib,os,time
+from adapters.native_fd_owner import OriginalDescriptor,require_directory
+from adapters.pico4.avatar_people2_transport import HEADER,FOOTER
+from adapters.pico4.emote_stream_wire import physical_stamp
+from adapters.script_journey.history import canonical
+from feature_journeys.avatar_people2_host_model import BODY_LIMIT
+
+def stat8(v):return (v.st_dev,v.st_ino,v.st_mode,v.st_uid,v.st_nlink,v.st_size,v.st_mtime_ns,v.st_ctime_ns)
+def description(v):
+    def stamp(ns):
+        sec,nano=divmod(ns,1000000000)
+        return datetime.datetime.fromtimestamp(sec,datetime.timezone.utc).strftime('%Y-%m-%d %H:%M:%S')+'.'+str(nano).zfill(9)+' +0000'
+    return ' '.join((str(v.st_dev),str(v.st_ino),format(v.st_mode,'x'),str(v.st_uid),str(v.st_nlink),str(v.st_size),stamp(v.st_mtime_ns),stamp(v.st_ctime_ns)))
+
+class ActualNodeExchange:
+    def __init__(self,scope,identity):
+        self.scope=scope;self.identity=identity;self.files=[];self.arm=None
+        self.raw=None;self.body=None;self.calls=0;self.windows=None
+    def file(self,name):
+        owner=OriginalDescriptor.__new__(OriginalDescriptor);self.files.append(owner)
+        owner.__init__(str(self.scope.path/name),os.O_RDWR|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW|os.O_CLOEXEC)
+        owner.require(owner.fd);os.fchmod(owner.fd,0o600);owner.require(owner.fd);return owner
+    def __call__(self,command,*,timeout):
+        started=time.monotonic();assert 0<timeout<=1.5
+        if self.raw is not None:
+            assert self.scope.bank.literal(self.scope.family.reader.last_reference)==self.raw
+            self.raw=None;self.body=None # Known previous bytes remain in original Raw, before next getter.
+        self.calls+=1
+        if self.arm is None:assert command['operation']=='arm';self.arm=command['commandId']
+        else:assert command['operation']=='observe'
+        value=self.scope.source_payload(command,int(self.identity.split(':')[0]))
+        self.body=canonical(value);assert 0<len(self.body)<=BODY_LIMIT
+        del value
+        if not self.files:self.file('feature-pico-avatar-people-state2.json');self.file('feature-pico-avatar-people-state2-receipt.json')
+        sample,receipt=self.files
+        sample.require(sample.fd);assert os.pwrite(sample.fd,self.body,0)==len(self.body)
+        os.ftruncate(sample.fd,len(self.body));os.fsync(sample.fd);sample.require(sample.fd)
+        root=self.scope.bank.directory;require_directory(root,self.scope.path)
+        r,s,q=(os.fstat(v.fd) for v in (root,sample,receipt))
+        original=canonical(dict(picoPeopleOriginalReceiptVersion=2,rootBirthVersion=1,rootBirthCommandId=self.arm,
+            rootBirthRunId=self.scope.run,rootBirthFamilyId=self.scope.declared_family,rootBirthNode=physical_stamp(description(r))[:5],
+            commandId=command['commandId'],wire=dict(leaf='feature-pico-avatar-people-state2.json',maximumFileBytes=262144,
+                rootNode=physical_stamp(description(r))[:5],sampleNode=physical_stamp(description(s))[:5],sampleStamp=physical_stamp(description(s)),
+                sha256=hashlib.sha256(self.body).hexdigest(),bytes=len(self.body)),receiptNode=physical_stamp(description(q))[:5],
+            nativeAdmissionJoined=False,wireProducerJoined=True,modelProducerJoined=True))
+        assert len(original)<=4096;receipt.require(receipt.fd)
+        assert os.pwrite(receipt.fd,original,0)==len(original);os.ftruncate(receipt.fd,len(original));os.fsync(receipt.fd);receipt.require(receipt.fd)
+        require_directory(root,self.scope.path)
+        before=tuple(os.fstat(v.fd) for v in (root,sample,receipt))
+        actual_receipt=os.pread(receipt.fd,4097,0);actual_body=os.pread(sample.fd,BODY_LIMIT+1,0)
+        after=tuple(os.fstat(v.fd) for v in (root,sample,receipt))
+        assert tuple(map(stat8,before))==tuple(map(stat8,after)) and actual_receipt==original and actual_body==self.body
+        for owner in (root,sample,receipt):owner.require(owner.fd)
+        r,s,q=map(description,before);nonce=command['commandId'].encode();identity=self.identity.encode()
