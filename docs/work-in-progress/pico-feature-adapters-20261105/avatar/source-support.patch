+    const open=text.indexOf('(',found.index),brace=text.indexOf('{',open);let depth=0,quote=null,line=false,block=false;
+    for(let i=brace;i<text.length;++i) {const c=text[i],n=text[i+1];
+        if(line) {if(c==='\n')line=false;continue;}if(block) {if(c==='*'&&n==='/'){block=false;++i;}continue;}
+        if(quote) {if(c==='\\'){++i;continue;}if(c===quote)quote=null;continue;}
+        if(c==='/'&&n==='/'){line=true;++i;continue;}if(c==='/'&&n==='*'){block=true;++i;continue;}
+        if(c==='"'||c==="'"||c==='`'){quote=c;continue;}
+        if(c==='{')++depth;if(c==='}'&&--depth===0)return 'function'+text.slice(open,i+1);
+    }throw Error('Unclosed actual function '+name);
