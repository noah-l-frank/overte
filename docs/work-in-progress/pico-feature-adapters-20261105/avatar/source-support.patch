+
+    def _initialize(self,exchange,guard,identity,root_node,clock,command):
+        need(all(callable(v) for v in (exchange,guard,clock))
+            and type(identity) is str and re.fullmatch('[1-9][0-9]*:[0-9]+',identity)
+            and type(root_node) is tuple and len(root_node)==5 and all(type(v) is str for v in root_node))
