+// Copyright 2026 Overte contributors.
+// SPDX-License-Identifier: Apache-2.0
+package org.overte.pico;
+/** Fixed Pico debug birth selection; no memory/root/account/row setter. */
+final class PeopleSource2Launch {
+    static final String EXTRA = "org.overte.e2e.PEOPLE_SOURCE2";
+    private static final String OPTION = "--picoPeopleSource2";
+    private PeopleSource2Launch() { }
+    static String arguments(String original, Object selected) {
+        if (selected == null || selected.getClass() != Boolean.class) {
+            throw new IllegalArgumentException("People Source2 selection must be a Boolean");
+        }
+        if (!((Boolean) selected)) { return original; }
+        if (original == null || original.isEmpty() || original.contains(OPTION)) {
+            throw new IllegalArgumentException("People Source2 requires the original fresh launch arguments");
+        }
+        return original + " " + OPTION;
+    }
+}
