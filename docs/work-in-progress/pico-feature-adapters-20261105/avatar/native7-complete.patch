+    if(!enabled()||!xhr||xhr->thread()!=QThread::currentThread()||url.size()>4096||api.size()>4096||method.size()>8) {_d->refuse();return;}
+    const quint8 methodId=method==QLatin1String("GET")?1:method==QLatin1String("POST")?2:method==QLatin1String("DELETE")?3:0;
+    if(!methodId) {_d->refuse();return;}
