+bool PicoPeopleSource::readCurrentAccount() {
+    Private::Work work(_d.get());if(!work) {return false;}
+    // Strong original was retained BEFORE any delegated constructor/callback.
+    // No Source/Registry/Manager lock spans this current field-only read.
