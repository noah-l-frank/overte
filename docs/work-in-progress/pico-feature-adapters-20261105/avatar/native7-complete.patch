+void PicoPeopleSource::bearerAttached(QObject* xhr,AccountManager* actual) {
+    Private::Work work(_d.get());if(!work) {return;}
+    // The held AccountManager cannot terminate/reuse while this Source lives.
+    // RequestScope's shared state is never replaced; snapshot only copies that
+    // control pointer and performs its existing atomic load. No QObject/URL or
+    // credential-string read is made across the AccountManager thread.
+    if(!enabled()||!xhr||!actual||actual!=_d->held.originalAccount.data()) {_d->refuse();return;}
+    bool pendingOriginal=false;
+    {QMutexLocker lock(&_d->mutex);for(const auto& row:_d->requests) {
+        if(row.original==xhr&&!row.done) {pendingOriginal=true;break;}
+    }}
+    if(!pendingOriginal) {return;} // Pointer search BEFORE any foreign QObject dereference.
+    if(xhr->thread()!=QThread::currentThread()) {_d->refuse();return;}
+    const auto ticket=actual->_credentialContext.snapshot();
+    QMutexLocker lock(&_d->mutex);
+    for(auto& row:_d->requests) {if(row.original==xhr&&!row.done) {
+        if(row.bearerObserved||!ticket.scoped()||!ticket.featureGeneration()) {_d->values.unknown=true;return;}
+        row.bearerTicket=ticket;row.bearerObserved=true;return;
+    }}
+    // Unobserved/unrelated XHRs do not acquire Source authority here.
