+    if(!originalFamily||originalFamilyNativeReservation!=Endpoint::FamilyCeiling
+            ||!fullSum||fullSum>originalFamilyNativeReservation||!originalWhole||!originalQueueSettled) {return false;}
+    // The exact same-family reservation must already exist in Host other_bill.
