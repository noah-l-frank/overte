+    // This real caller runs synchronously in selected Application startup.
+    // It owns no external queued producer. Endpoint's actual queue and Source
+    // work lanes are checked separately; this is NOT a global queue verdict.
+    constexpr std::size_t callerBytes=65536;
+    if(!Endpoint::nativeFamilyFloor(callerBytes)) {return false;}
+    try {
+        _featurePeople2PartialAccount=Source::originalStartupAccount(qApp);
+        if(!_featurePeople2PartialAccount) {return false;}
+        _featurePeople2PartialFamily=Source::createOriginalBirthFamily(qApp,this);
+        if(!_featurePeople2PartialFamily) {return false;}
+        const auto original=_featurePeople2PartialFamily;
+        const auto originalBirth=[original] {return Source::birthFamilyWithin(original);};
+        // Fixed native policy, not a Host/JS setter. Host whole120 and actual
+        // same-bank reservation remain separate mandatory Host obligations.
+        return bindPicoPeople2Family(original,Endpoint::FamilyCeiling,callerBytes,originalBirth,originalBirth);
+    } catch(...) {
+        if(!_featurePeople2SetupError) {_featurePeople2SetupError=std::current_exception();}
+        return false;
+    }
