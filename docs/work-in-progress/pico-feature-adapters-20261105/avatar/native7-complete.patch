+class SharedDeclaredPeople2:
+    def __init__(self,original):
+        need(type(original.bank) is AudioRawArchive and original.bank.path.parent==original.path
+            and original.bank.lock is original.lock and original.bank.identity.__self__ is original
+            and same_callable(original.bank.identity,original.identity)
+            and same_callable(original.bank.other_bill,original.bill)
+            and original.family is None and original.profile_work_booked is True)
+        self.original=original;self.bank=original.bank;self.path=original.path;self._family=None
+        self.pins=(original,original.bank,original.path,original.lock,original.identity,original.bill,original.producer_bill)
+        self.check()
+    def check(self):
+        original=self.original
+        need(type(self) is SharedDeclaredPeople2 and original is self.pins[0] and self.bank is self.pins[1]
+            and original.bank is self.bank and self.path is self.pins[2] and original.path is self.path
+            and original.lock is self.pins[3] and self.bank.lock is original.lock
+            and same_callable(original.identity,self.pins[4]) and same_callable(original.bill,self.pins[5])
+            and same_callable(original.producer_bill,self.pins[6]) and original.profile_work_booked is True
+            and original.family is self._family and original._family_owner is self._family)
+        original.identity();need(same_callable(self.bank.identity,original.identity)
+            and same_callable(self.bank.other_bill,original.bill))
