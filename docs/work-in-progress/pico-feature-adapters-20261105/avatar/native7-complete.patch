+// PRIVATE UNCOMPILED resource composition. No new write/readback algorithm.
+// No endpoint/serializer/admission/AuthURL/ReplyURL/model readiness is implied.
+class PicoPeopleOriginals : public std::enable_shared_from_this<PicoPeopleOriginals> {
+public:
+    using Request=PicoRemoteAvatarStreamRequest; // Existing clock only, NOT stream authority.
+    static constexpr qsizetype Wire=262144,Receipt=4096;
+    static constexpr const char* Leaf="feature-pico-avatar-people-state2.json";
+    static constexpr const char* ReceiptLeaf="feature-pico-avatar-people-state2-receipt.json";
+    struct Prebook {
+        std::shared_ptr<const void> originalFamilyHold;
+        std::size_t resourceBytes{0},callerBytes{0};
+    };
+    static std::size_t resourceFloor() {
+        // OLD expected + NEW wire + readback + partial-write prefix, plus
+        // both proof graphs, receipt graph/wire and marker/path metadata.
+        return sizeof(PicoPeopleOriginals)+2*sizeof(PicoEmoteCaptureFile)+4096
+            +4*Wire+4*12*Receipt+12*Receipt+4*Receipt+65536;
+    }
+    static std::size_t callerFloor() {
+        // ADDITIVE to resource, ledger resident, all eight196608 work lanes,
+        // cancelled queued functors, actual Host Raw/transport/pending work.
+        return PicoPeopleSource::snapshotBytes()+Wire+Receipt+65536;
+    }
+    static std::shared_ptr<PicoPeopleOriginals> create(const Prebook& booked,
+            const std::shared_ptr<PicoPeopleSource>& originalLedger,QObject* app,QObject* tsi,
+            const QString& root,const std::function<bool()>& originalWhole,const std::function<bool()>& originalQueueSettled) {
+        if(!booked.originalFamilyHold || booked.resourceBytes<resourceFloor() || booked.callerBytes<callerFloor()
+                || !originalLedger || !originalLedger->sameFamily(booked.originalFamilyHold) || !originalLedger->resourcesKnown() || PicoPeopleSource::active()!=originalLedger
+                || !PicoPeopleSource::bornContext(app,tsi) || !app || QThread::currentThread()!=app->thread()
+                || !originalWhole || !originalQueueSettled || root.size()>4096) {return {};}
+        // NO IO here. Caller and original ledger retain it BEFORE open.
+        auto value=std::shared_ptr<PicoPeopleOriginals>(new PicoPeopleOriginals(booked,originalLedger,app,tsi,root,
+            originalWhole,originalQueueSettled));
+        if(!originalLedger->holdOriginals(value)) {return {};}
+        return value;
+    }
+    bool open(const std::shared_ptr<const Request>& originalArm) {
