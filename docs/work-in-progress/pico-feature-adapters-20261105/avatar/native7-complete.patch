+    if(!response) {_d->values.unknown=true;}
+}
+bool PicoPeopleSource::resourcesKnown() const {
+    if(!enabled()) {return false;}
+    QMutexLocker lock(&_d->mutex);return !_d->values.unknown&&!_d->retiring;
+}
+bool PicoPeopleSource::sameFamily(const std::shared_ptr<const void>& original) const {
+    const auto& expected=_d->held.originalFamilyHold;
+    return original && original.get()==expected.get() && !original.owner_before(expected) && !expected.owner_before(original);
+}
+bool PicoPeopleSource::holdOriginals(const std::shared_ptr<PicoPeopleOriginals>& original) {
+    if(!enabled()||!original) {return false;}
+    QMutexLocker lock(&_d->mutex);
+    if(_d->values.unknown||_d->retiring||_d->originalsEver) {return false;}
+    _d->originalsEver=true;_d->originalFiles=original;_d->values.originalsBound=true;return true;
+}
+bool PicoPeopleSource::retireOriginals(PicoPeopleOriginals* original) {
+    QMutexLocker lock(&_d->mutex);
+    if(_d->values.unknown||!original||_d->originalFiles.get()!=original) {return false;}
+    _d->originalFiles.reset();_d->values.originalsBound=false;return true;
+}
+void PicoPeopleSource::caught(std::exception_ptr actual) noexcept {QMutexLocker lock(&_d->mutex);if(!_d->firstError) {_d->firstError=actual;}_d->values.unknown=true;}
+void PicoPeopleSource::destroyed(QObject* xhr) {
+    QMutexLocker lock(&_d->mutex);
+    for(auto& row:_d->requests) {if(row.original==xhr) {
+        if(!row.done) {_d->values.unknown=true;}
+        // Actual original destructor hook retires the address association.
+        // Old event sequence stays immutable; a new object at this address
+        // gets a new slot, never adopts an old request.
+        row.original=nullptr;return;
+    }}
+}
+bool PicoPeopleSource::snapshot(Snapshot* output,std::size_t bytes) {if(!enabled()||!output||bytes<sizeof(Snapshot)) {return false;}QMutexLocker lock(&_d->mutex);*output=_d->values;output->modelProducerJoined=output->model.seen&&output->model.alive
+    &&output->model.currentContextJoined&&!output->model.observerDetached;return true;}
+}
