+PicoPeopleSource::OriginStamp PicoPeopleSource::currentAuthOrigin(QObject* original,quint64 generation) const {
+    OriginStamp result;if(!ownsOriginalAccount(original)||!generation) {return result;}
+    // Rehash the actual bounded original producer bytes on EVERY capture.
+    // Existing wider UTF8 origin events remain separate; they cannot silently
+    // substitute a cached digest for this explicit ASCII current-origin join.
+    std::array<char,4096> raw{};std::size_t count=0;
+    {auto& r=registry();QMutexLocker lock(&r.mutex);
+        if(r.accountRetired||!r.productOriginObserved||original!=r.originalAccount.data()
+                ||r.productOriginGeneration!=generation||r.productOriginBytes>raw.size()) {return result;}
+        count=r.productOriginBytes;std::memcpy(raw.data(),r.productOrigin.data(),count);
+        result.generation=r.productOriginGeneration;result.epoch=r.productOriginEpoch;
+    }
+    if(!count||!ownsOriginalAccount(original)) {return OriginStamp{};}
+    result.sha256=digest(raw.data(),int(count));result.observed=true;return result;
