+    # explicitly at the representation boundary, before omitting its duplicate.
+    need(typed_equal(before['activations'], after['activations'][:len(before['activations'])]))
+
+
+def encode(before, after, table, *, run, epoch):
+    validate_pair(before, after, run=run, epoch=epoch)
+    check_table(table)
+    encoded_table = {canonical(value): index for index, value in enumerate(table)}
+    rows = after['activations']
+    binary = bytearray(ROW_BYTES * len(rows))
+    for index, row in enumerate(rows):
+        # PhaseFixture enforces exact integer sequence == index + 1, unique
+        # lower-hex 128-bit ticket, and exact int/float epoch in [1, 1e15].
+        activated = number(row['activatedEpochMs'], 1)
+        tag = 0 if type(activated) is int else 1
+        # Every admitted int fits uint64: 1e15 < 2**50 < 2**64. Every admitted
+        # float is stored as its actual IEEE754 bits, without integer coercion.
+        numeric = struct.pack('>Q', activated) if tag == 0 else struct.pack('>d', activated)
+        key = canonical(row['stimulus'])
