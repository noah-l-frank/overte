+        need(type(original_publisher) is NativePublisherModel)
+        self.original=original_publisher;self.model=model;self.failed=False;self.events=[]
+        # Reuse the existing actual create/file/directory/OFD verification
+        # methods. Borrow the SAME held root; source file holders are distinct.
+        self.files=object.__new__(NativePublisherModel);OWNED.append(self)
+        self.files.root=original_publisher.root;self.files.guard=original_publisher.guard
+        self.files.directory=original_publisher.directory;self.files.owners=[];self.files.files={}
+        self.files.failed=False;self.files.stopped=False;self.files.drained=False
