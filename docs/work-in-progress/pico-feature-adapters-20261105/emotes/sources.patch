+"""PRIVATE selected-code observation diagnostic; no source/input/clock callback.
+
+Does not alter or cache an ownership, freshness, source or budget verdict.
+No complete frame/DTO/traceback is retained by this monitor. Elapsed spans are
+instrumented costs, not unprofiled performance qualification.
+"""
+import inspect
+import sys
+import time
+
+
+class ObservationCosts:
+    def __init__(self):
+        # Construct only after the original frozen overlay has been selected.
+        from projected_sources import ProjectedSources
+        from source_projection_ledger import SourceProjectionLedger
+        from projection_semantics import ProjectionSemantics
+        from frame_projection2 import restore
+        from frame_memory_digest import digest
+        from adapters.pico4.audio_raw_archive import AudioRawArchive
+        from adapters.pico4.lifecycle_process_file import LifecycleProcessFile
+        from adapters.pico4.emote_effects import PicoEmoteEffects
+        from adapters.pico4.emote_common import PicoEmoteCommon
+        from projection_layout import ProjectionLayout
+        from projection_budget import ProjectionBudget
+        from scope_phase_codec import phases
+        from phase_pair_codec import decode,validate_pair
+        from frame_memory_cache import FrameMemoryCache
+        import compact_original_refs
+        functions=[restore,digest,ProjectionSemantics.require,
+            AudioRawArchive.literal,AudioRawArchive.guard,LifecycleProcessFile.guard,
+            PicoEmoteEffects.bound,PicoEmoteEffects.after,PicoEmoteEffects.recompute,
+            PicoEmoteEffects.measure,PicoEmoteCommon.observe]
+        functions.extend(getattr(ProjectedSources,name) for name in
+            ('configuration','borrowed_guard','stored','_stored_claim','read','verify_history'))
+        functions.extend(getattr(SourceProjectionLedger,name) for name in
+            ('identity','original','expansion_bill','check_compound'))
+        functions.extend((ProjectionLayout.identity,ProjectionLayout.credit,ProjectionBudget.bill,phases,decode,validate_pair,FrameMemoryCache.matches))
+        self.codes={fn.__code__:fn.__module__+'.'+fn.__qualname__ for fn in functions}
+        if len(self.codes)!=len(functions):raise RuntimeError('Selected original code collision')
+        self.costs={name:[0,0.,0.,0] for name in self.codes.values()}
+        self.measure=PicoEmoteEffects.measure.__code__
+        lines,first=inspect.getsourcelines(PicoEmoteEffects.measure)
+        selected=[first+i for i,line in enumerate(lines) if line.strip().startswith('fresh(floor,delivered);')]
+        if len(selected)!=1:raise RuntimeError('Original effect freshness site changed')
+        self.freshness_line=selected[0]
+        self.stack=[];self.events=0;self.limit=150000;self.tool=None
+        self.freshness=[];self.overflow=False
+
+    def started(self,code,_offset):
+        self.events+=1
+        if self.events>self.limit:
+            self.overflow=True
+            raise RuntimeError('Selected diagnostic bound exhausted; original execution refused')
+        self.stack.append([code,time.perf_counter(),0.])
+
+    def completed(self,code,_offset,_result):
+        self.finish(code,False)
+
+    def unwound(self,code,_offset,_exception):
+        # Do not retain exception/traceback/local owners in diagnostic state.
+        if code in self.codes:self.finish(code,True)
+
+    def finish(self,code,unwound):
+        ended=time.perf_counter();self.events+=1
+        if not self.stack or self.stack[-1][0] is not code:
+            raise RuntimeError('Selected diagnostic stack changed')
+        _original,started,children=self.stack.pop()
+        elapsed=ended-started;row=self.costs[self.codes[code]]
+        row[0]+=1;row[1]+=elapsed;row[2]+=elapsed-children;row[3]+=int(unwound)
+        if self.stack:self.stack[-1][2]+=elapsed
+
+    def line(self,code,line):
+        if line!=self.freshness_line:return sys.monitoring.DISABLE
+        frame=sys._getframe(1)
+        if frame.f_code is not self.measure:raise RuntimeError('Original freshness frame changed')
+        value=frame.f_locals
+        # These scalars were ALREADY computed by actual original method calls.
+        # No source, SDK, phase, host/native clock or guard is invoked here.
+        keys=('started','end','floor','provider','epoch','host','delivered','delivered_host')
+        if any(type(value[key]) not in (int,float) for key in keys):
+            raise RuntimeError('Original freshness scalar types changed')
+        self.freshness.append({key:value[key] for key in keys})
+        if len(self.freshness)>2:raise RuntimeError('Diagnostic observation count exceeded')
+
+    def __enter__(self):
+        monitor=sys.monitoring
+        self.tool=next((i for i in range(5,-1,-1) if monitor.get_tool(i) is None),None)
+        if self.tool is None:raise RuntimeError('No unowned monitoring slot')
+        monitor.use_tool_id(self.tool,'private-work9-effect-selected-cost')
+        try:
+            callbacks=((monitor.events.PY_START,self.started),(monitor.events.PY_RETURN,self.completed),
+                (monitor.events.PY_UNWIND,self.unwound),(monitor.events.LINE,self.line))
+            for event,callback in callbacks:monitor.register_callback(self.tool,event,callback)
+            events=monitor.events.PY_START|monitor.events.PY_RETURN
+            for code in self.codes:monitor.set_local_events(self.tool,code,events)
+            monitor.set_local_events(self.tool,self.measure,events|monitor.events.LINE)
+            # CPython forbids local PY_UNWIND. Only this one exceptional event
+            # is global, with an exact original-code filter and no CALL hook.
+            monitor.set_events(self.tool,monitor.events.PY_UNWIND)
+        except BaseException:
+            self.__exit__(None,None,None);raise
+        return self
+
+    def __exit__(self,*_failure):
+        if self.tool is not None:
+            monitor=sys.monitoring
+            monitor.set_events(self.tool,0)
+            for code in self.codes:monitor.set_local_events(self.tool,code,0)
+            for event in (monitor.events.PY_START,monitor.events.PY_RETURN,monitor.events.PY_UNWIND,monitor.events.LINE):
+                monitor.register_callback(self.tool,event,None)
+            monitor.free_tool_id(self.tool);self.tool=None
+
+    def report(self):
+        return dict(scope='PRIVATE Work9 actual Crying Common.observe selected-code costs only; explicit diagnostic overhead, no unprofiled claim',
+            events=self.events,overflow=self.overflow,freshness=self.freshness,
+            openSelectedFrames=[self.codes[row[0]] for row in self.stack],
+            costs={name:dict(calls=row[0],inclusiveMs=row[1]*1000,exclusiveMs=row[2]*1000,unwound=row[3])
+                for name,row in self.costs.items()})
