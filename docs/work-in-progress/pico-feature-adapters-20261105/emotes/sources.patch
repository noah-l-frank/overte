+"""PRIVATE pure strictrefs boundary tests, no Source/FD/SDK authority."""
+import unittest
+import compact_json
+import compact_original_refs as original
+
+
+class OriginalReferencesTests(unittest.TestCase):
+    def seal(self,value):
+        result=compact_json.capture(value,max_depth=16)
+        self.assertIsNotNone(result)
+        return result[0]
+    def test_unchanged_graph_and_typed_mutation(self):
+        value={'fields':[False,1,0.0,None,'source-token']};seal=self.seal(value)
+        self.assertTrue(original.matches(value,seal))
+        value['fields'][0]=0
+        self.assertFalse(original.matches(value,seal))
+    def test_equal_new_scalar_has_no_original_payload_identity(self):
+        old='actual-existing-payload-owner'*4;value={'value':old};seal=self.seal(value)
+        new=(old+'!')[:-1];self.assertEqual(new,old);self.assertIsNot(new,old)
+        value['value']=new
+        self.assertTrue(compact_json.matches(value,seal))
+        self.assertFalse(original.matches(value,seal))
+    def test_equal_new_key_preserves_order_but_refuses(self):
+        old='actual-existing-key-owner'*3;value={old:7,'tail':None};seal=self.seal(value)
+        new=(old+'!')[:-1];self.assertEqual(new,old);self.assertIsNot(new,old)
+        rows=list(value.items());value.clear();value.update((new if key is old else key,child) for key,child in rows)
+        self.assertTrue(compact_json.matches(value,seal))
+        self.assertFalse(original.matches(value,seal))
+    def test_original_key_order_is_source_cache_only_requirement(self):
+        value={'first':'same-object','second':9};seal=self.seal(value)
+        rows=list(value.items());value.clear();value.update(reversed(rows))
+        self.assertTrue(compact_json.matches(value,seal))
+        self.assertFalse(original.matches(value,seal))
+
+if __name__=='__main__':unittest.main()
