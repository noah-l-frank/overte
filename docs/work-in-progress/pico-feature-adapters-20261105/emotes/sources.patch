+"""PRIVATE first-parse witness; no new decoder or smaller admitted grammar.
+
+Selection must happen at original wire construction. This subclass only records
+successful original parse identity before the inherited post-parse callbacks.
+The permanently charged initial4W role slot is never released or discounted.
+"""
+import hashlib
+from dataclasses import dataclass
+from adapters.native_feature_observation import need
+from adapters.pico4.emote_source_transaction_physical import PicoEmoteSourcePhysicalWire
+from adapters.script_journey.history import canonical
+from replay_codec_identity import ReplayCodecIdentity
+
+OWNED=[]
+
+@dataclass(frozen=True,slots=True)
+class ReplayWitness:
+    owner:object
+    reference:bytes
+    literal_sha256:str
+    literal_bytes:int
+    codec:object
+    def require(self,reference,literal):
+        need(type(self.owner) is ValidatedReplayWire and self.owner in OWNED
+            and self.owner.codec is self.codec and self.owner.codec is self.owner._codec
+            and any(self is witness for witness in self.owner.witnesses)
+            and type(reference) is dict and canonical(reference)==self.reference
+            and type(literal) is bytes and len(literal)==self.literal_bytes
+            and hashlib.sha256(literal).hexdigest()==self.literal_sha256)
+        self.codec.require()
+        return True
+
+class ValidatedReplayWire(PicoEmoteSourcePhysicalWire):
+    def __init__(self,*args,**kwargs):
+        self.codec=self._codec=ReplayCodecIdentity()
+        self.witnesses=self._witnesses=()
+        OWNED.append(self) # Before the original constructors and callbacks.
+        super().__init__(*args,**kwargs)
+    def identity(self):
+        need(self.codec is self._codec and type(self.codec) is ReplayCodecIdentity
+            and self.witnesses is self._witnesses)
+        self.codec.require()
+        return super().identity()
+    def parse_reply(self,literal,command):
+        # No guard/clock/user callback occurs between original success and the
+        # witness. Original parse exceptions produce no successful witness.
+        self.codec.require()
+        proof,values=super().parse_reply(literal,command)
+        self.codec.require()
+        need(type(self.reference) is dict and self.reference['sha256']==hashlib.sha256(literal).hexdigest())
+        witness=ReplayWitness(self,canonical(self.reference),hashlib.sha256(literal).hexdigest(),len(literal),self.codec)
+        self.witnesses=self._witnesses=(*self._witnesses,witness)
+        return proof,values
+    def replay_witness(self,reference):
+        self.identity();raw=canonical(reference)
+        witnesses=[value for value in self._witnesses if value.reference==raw]
+        need(len(witnesses)==1)
+        return witnesses[0]
