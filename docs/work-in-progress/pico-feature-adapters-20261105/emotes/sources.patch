+            {"boomLength",avatar->getBoomLength()},{"zoomMin",MyAvatar::ZOOM_MIN},{"zoomDefault",MyAvatar::ZOOM_DEFAULT}}},
+        {"avatarResourcesVersion",1},{"avatarResources",QVariantMap{
