+    for name in ('beforeHeader', 'afterHeader'):
+        exact(value[name], HEADER_FIELDS, 'stored original phase header')
+    before = deepcopy(value['beforeHeader'])
+    before['activations'] = deepcopy(rows[:value['beforeCount']])
+    after = deepcopy(value['afterHeader'])
+    after['activations'] = rows
+    validate_pair(before, after, run=run, epoch=epoch)
+    need(type(value['beforeSha256']) is str and value['beforeSha256'] == digest(before)
+        and type(value['afterSha256']) is str and value['afterSha256'] == digest(after))
+    return before, after
