+            {"sessionId",original->getSessionUUID().isNull()?QVariant():QVariant(original->getSessionUUID().toString(QUuid::WithoutBraces))},
+            {"connected",domain.isConnected()},{"domainSession",domain.featureChatSession(run)}};
