+            # It keeps exact bool/int/float/-0 representation separate. The
+            # existing accepted JSON/Source scalar grammar stays unchanged.
+            body=marshal.dumps(node,2);result.update(b'p');result.update(struct.pack('>Q',len(body)));result.update(body)
