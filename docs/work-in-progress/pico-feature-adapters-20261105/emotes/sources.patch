+        self.stack=[];self.events=[];self.hashDuringDecoder=0;self.hashAfterFreshDecode=0
+        self.calls=0
+    def started(self,code,_offset):
+        self.calls+=1
+        if self.calls>10000:raise RuntimeError('Lifetime diagnostic bound exceeded')
+        if code is self.hash:
+            if any(item[0] is self.decode for item in self.stack):self.hashDuringDecoder+=1
+            if any(item[0] is self.claim and item[1] for item in self.stack):self.hashAfterFreshDecode+=1
+        self.stack.append([code,False])
+        if code is self.decode:
+            ledger=self.source.ledger;lease=ledger.replay_lease
+            if lease is not None:
