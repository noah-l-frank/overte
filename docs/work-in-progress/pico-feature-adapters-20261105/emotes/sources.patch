+        monitor=sys.monitoring;self.tool=next((i for i in range(5,-1,-1) if monitor.get_tool(i) is None),None)
+        if self.tool is None:raise RuntimeError('No unowned lifetime diagnostic slot')
+        monitor.use_tool_id(self.tool,'private-replay-hash-lifetime')
+        try:
+            for event,callback in ((monitor.events.PY_START,self.started),(monitor.events.PY_RETURN,self.returned),
+                    (monitor.events.PY_UNWIND,self.unwound)):
+                monitor.register_callback(self.tool,event,callback)
+            for code in self.codes:monitor.set_local_events(self.tool,code,monitor.events.PY_START|monitor.events.PY_RETURN)
+            monitor.set_events(self.tool,monitor.events.PY_UNWIND)
