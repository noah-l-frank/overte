+        and no RSS claim is made. Previous complete payloads stay separately
+        charged by the ledger and original archive.
+        """
+        need(self.frames is self._frames and type(self._frame_seal) is tuple and type(self._raw_seals) is tuple
+            and len(self._frame_seal)==len(self._raw_seals)==len(self.frames)<=512)
+        size=4096 # Fixed typed owner/context linkage, separate from role slot.
+        size+=sum(canonical_size(list(row)) for row in self._frame_seal)
+        size+=sum(canonical_size(list(row)) for row in self._frame_guard_seal)
+        size+=sum(canonical_size(list(row)) for row in self._raw_seals)
+        if self.transaction is not None:
+            need(type(self.transaction) is ValidatedReplayWire and self.transaction.witnesses is self.transaction._witnesses)
+            for witness in self.transaction.witnesses:
+                need(witness.owner is self.transaction and type(witness.reference) is bytes
