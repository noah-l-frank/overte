+
+def phase(sequence, count, table, *, active=True, floating=False):
+    clock = float(10**15) if floating else 10**15
+    return dict(fixturePhaseVersion=1, instance='a'*32, sequence=sequence,
+        requestId=f'{sequence:032x}', runId=RUN, area='emotes',
+        capturedEpochMs=clock, active=active, createdEpochMs=1,
+        retiredEpochMs=None if active else clock,
+        activations=[dict(sequence=index+1, ticket=f'{index+1:032x}',
+            activatedEpochMs=1.0 if index % 2 else 1,
+            stimulus=deepcopy(table[index % len(table)])) for index in range(count)])
+
+
+class PhasePairCodecCases(unittest.TestCase):
+    def setUp(self):
+        self.table = codec.original_table(RUN)
+
+    def roundtrip(self, before, after):
+        value = codec.encode(before, after, self.table, run=RUN, epoch=10**15)
+        # This roundtrip includes an actual JSON container parse, not Python
+        # object identity carried from the producer to the decoder.
+        import json
+        stored = canonical(value)
+        left, right = codec.decode(json.loads(stored), run=RUN, epoch=10**15)
+        self.assertTrue(typed_equal(left, before))
+        self.assertTrue(typed_equal(right, after))
+        self.assertEqual(canonical(left), canonical(before))
+        self.assertEqual(canonical(right), canonical(after))
+        return value
+
+    def test_empty_and_full_histories_keep_original_types(self):
+        for before_count, after_count in ((0, 0), (0, 256), (1, 256), (256, 256)):
+            for active in (True, False):
+                before = phase(1, before_count, self.table, active=active)
+                after = phase(2, after_count, self.table, active=active, floating=True)
+                if not active:
+                    # The V1 retired predecessor forbids subsequent history.
+                    after['activations'] = deepcopy(before['activations'])
+                self.roundtrip(before, after)
+
+    def test_all_stimuli_and_float_bits_survive(self):
+        before = phase(1, 0, self.table)
+        after = phase(2, 256, self.table)
+        for index, row in enumerate(after['activations']):
+            row['activatedEpochMs'] = (1, 1.0, 1.0000000000000002, 999999999999999.9, 10**15)[min(index, 4)]
+        value = self.roundtrip(before, after)
+        self.assertEqual(len(base64.b64decode(value['history'])), 26*256)
+
+    def test_headers_preserve_v1_equal_numeric_distinct_types(self):
+        before = phase(1, 1, self.table)
+        after = phase(2, 1, self.table, floating=True)
+        after['createdEpochMs'] = 1.0
+        self.roundtrip(before, after)
+
+    def test_history_table_is_read_from_stored_original(self):
+        # A valid stored table may number the same closed stimuli differently
+        # from today's complete producer inventory. Regenerating that inventory
+        # would silently change these rows and fail the original phase hashes.
+        stored_table = self.table[-2:]
+        self.assertNotEqual(canonical(stored_table[0]), canonical(self.table[0]))
+        before, after = phase(1, 1, stored_table), phase(2, 2, stored_table)
+        value = codec.encode(before, after, stored_table, run=RUN, epoch=10**15)
+        import json
+        left, right = codec.decode(json.loads(canonical(value)), run=RUN, epoch=10**15)
+        self.assertEqual(canonical(left), canonical(before))
+        self.assertEqual(canonical(right), canonical(after))
+
+    def test_changed_typed_prefix_is_rejected_before_encoding(self):
+        before, after = phase(1, 1, self.table), phase(2, 2, self.table)
+        after['activations'][0]['activatedEpochMs'] = 1.0  # Equal number, different original type.
+        with self.assertRaises((ValueError, NativeUIError)):
+            codec.encode(before, after, self.table, run=RUN, epoch=10**15)
+
+    def test_duplicate_tickets_and_nonsequential_rows_stay_refused(self):
+        for mutation in ('ticket', 'sequence'):
+            before, after = phase(1, 0, self.table), phase(2, 2, self.table)
+            after['activations'][1][mutation] = after['activations'][0][mutation]
+            with self.assertRaises((ValueError, NativeUIError)):
+                codec.encode(before, after, self.table, run=RUN, epoch=10**15)
+
+    def test_original_hashes_detect_header_and_table_mutations(self):
+        before, after = phase(1, 0, self.table), phase(2, 1, self.table)
+        original = codec.encode(before, after, self.table, run=RUN, epoch=10**15)
+        for mutation in ('header', 'table', 'hash'):
+            value = deepcopy(original)
+            if mutation == 'header':
+                value['afterHeader']['sequence'] += 1
+            elif mutation == 'table':
+                # Preserve valid closed inventory and sorting; change actual
+                # history's referenced stimulus index instead of inventing a fact.
+                binary = bytearray(base64.b64decode(value['history']))
+                binary[25] = (binary[25]+1) % len(self.table)
+                value['history'] = base64.b64encode(binary).decode('ascii')
+            else:
+                value['beforeSha256'] = '0'*64
+            with self.assertRaises((ValueError, NativeUIError)):
+                codec.decode(value, run=RUN, epoch=10**15)
+
+    def test_invalid_numbers_tags_counts_and_wire_are_refused(self):
+        original = codec.encode(phase(1, 0, self.table), phase(2, 1, self.table),
+            self.table, run=RUN, epoch=10**15)
+        for mutation in ('boolean-count', 'large-count', 'tag', 'uint64-overflow-contract', 'infinity', 'partial', 'base64'):
+            value = deepcopy(original)
+            binary = bytearray(base64.b64decode(value['history']))
+            if mutation == 'boolean-count': value['beforeCount'] = False
+            elif mutation == 'large-count': value['beforeCount'] = 257
+            elif mutation == 'tag': binary[16] = 2
+            elif mutation == 'uint64-overflow-contract': binary[17:25] = struct.pack('>Q', 10**15+1)
+            elif mutation == 'infinity': binary[16:25] = bytes((1,))+struct.pack('>d', float('inf'))
+            elif mutation == 'partial': binary.pop()
+            else: value['history'] += '='
+            if mutation not in ('boolean-count', 'large-count', 'base64'):
+                value['history'] = base64.b64encode(binary).decode('ascii')
+            with self.assertRaises((ValueError, NativeUIError)):
+                codec.decode(value, run=RUN, epoch=10**15)
+
+
+if __name__ == '__main__':
+    unittest.main()
