+                    leaseActive=not lease.released,slotBytes=json.loads(lease._descriptor)['bytes'],freshReturnId=None))
+    def returned(self,code,_offset,value):
+        self.finished(code,value,False)
+    def unwound(self,code,_offset,_exception):
+        if code in self.codes:self.finished(code,None,True)
+    def finished(self,code,value,unwound):
+        if not self.stack or self.stack[-1][0] is not code:raise RuntimeError('Lifetime stack changed')
+        self.stack.pop()
