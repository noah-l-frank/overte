+        row=dict(guard=guard,passive=passive,coordinator=coordinator,actualActive=active,
+            logicalFrameBytes=logical,originalCallWorkBytes=call[1],sameOriginalWorkToken=work is call[0])
+        if work is call[0]:
+            # That SAME immutable token was measured before any getter.
+            row['expectedActive']=max(guard,passive,call[1])+coordinator
+            if self.shared is None:self.shared=row
+        elif work is None:
