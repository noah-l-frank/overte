+import base64
+from copy import deepcopy
+import hashlib
+import struct
+
+from adapters.native_feature_observation import need
+from adapters.pico4.lifecycle_namespace_bill import canonical_size
+from adapters.script_journey.history import canonical
+from feature_journeys.contract import exact, number, typed_equal
+from feature_journeys.phase_fixture import validate as validate_phase
+from feature_journeys.scenarios import actions, expand
+from feature_journeys.fixtures import context
+
+VERSION = 1
+MAX_ROWS = 256
+ROW_BYTES = 26
+HEADER_FIELDS = {'fixturePhaseVersion', 'instance', 'sequence', 'requestId',
+    'runId', 'area', 'capturedEpochMs', 'active', 'createdEpochMs', 'retiredEpochMs'}
+FIELDS = {'picoEmotePhasePairVersion', 'beforeHeader', 'afterHeader',
+    'beforeCount', 'stimulusTable', 'historyEncoding', 'history',
+    'beforeSha256', 'afterSha256'}
+
+
+def digest(value):
+    return hashlib.sha256(canonical(value)).hexdigest()
+
+
+def original_table(run):
+    """Called cold by the producer, never by the historical decoder."""
+    inputs_context = context(run)
+    candidates = [dict(verb=verb, inputs=expand(inputs, inputs_context))
+        for verb, rows in actions('emotes').items() for inputs in rows]
+    candidates.extend(dict(verb=verb, inputs={}) for verb in ('baseline', 'cleanup'))
+    distinct = {}
+    for row in candidates:
+        key = canonical(row)
+        if key not in distinct:
+            distinct[key] = deepcopy(row)
+    result = [distinct[key] for key in sorted(distinct)]
+    check_table(result)
+    return result
+
+
+def check_table(table):
+    need(type(table) is list and 0 < len(table) <= 256)
+    canonical_size(table, limit=196608)  # Exact plain finite JSON types.
+    last = None
+    for stimulus in table:
+        exact(stimulus, {'verb', 'inputs'}, 'stored phase stimulus')
+        need(type(stimulus['verb']) is str and type(stimulus['inputs']) is dict)
+        current = canonical(stimulus)
+        need(last is None or last < current)
+        last = current
+    return table
+
+
+def header(value):
+    return {key: deepcopy(item) for key, item in value.items() if key != 'activations'}
+
+
+def validate_pair(before, after, *, run, epoch):
+    # Existing finite/plain JSON admission also rules out converting subclasses.
+    # No new limit is imposed on SourceFrame or any of its six native DTOs.
+    canonical_size(before, limit=196608)
+    canonical_size(after, limit=196608)
