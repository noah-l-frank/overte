+            for item in reversed(self.stack):
+                if item[0] is self.claim:item[1]=True;break
+            ledger=self.source.ledger;lease=ledger.replay_lease
+            if lease is not None:
+                self.events.append(dict(event='return',typedLease=type(lease) is PassiveReplayLease,
+                    leaseActive=not lease.released,slotBytes=json.loads(lease._descriptor)['bytes'],freshReturnId=id(value)))
