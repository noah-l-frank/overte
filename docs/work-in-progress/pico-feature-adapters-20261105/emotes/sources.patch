+            owner=self.files.create(name)
+            self.files.files[name]=dict(owner=owner,bytes=b'',physical=signature(os.fstat(owner.fd)),limit=limit)
+        self.files.require()
+
+    @staticmethod
+    def node(info):return [str(v) for v in (info.st_dev,info.st_ino,info.st_mode,info.st_uid,info.st_nlink)]
+
+    def publish(self,name,nonce,raw):
