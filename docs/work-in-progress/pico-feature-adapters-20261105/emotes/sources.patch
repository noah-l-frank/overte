+"""PRIVATE Projection2 afterimage; not selected by a live Source factory.
+
+Old Projection1 and its 3*64KiB historical reader are untouched. This module
+only specifies/tests the new metadata representation and its complete byte
+bound. It is neither a capacity admission nor a source observation.
+"""
+from copy import deepcopy
+import hashlib
+
+from adapters.native_feature_observation import exact, need
+from adapters.pico4.lifecycle_namespace_bill import canonical_size
+from adapters.script_journey.history import canonical
+import phase_pair_codec as pair
+
+VERSION = 2
+W = 1048576
+COMMAND_LIMIT = 1024
+RAW_REFERENCE_LIMIT = 512
+FRAME = {'group', 'inventory', 'widgets', 'phaseBefore', 'phaseAfter', 'epochMs', 'hostEpochMs'}
+FIELDS = {'picoEmoteFrameProjectionVersion', 'contextSha256', 'transactionOriginal',
+    'phasePair', 'epochMs', 'hostEpochMs', 'canonicalFrameBytes'}
+
+
+def header_policy():
+    """Serialization-size overestimate only, never an accepted phase packet.
+
+    V1 integer sequence <=2**53-1 needs at most16 digits. V1 bounded epoch
+    ints <=1e15 need16. An admitted positive finite binary64 has at most17
+    significant digits in Python's shortest-roundtrip JSON representation;
+    decimal point, scientific exponent and exponent sign still fit32. Quoted
+    32-character strings here overestimate that numeric serialization as well
+    as null. False is one byte longer than true. All three IDs are fixed32hex.
+    """
+    return dict(fixturePhaseVersion=1, instance='f'*32, sequence='9'*16,
+        requestId='f'*32, runId='f'*32, area='emotes', capturedEpochMs='9'*32,
+        active=False, createdEpochMs='9'*32, retiredEpochMs='9'*32)
+
+
+def policy_row(table):
+    """Closed-size policy graph. It is deliberately NOT a source fact."""
+    pair.check_table(table)
+    maximum_history_bytes = 4*((pair.ROW_BYTES*pair.MAX_ROWS+2)//3)
+    phase_policy = dict(picoEmotePhasePairVersion=pair.VERSION,
+        beforeHeader=header_policy(), afterHeader=header_policy(), beforeCount=256,
+        stimulusTable=deepcopy(table), historyEncoding='ticket16-number9-stimulus1-base64',
+        history='A'*maximum_history_bytes, beforeSha256='f'*64, afterSha256='f'*64)
+    return dict(picoEmoteFrameProjectionVersion=VERSION, contextSha256='f'*64,
+        transactionOriginal=dict(picoEmoteTransactionOriginalVersion=1,
+            command=None, rawReference=None, contextSha256='f'*64),
+        phasePair=phase_policy, epochMs='9'*32, hostEpochMs='9'*32, canonicalFrameBytes=W)
+
+
+def maximum_metadata_bytes(table):
+    # Replace each four-byte null with the OLD independently enforced bound.
+    # No URL/native DTO/path enters this wrapper: they stay in the raw literal.
+    return len(canonical(policy_row(table)))-2*len(b'null')+COMMAND_LIMIT+RAW_REFERENCE_LIMIT
+
+
+def project(frame, context, transaction_original, table):
+    exact(frame, FRAME)
+    size = canonical_size(frame, limit=W)
+    need(type(context) is dict)
+    row = dict(picoEmoteFrameProjectionVersion=VERSION,
+        contextSha256=hashlib.sha256(canonical(context)).hexdigest(),
+        transactionOriginal=deepcopy(transaction_original),
+        phasePair=pair.encode(frame['phaseBefore'], frame['phaseAfter'], table,
+            run=context['runId'], epoch=frame['hostEpochMs']),
+        epochMs=frame['epochMs'], hostEpochMs=frame['hostEpochMs'], canonicalFrameBytes=size)
+    need(canonical_size(row, limit=196608) <= maximum_metadata_bytes(table))
+    return row
+
+
+def phases(row, context):
+    """Only historical metadata decode; actual SDK/raw validation is separate."""
+    exact(row, FIELDS)
+    need(type(row['picoEmoteFrameProjectionVersion']) is int and row['picoEmoteFrameProjectionVersion'] == VERSION
+        and row['contextSha256'] == hashlib.sha256(canonical(context)).hexdigest())
+    need(canonical_size(row, limit=196608) <= maximum_metadata_bytes(row['phasePair']['stimulusTable']))
+    return pair.decode(row['phasePair'], run=context['runId'], epoch=row['hostEpochMs'])
