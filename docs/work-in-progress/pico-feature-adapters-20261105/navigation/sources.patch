+        path=Path(verifier.resolve_tool(getattr(args,name),name)).resolve(strict=True)
+        values={str(path)};sdk=path.parent.parent
+        classpath=path.name=='apkanalyzer' and (sdk/'lib/apkanalyzer-classpath.jar').is_file()
+        java=None
