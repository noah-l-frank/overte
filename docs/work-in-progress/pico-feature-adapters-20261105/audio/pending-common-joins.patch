+    def original_frame(self,reference):
+        """Historical source reconstruction uses only its ORIGINAL envelope epoch."""
+        proof=json_document(self.actor.raws.literal(reference))
+        need(type(proof) is dict and set(proof)=={'audioCommonFrameVersion','frame','ticket','activation','command','bundle','epoch'}
+            and type(proof['audioCommonFrameVersion']) is int and proof['audioCommonFrameVersion']==1)
+        frame=result('feature.audio.observe',proof['frame'])
+        source=validate(self.actor.raws.literal(proof['bundle']),proof['command'],
+            self.actor.native.pid,self.actor.pages.bridge,proof['epoch'])
+        captured=min(source['native']['requestedEpochMs'],source['native']['capturedEpochMs'],
+            source['settings']['capturedEpochMs'],source['pages']['picoAudioPages']['capturedEpochMs'],
+            *(source['settings']['source'][key] for key in CLOCKS))
+        resources=[]
+        if source['actual']['open']:resources.append('panel:audio')
+        if source['actual']['recording'] or source['actual']['preview']:resources.append('input:recorded-preview')
+        need(frame['runId']==self.source.run and proof['command']['runId']==self.source.run
+            and frame['capturedEpochMs']==captured and frame['artifacts']==[]
+            and json_digest(frame['state'])==json_digest(source['actual'])
+            and json_digest(frame['lifecycle'])==json_digest(source['native']['lifecycle'])
+            and frame['resources']==resources and proof['ticket']==proof['activation']['ticket'])
+        return proof
+
+    def verify_consumed_prefix(self,samples):
+        try:
+            need(type(samples) is list and samples and len(samples)<=512)
+            with self.actor.raw_lock.held():
+                self.actor.raw_identity();self.physical.guard()
+                need(not self.failed and self.store.read()==self.state and json_digest(self.scope)==self.scope_sha
+                    and len(self.state['value']['frames'])==len(samples))
+                self.actor.history.verify()
+                need(json_digest(self.actor.frames)==self.actor.frames_sha)
+                observations=[frame for frame in self.actor.frames if frame['kind']=='observation']
+                journals=[frame['journal'] for frame in self.actor.frames if frame['kind']=='publication-return']
+                for sample,reference in zip(samples,self.state['value']['frames']):
+                    proof=self.original_frame(reference);frame=proof['frame']
+                    need(sample['ticket']==proof['ticket']
+                        and all(json_digest(sample[key])==json_digest(frame[key])
+                            for key in ('sequence','capturedEpochMs','state','resources','lifecycle')))
+                    witness=sample['witness']
+                    if witness is None:
+                        need(proof['activation']['stimulus']['verb'] in ('baseline','open','close'));continue
+                    need(type(witness) is dict and integer(witness['actorSequence'],1,len(observations)))
+                    actor_frame=observations[witness['actorSequence']-1]
+                    from feature_journeys.witness import projection
+                    need(actor_frame['native']['requestId']!=proof['command']['nativeNonce']
+                        and witness['ticket']==proof['ticket']==actor_frame['after']['activations'][-1]['ticket']
+                        and witness['capturedEpochMs']==actor_frame['capturedEpochMs']
+                        and json_digest(witness['facts'])==json_digest(projection('audio',actor_frame['actual']))
+                        and any(any(json_digest(entry)==json_digest(witness) for entry in journal['entries']) for journal in journals))
+                self.physical.guard();return True
+        except BaseException as error:self.poison(error);raise
+
     def close_host(self):
         return self.physical is None or self.physical.close_host()
