+            self.parent_guard()
+            owner=self.active=object.__new__(OriginalDescriptor)
+            OriginalDescriptor.__init__(owner,self.path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK|os.O_CLOEXEC)
+            info=os.fstat(owner.fd)
