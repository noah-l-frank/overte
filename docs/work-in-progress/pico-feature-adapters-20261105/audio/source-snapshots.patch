+        else:raise ValueError('Only original new-process readonly sources selected in this component')
+    def read_debug_app_file(self,target,package,path,attempts):
+        if self.new_native is None:return super().read_debug_app_file(target,package,path,attempts)
+        self.require(target)
+        if package!='org.overte.pico' or attempts!=1:raise ValueError('Changed original source ABI')
