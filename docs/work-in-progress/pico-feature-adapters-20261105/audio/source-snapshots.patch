+"""Verbatim existing declared G1 SDK primitives; no Native/device execution."""
+from copy import deepcopy
+import json,sys,time
+from adapters.normal_ui import NativeUIError
+from canonical_audio_recipe_fixture import configuration,canonical_binding,TARGET
+from self_tests.test_pico_chat_restart_io import RestartBoundary
+
+
+class CanonicalRestartAdapter(RestartBoundary):
+    def __init__(self,audio,root):
+        # One EXISTING original controller cursor; no second input session,
+        # restart, input, fake manager or overwritten warm journal is created.
+        self.pico_configuration=configuration(root);self.cold_binding=canonical_binding(root)
+        self.profile=dict(package='org.overte.pico',e2e_activity='org.overte.pico/.E2eLauncherActivity')
+        self.adb=self;self.target=TARGET;self.identity=self.cold_binding['processIdentity']
+        self.running=True;self.effect=True;self.lost=None;self.trace=[]
+        self.session=audio.session;self.digest=self.cold_binding['artifactSha256']
+        self.command=[sys.executable,'-c',"print('PID\\n123')"]
+
+    def binding(self):return deepcopy(self.cold_binding)
+
+    def _installation(self,target):
+        self.require(target)
+        return dict(schemaVersion=1,installedCandidateVerified=True,
+            sourceRevision=self.cold_binding['sourceRevision'],artifactSha256=self.digest)
+
+class OriginalSourceAdapter(CanonicalRestartAdapter):
+    def __init__(self,audio,root,*,native_delay=0):
+        super().__init__(audio,root)
+        self.audio=audio;self.native_delay=native_delay;self.source_commands=[]
+        # Original existing low-level fixture publisher supplies native Audio
+        # settings/lifetime data, without invoking another input or source read.
+        self.settings_send=audio.owner().settings.send
+
+    def epoch_milliseconds(self,target):
+        self.require(target);return self.audio.epoch()
+
+    def write_control_command(self,target,identity,operation,request):
+        self.require(target)
+        if identity!=self.identity:raise ValueError('Declared candidate identity changed')
+        self.source_commands.append(dict(request))
+        if request['action']=='feature-native-observe':self.audio.native.send(request)
+        elif request['action']=='feature-audio-settings-observe':self.settings_send(request)
+        else:raise ValueError('Only original readonly source commands selected')
+
+    def read_debug_app_file(self,target,package,path,attempts):
+        self.require(target)
+        if package!='org.overte.pico' or attempts!=1:raise ValueError('Declared readonly SDK ABI changed')
+        if path.endswith('/feature-native-observation.json'):
+            if self.native_delay:time.sleep(self.native_delay)
+            return self.audio.native.original()
+        if path.endswith('/feature-audio-settings.json'):return self.audio.settings.read()
+        if path.endswith('/navigation-ui-observation.json'):return json.dumps(self.audio.capture())
+        raise ValueError('Unexpected original source filename')
+
+class StatefulRestartAdapter(CanonicalRestartAdapter):
+    def __init__(self,audio,root):
+        super().__init__(audio,root);self.forced_ps=None
+    @property
+    def command(self):
+        present=self.running and self.identity.split(':')[0]=='123'
+        raw=self.forced_ps if self.forced_ps is not None else (b'PID\n123\n' if present else b'PID\n')
+        return [sys.executable,'-c',
+            "import sys;sys.stdout.buffer.write(bytes.fromhex(sys.argv[1]));sys.exit(int(sys.argv[2]))",
+            raw.hex(),'0' if present or self.forced_ps is not None else '1']
+    @command.setter
+    def command(self,value):self.original_declared_command=tuple(value)
