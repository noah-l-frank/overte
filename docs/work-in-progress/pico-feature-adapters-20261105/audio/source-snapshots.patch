+QVariantMap TestScriptingInterface::featurePicoEmoteSourceOriginal(
+        const std::shared_ptr<const overte::e2e::PicoEmoteSourceTransactionRequest>& original) {
+    const auto queue=_featureRemoteAvatarQueue;
