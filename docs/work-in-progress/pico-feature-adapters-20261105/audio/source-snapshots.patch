+
+bool TestScriptingInterface::waitForCondition(qint64 maxWaitMs, std::function<bool()> condition) {
+    QElapsedTimer elapsed;
+    elapsed.start();
+    while (!condition()) {
+        if (maxWaitMs > 0 && elapsed.elapsed() > maxWaitMs) {
+            return false;
+        }
+        QThread::msleep(1);
+    }
+    return condition();
+}
