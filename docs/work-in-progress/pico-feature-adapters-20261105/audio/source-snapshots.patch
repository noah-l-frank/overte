+        fixture=AuthBundleFixture();self.addCleanup(fixture.doCleanups);fixture.setUp()
+        pc=fixture.fixture;f=pc.f;actor=pc.actor;native=f.native;clock=native.phase_clock
+        self.assertIs(type(f.source.client),Client);self.assertIs(type(actor.source.client),Client)
+        self.assertIs(pc.budget,actor.cleanup_budget);self.assertIs(actor,pc.budget.actor)
+        primary=AudioCommonPrimary1(pc.owner);self.addCleanup(primary.close_host)
+        files=PicoAudioCommonFiles1(actor);self.addCleanup(files.close_host);flow=AudioCommonFlow1(primary,files)
+        def witness():actor.publish();return f.source.client.request('/runs/'+f.run)
+        journey=Journey('audio',f.run,f.source.fixture_url,invoke=flow.invoke,witness=witness,
+            activate=lambda *_args:None,read_artifact=flow.read_artifact,image_policy={},continuity=lambda *_args:None,
+            monotonic=clock.monotonic,epoch_ms=clock.epoch,sleep=native.sleep,report=lambda *_args:None)
+        phase=f.source.status();ticket=phase['activations'][-1]['ticket'];initial=deepcopy(SCENARIOS['audio']['baseline'])
+        journey.wait('owned-clean-baseline',ticket,clock.epoch(),initial,[])
+        for step in SCENARIOS['audio']['steps'][:2]:
+            ticket=f.activate(step['verb'],step['inputs']);barrier=clock.epoch()
+            flow.invoke('feature.audio.act',dict(contractVersion=16,runId=f.run,fixtureUrl=f.source.fixture_url,ticket=ticket,verb=step['verb'],inputs=step['inputs']))
+            observed=journey.wait(step['verb'],ticket,barrier,step['state'],step['evidence'])
+        self.assertEqual(3,len(journey.phases));self.assertEqual(1,len(actor.state['jobs']))
+        self.assertTrue(observed['state']['muted']);self.assertGreater(journey.witness_sequence,0)
+        self.assertFalse(pc.budget.failed);self.assertFalse(flow.failed)
