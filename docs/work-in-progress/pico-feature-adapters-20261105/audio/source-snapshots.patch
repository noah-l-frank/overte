+"""Declared process/birth SDK model, selected before any transport operation.
+
+Real existing Pico IO/RestartInputs/binding-transfer code is not replaced.
+Native/process/UI observations are model facts, never device qualification.
+"""
+from copy import deepcopy
+import json
+import uuid
+import time
+from self_tests.test_pico_audio_settings_source import Boundary as SettingsBoundary
+from self_tests.test_audio_preview_lifetime import sample as empty_lifetime
+from self_tests.test_native_feature_observation import Boundary as NativeBoundary
+from self_tests.test_native_process_presence import Boundary as PresenceBoundary
+from self_tests.test_pico_audio_pages import Boundary as PageBoundary
+from g1_sdk_primitives import OriginalSourceAdapter,StatefulRestartAdapter
+
+class G1SdkModel(OriginalSourceAdapter,StatefulRestartAdapter):
+    def __init__(self,audio,root,*,presence='absent',launch_delta=1):
+        if presence not in ('absent','present','unknown') or type(launch_delta) is not int or launch_delta not in (0,1):
+            raise ValueError('Closed process model selection required')
+        super().__init__(audio,root)
+        self.phase_clock=getattr(audio,'phase_clock',None)
+        self.forced_ps=None;self.presence_mode=presence;self.launch_delta=launch_delta
+        self.saved=None;self.new_native=self.new_presence=self.new_pages=None
+        self.native_instance=self.bridge=self.page_instance=None
+        self.new_settings=None;self.settings_instance=None;self.launch_mono=None;self.launch_epoch=None
+    def shell(self,target,*arguments):
+        self.require(target);self.trace.append(('shell',arguments))
+        if arguments==('am','force-stop','org.overte.pico'):
+            if self.effect:
+                if self.audio.native.sample is None:raise ValueError('Actual old model native read is required')
+                self.saved=deepcopy(self.audio.native.sample);self.running=False
+            operation='stop'
+        else:
+            if arguments!=('am','start','-W','-n',self.profile['e2e_activity']):raise ValueError('Unexpected normal SDK input')
+            if self.effect:
+                if self.saved is None:raise ValueError('Actual modeled old process stop is required')
+                self.running=True;self.identity='789:999'
+                self.native_instance=uuid.uuid4().hex;self.bridge=str(uuid.uuid4());self.page_instance=uuid.uuid4().hex
+                self.launch_mono=time.monotonic();self.launch_epoch=self.audio.epoch()
+                if self.phase_clock is not None:self.phase_clock.launched()
+                self.new_native=NativeBoundary(pid=789,epoch_ms=self.current_epoch)
+                self.new_native.mutate=self.decorate_native
+                self.new_presence=PresenceBoundary(pid=789,epoch_ms=self.current_epoch)
+                self.new_presence.presence=self.presence_mode;self.new_presence.edit=self.decorate_presence
+                self.new_pages=PageBoundary();self.new_pages.mutate=self.decorate_pages
+                self.new_settings=SettingsBoundary();self.settings_instance=uuid.uuid4().hex
+                previous=self.audio.settings.value
+                if previous is not None:
+                    self.new_settings.properties.update(deepcopy(previous["source"]["properties"]))
+                    self.new_settings.source["mixerGains"]=deepcopy(previous["source"]["mixerGains"])
+                    self.new_settings.source["inputPeakValuesEnabled"]=previous["source"]["inputPeakValuesEnabled"]
+                from adapters.pico4.audio_settings_source import ROLES
+                for role in ROLES:self.new_settings.source[role+"Id"]=uuid.uuid4().hex
+                self.new_settings.source["native"]["muted"]=self.saved["audio"]["muted"]
+                self.new_settings.mutate=self.decorate_settings
+            operation='launch'
+        if operation==self.lost:raise OSError('Declared lost original SDK input receipt')
+        return ''
+    def current_epoch(self):
+        if self.phase_clock is not None:return self.phase_clock.epoch()
+        return self.audio.epoch() if self.launch_mono is None else self.launch_epoch+round((time.monotonic()-self.launch_mono)*1000)
+    def epoch_milliseconds(self,target):
+        self.require(target);return self.current_epoch()
+    def decorate_settings(self,packet):
+        packet.update(audioSettingsVersion=2,processId=789,instance=self.settings_instance)
+        packet["source"]["previewLifetime"]=empty_lifetime()
+    def decorate_native(self,packet):
+        lifecycle=deepcopy(self.saved['lifecycle'])
+        lifecycle['launches']+=self.launch_delta;lifecycle['activations']+=1
+        packet.update(instance=self.native_instance,lifecycle=lifecycle,animation={},animationFence={})
+        packet['graphics']=deepcopy(self.saved['graphics'])
+        packet['audio']=dict(recording=False,muted=self.saved['audio']['muted'],recordedVoice=dict(
+            active=False,capturedBytes=0,playedBytes=0,frameBytes=0,sampleRate=0,channels=0,event={},
+            historyVersion=1,cycle=0,startedEpochMs=0,captureSampleRate=0,captureChannels=0,historyComplete=True,events=[]))
+    def decorate_presence(self,packet):packet['instance']=self.native_instance
+    def decorate_pages(self,packet):
+        packet.update(processId=789,bridgeId=self.bridge,generation=self.bridge,updatedEpochMs=self.current_epoch())
+        packet['picoAudioPages'].update(instance=self.page_instance,capturedEpochMs=self.current_epoch())
+    def write_control_command(self,target,identity,operation,request):
+        if self.new_native is None:return super().write_control_command(target,identity,operation,request)
+        self.require(target)
+        if identity!=self.identity or not self.running:raise ValueError('Original new process changed')
+        self.source_commands.append(dict(request))
+        if request['action']=='feature-native-observe':self.new_native.send(request)
+        elif request['action']=='feature-process-presence':self.new_presence.send(request)
+        elif request['action']=='feature-audio-settings-observe':
+            self.new_settings.epoch=self.current_epoch();self.new_settings.send(request)
+        else:raise ValueError('Only original new-process readonly sources selected in this component')
+    def read_debug_app_file(self,target,package,path,attempts):
+        if self.new_native is None:return super().read_debug_app_file(target,package,path,attempts)
+        self.require(target)
+        if package!='org.overte.pico' or attempts!=1:raise ValueError('Changed original source ABI')
+        if path.endswith('/feature-native-observation.json'):return self.new_native.original()
+        if path.endswith('/feature-process-presence.json'):return self.new_presence.original()
+        if path.endswith('/feature-audio-settings.json'):return self.new_settings.read()
+        if path.endswith('/navigation-ui-observation.json'):
+            self.new_pages.epoch=self.current_epoch();return self.new_pages.read()
+        raise ValueError('Unknown original new-process source')
