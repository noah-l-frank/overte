+            {"properties",properties},{"inputPeakValuesEnabled",peak}},{{"script",original},{"devices",devices},{"input",input}}};
+    });
+    if(scriptPart.values.isEmpty()) {return {};}
+    const auto nodePart=queue->read("nodes",nodes.data(),[](QObject* owner) {
