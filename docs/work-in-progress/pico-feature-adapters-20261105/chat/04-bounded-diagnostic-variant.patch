+"""PRIVATE real owned Host process identity for the declared primary SDK model.
+
+The child is a model lifetime endpoint, not Overte/Pico/Qt. Its actual kernel
+birth/absence supports Host lifecycle tests; no Native binary is attested.
+"""
+import hashlib,os,select,subprocess,sys,time
+from pathlib import Path
+from fixture.owned_processes import OwnedProcesses
+from adapters.native_feature_observation import need
+SCRIPT="""import sys
+print('ready',flush=True)
+for line in sys.stdin:
+ if line.strip()=='close':break
+ raise RuntimeError('Unknown model lifetime command')
+"""
+
+def identity(pid):
+    root=Path('/proc')/str(pid)
+    before=root.stat();fields=(root/'stat').read_text().rsplit(')',1)[1].split()
+    need(before.st_uid==os.getuid() and fields[0]!='Z')
+    return str(pid)+':'+fields[19]
+
+class ChatPrimaryProcess1:
+    def __init__(self,root,budget):
+        self.root,self.budget=root,budget;self.failure=None
+        self.child=None;self.closed=False;self.birth=None
+        self.originals=[];self.closes=[]
+        self.script=root/'primary-sdk-model.py'
+        with self.script.open('x') as stream:stream.write(SCRIPT);stream.flush();os.fsync(stream.fileno())
+        self.script.chmod(0o600);self.sha=hashlib.sha256(self.script.read_bytes()).hexdigest()
+        env=os.environ.copy();env['XDG_CONFIG_HOME']=str(root/'config-home')
+        self.processes=OwnedProcesses(env);self.environment=env
+        self.stderr=(root/'primary-sdk-stderr.txt').open('xb')
+        self.launch()
+    def fail(self,error):
+        if self.failure is None:self.failure=(error,error.__traceback__)
+    def launch(self):
+        need(self.failure is None and not self.closed and self.child is None and time.monotonic()<self.budget[1])
+        try:
+            child=subprocess.Popen([sys.executable,'-B',str(self.script)],stdin=subprocess.PIPE,
+                stdout=subprocess.PIPE,stderr=self.stderr,text=True,env=self.environment)
+            self.child=child # Strong before readiness/callbacks.
+            remaining=min(5.,self.budget[1]-time.monotonic());need(remaining>0)
+            need(select.select([child.stdout],[],[],remaining)[0] and child.stdout.readline().strip()=='ready')
+            need(self.processes.matches(child.pid));self.birth=identity(child.pid)
+            self.originals.append(dict(pid=child.pid,identity=self.birth,scriptSha256=self.sha,
+                executableSha256=hashlib.sha256((Path('/proc')/str(child.pid)/'exe').read_bytes()).hexdigest()))
+            self.require_current();return self.birth
+        except BaseException as error:self.fail(error);raise
+    def require_current(self):
+        need(self.failure is None and not self.closed and self.child is not None
+            and self.child.poll() is None and self.processes.matches(self.child.pid)
+            and identity(self.child.pid)==self.birth and time.monotonic()<self.budget[1]
+            and hashlib.sha256(self.script.read_bytes()).hexdigest()==self.sha)
+        return self.birth
+    def stop(self):
+        self.require_current();child=self.child;old=self.birth
+        try:
+            child.stdin.write('close\n');child.stdin.flush()
+            child.wait(timeout=min(5.,max(.001,self.budget[1]-time.monotonic())))
+            need(child.returncode==0 and not (Path('/proc')/str(child.pid)).exists())
+            child.stdin.close();child.stdout.close()
+            self.closes.append(dict(identity=old,waitStatus=child.returncode,kernelAbsent=True))
+            self.child=None;self.birth=None
+            return self.closes[-1]
+        except BaseException as error:self.fail(error);raise
+    def close_host(self):
+        # Resource cleanup does not claim successful business cleanup. A failed
+        # owner still retains firstTB; only its known actual child is stopped.
+        if self.closed:return True
+        child=self.child
+        if child is not None:
+            if child.poll() is None:
+                child.stdin.write('close\n');child.stdin.flush()
+            child.wait(timeout=3);need(child.returncode==0)
+            child.stdin.close();child.stdout.close();self.child=None
+        stream=getattr(self,'stderr',None)
+        if stream is not None:stream.close()
+        self.closed=True
+        processes=getattr(self,'processes',None)
+        need(processes is None or not processes.members());return True
