+        # Separate declared producer state: a QML request is not a measured
+        # native inventory. The normal model input backend must publish this.
+        need(type(raised) is bool);self.keyboard_raised=raised
+    def receive(self,text,channel,sender_uuid,*,local_only=False):
+        # Called by the actual model transport receive path, never by a
+        # checkpoint reader. Outgoing transport acceptance is not receipt.
+        need(self.present and type(text) is str and channel in ('local','domain')
+            and type(local_only) is bool)
+        epoch=time.time_ns()//1000000
+        self.events.append(dict(sequence=len(self.events)+1,capturedEpochMs=epoch,
+            senderSha256=identity(self.run,sender_uuid),localOnly=local_only,channel=channel,text=text))
+        self.storage.append(dict(channel=channel,text=text,timestamp=epoch))
+        getattr(self.widgets,'local' if channel=='local' else 'domain').append(text)
+    def send(self,request):
+        action=request.get('action') if type(request) is dict else None
+        if action not in ('feature-chat-observe','feature-chat-view-observe','feature-chat-profile'):
+            return super().send(request)
+        self.identity();need(self.widgets is self._widgets)
+        epoch=time.time_ns()//1000000
+        if action=='feature-chat-observe':
+            chat_command(request);need(request['runId']==self.run)
+            operation=request['operation']
+            if operation=='observe':
+                need(not self.retired)
+                if not self.present:
+                    self.present=True;self.opened=epoch;self.opened_command=request['commandId']
+            elif operation=='retire':
+                need(self.present and not self.retired)
+                self.present=False;self.retired=True;self.opened=0
+                self.retired_command=request['commandId'];self.events=[]
+            else:need(operation=='inspect')
+            kind='chat'
+            source=dict(scopePresent=self.present,retired=self.retired,
+                selfSha256=identity(self.run,self.self_uuid),mixerPresent=self.mixer_active,
+                mixerSha256='d'*64 if self.mixer_active else '',openedEpochMs=self.opened,
+                eventSequence=len(self.events),droppedEvents=0,events=deepcopy(self.events),
+                openedCommandId=self.opened_command,retiredCommandId=self.retired_command,
+                session=dict(domainSessionVersion=1,instance=self.session_instance,revision=1,
+                    connected=self.mixer_active,domainSha256=identity(self.run,self.domain_uuid),
+                    connectionBirth=self.connection_birth,connectedEpochMs=self.created_epoch,
+                    mixerActive=self.mixer_active))
+            value=dict(chatVersion=3,commandId=request['commandId'],runId=self.run,
+                operation=operation,instance=self.instance,sequence=self.sequence(kind),
+                processId=self.pid,capturedEpochMs=epoch,source=source)
+        elif action=='feature-chat-view-observe':
+            exact(request,{'schemaVersion','commandId','runId','action'})
+            need(type(request['schemaVersion']) is int and request['schemaVersion']==1 and request['runId']==self.run)
+            kind='view';sequence=self.sequence(kind);w=self.widgets
+            keys=keyboard(self.keyboard_raised);keys['sequence']=sequence
+            ui=(dict(present=True,generation=f'{w.page_life:032x}',channel=w.channel,draft=w.draft,
+                    keyboardRequested=w.keyboard_request,localMessages=list(w.local),domainMessages=list(w.domain),
+                    localRowCount=len(w.local),domainRowCount=len(w.domain),
+                    visibleMessages=list(w.local if w.channel=='local' else w.domain),
+                    visibleRowCount=len(w.local if w.channel=='local' else w.domain)) if w.panel else dict(present=False))
+            value=dict(chatViewVersion=2,commandId=request['commandId'],runId=self.run,
+                instance=self.view_instance,sequence=sequence,processId=self.pid,capturedEpochMs=epoch,
+                source=dict(tabletShown=w.tablet,editorFocused=w.focus,editorHasDraft=bool(w.draft),
+                    keyboard=keys,ui=ui,storage=dict(kind='array',count=len(self.storage),unowned=0,
+                        events=deepcopy(self.storage),configSha256=self.fingerprints['cache']['ArmoredChat-Config'])))
+        else:
+            profile_command(request);need(request['runId']==self.run)
+            op=request['operation']
+            if op=='acquire':need(not self.profile_owned);self.profile_owned=True
+            else:need(self.profile_owned)
+            if op=='restore':
+                self.storage=[];self.widgets.local=[];self.widgets.domain=[];self.restored=True
+            kind='profile';sequence=self.sequence(kind)
+            value=dict(chatProfileVersion=1,commandId=request['commandId'],runId=self.run,
+                instance=self.profile_instance,sequence=sequence,processId=self.pid,capturedEpochMs=epoch,
+                owned=True,restoreAttempted=self.restored,restored=self.restored,
+                original=deepcopy(self.fingerprints),current=deepcopy(self.fingerprints),
+                settings=dict(instance=self.settings_instance,writerInstance=self.settings_writer,
+                    mutationSequence=sequence,capturedEpochMs=epoch),
+                view=dict(instance=self.view_instance,sequence=sequence,capturedEpochMs=epoch))
+        raw=json.dumps(value,ensure_ascii=True,separators=(',',':')).encode()
+        need(len(raw)<=262144)
