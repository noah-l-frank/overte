+"""One birth-selected Script manager, fresh original sources on every access.
+
+This is a private owner/call-lifetime experiment, not a cached observation.
+No credit is released, no application fact/guard is reused, and the default
+Pico factory remains unchanged when no owner is selected.
+"""
+from pathlib import Path
+from adapters.native_feature_observation import need
+from adapters.pico4 import normal_scripts
+from adapters.normal_script_manager import NormalScriptManager
+
+class ColdChatScriptManager1:
+    def __init__(self):
+        self.adapter=self.target=self.manager=None
+        self.failure=None;self.active=False;self.accesses=0;self.born=0
+    def fail(self,error):
+        if self.failure is None:self.failure=(error,error.__traceback__)
+    def get(self,adapter,target):
+        need(self.failure is None and not self.active and type(target) is str)
+        self.active=True
+        try:
+            if self.adapter is None:
+                self.adapter,self.target=adapter,target
+                state,_ui=adapter._script_paths(target)
+                # Original factory stack executes once; install partial originals
+                # before entering its callbacks via this owner's active frame.
+                ui,observe,binding=adapter._script_runtime(target)
+                self.manager=object.__new__(NormalScriptManager)
+                from adapters.normal_feature_state import PrivateFeatureState
+                NormalScriptManager.__init__(self.manager,ui,observe,PrivateFeatureState(state),binding)
+                self.born+=1
+            else:
+                need(adapter is self.adapter and target==self.target and type(self.manager) is NormalScriptManager)
+                # Fresh original candidate/process/session/foreground checks,
+                # actual current QML bridge snapshot, and original store CAS.
+                # capture includes both original bind_input bookends.
+                self.manager.require_current()
+                identity=adapter.require_controlled_debug_identity(target)
+                need(identity==self.manager.binding['processIdentity'])
+                current=self.manager.ui.io.capture()
+                need(adapter.require_controlled_debug_identity(target)==identity)
+                need(current['bridgeId']==self.manager.ui.io.bridge
+                    and self.manager.binding['processIdentity']==self.manager.ui.io.navigation.io.identity)
+            # ALWAYS acquire a new original diagnostic; never cache a source
+            # verdict, sequence, GUI state or successful binding check.
+            self.manager.sample();self.accesses+=1
+            return self.manager
+        except BaseException as error:self.fail(error);raise
+        finally:self.active=False
