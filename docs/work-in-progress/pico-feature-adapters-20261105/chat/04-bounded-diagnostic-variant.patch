+    else:context(value['peerBinding']);need(value['peerOriginBasis']=='native-configured-metadata-only')
+    if value['phase'] in PHASES[:5]:need(value['completedSteps']==0)
+    if value['phase'] in PHASES[7:]:need(value['completedSteps']==26)
