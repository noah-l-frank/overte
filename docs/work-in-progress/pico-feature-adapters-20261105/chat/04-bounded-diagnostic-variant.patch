+class Client:
+    def __init__(self,url,reader_token,*,monotonic=time.monotonic,sleep=time.sleep,raw_originals=None):
+        from urllib.parse import urlsplit
+        parsed = urlsplit(url)
+        if (parsed.scheme not in {'http', 'https'} or not parsed.hostname or parsed.path != '/feature-fixture/v1'
+                or parsed.username or parsed.password or parsed.query or parsed.fragment
+                or type(reader_token) is not str or len(reader_token) < 32 or not callable(monotonic) or not callable(sleep)):
+            raise ValueError('Private feature fixture configuration is incomplete')
+        self.url, self.token = url, reader_token
+        self.monotonic,self.sleep=monotonic,sleep
+        self.raw_originals=raw_originals
+        if raw_originals is not None:
+            from http_originals import ChatHttpOriginals1
+            if type(raw_originals) is not ChatHttpOriginals1:raise ValueError('Original HTTP owner required')
+            raw_originals.bind(self)
+
+    def request(self, path, value=None, method=None, *, script_nonce=None, graphics_nonce=None, phase_nonce=None, snapshot_upload_nonce=None, adapter_access=False):
+        original=None if self.raw_originals is None else self.raw_originals.begin(self,path,value,phase_nonce=phase_nonce,method=method,adapter_access=adapter_access)
+        raw = None if value is None else json.dumps(value).encode()
+        headers={'Authorization': 'Bearer ' + self.token, 'Content-Type': 'application/json'}
+        if type(adapter_access) is not bool:raise ValueError('Invalid adapter fixture access marker')
+        if adapter_access:headers['X-Overte-Fixture-Adapter-Read']='1'
+        if script_nonce is not None:headers['X-Overte-Script-Read']=identifier(script_nonce)
+        if graphics_nonce is not None:headers['X-Overte-Graphics-Read']=identifier(graphics_nonce)
+        if phase_nonce is not None:headers['X-Overte-Phase-Read']=identifier(phase_nonce)
+        if snapshot_upload_nonce is not None:headers['X-Overte-Snapshot-Upload-Read']=identifier(snapshot_upload_nonce)
+        request = Request(self.url + path, data=raw, method=method,
+                          headers=headers)
+        try:
+            with build_opener(NoRedirect).open(request, timeout=5) as response:
+                if original is not None:self.raw_originals.before_body(original,response)
+                body = response.read(1024 * 1024 + 1)
+                if original is not None:self.raw_originals.retain(original,body)
+            if len(body) > 1024 * 1024:
+                raise ValueError('Feature fixture response exceeds the bounded limit')
+            if original is not None:self.raw_originals.before_parser(original,body)
+            result=json_document(body)
+            if original is not None:self.raw_originals.returned(original,result)
+            return result
+        except Exception as error:
+            if original is not None:self.raw_originals.fail(error)
+            if hasattr(error, 'close'):
+                error.close()
+            # Do not print URLs, headers, account details or provider exceptions.
+            raise ValueError('Owned feature fixture transport failed') from error
