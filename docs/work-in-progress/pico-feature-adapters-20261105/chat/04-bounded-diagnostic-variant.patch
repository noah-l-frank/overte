+"""PRIVATE closed readonly Chat carrier1; individual source protocols stay original."""
+import re
+from adapters.native_feature_observation import exact,integer,need
+VERSION=1
+ACTION='feature-pico-chat-source-bundle'
+FILE='files/overte-e2e/feature-pico-chat-source-bundle.json'
+LIMIT=262144
+LABELS=('rootsBefore','script','rootsAfter','chat','view','native')
+KINDS=dict(rootsBefore='roots',script='scripts',rootsAfter='roots',chat='chat',view='view',native='native')
+def request(value):
+    exact(value,{'schemaVersion','action','commandId','runId',*(k+'Nonce' for k in LABELS)})
+    need(type(value['schemaVersion']) is int and value['schemaVersion']==1 and value['action']==ACTION)
+    ids=[]
+    for key in ('commandId','runId',*(k+'Nonce' for k in LABELS)):
+        text=value[key];need(type(text) is str and re.fullmatch('[0-9a-f]{32}',text));ids.append(text)
+    need(len(set(ids))==len(ids));return value
+
+def child(command,label):
+    request(command);need(label in LABELS);nonce=command[label+'Nonce'];kind=KINDS[label]
+    actions=dict(roots='feature-script-roots-observe',scripts='feature-script-observe',chat='feature-chat-observe',view='feature-chat-view-observe',native='feature-native-observe')
+    result=dict(schemaVersion=1,commandId=nonce,action=actions[kind])
+    if kind in ('chat','view'):result['runId']=command['runId']
+    if kind=='chat':result['operation']='inspect'
+    return result
+
+def envelope(value,command,pid):
+    request(command)
+    exact(value,{'picoChatSourceBundleVersion','commandId','runId','processId','requestedEpochMs','capturedEpochMs','status',*(k+'Raw' for k in LABELS)})
+    need(type(value['picoChatSourceBundleVersion']) is int and value['picoChatSourceBundleVersion']==VERSION
+        and value['commandId']==command['commandId'] and value['runId']==command['runId']
+        and integer(value['processId'],1) and value['processId']==pid and value['status']=='ready'
+        and integer(value['requestedEpochMs'],1) and integer(value['capturedEpochMs'],value['requestedEpochMs'])
+        and value['capturedEpochMs']-value['requestedEpochMs']<1500)
+    for label in LABELS:need(type(value[label+'Raw']) is str and 0<len(value[label+'Raw'].encode('utf-8'))<=LIMIT)
+    return value
