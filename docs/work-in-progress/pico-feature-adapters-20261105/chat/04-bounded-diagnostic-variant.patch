+"""Private actor-host IPC for original Assignment Client Chat observations.
+
+This transport never launches a process, supplies messages or reports delivery.
+The caller owns executable/PID/start qualification and the independent receiver.
+"""
+# Copyright 2026 Overte contributors.
+# SPDX-License-Identifier: Apache-2.0
+from copy import deepcopy
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import re
+import stat
+import time
+import uuid
+
+from adapters.native_chat_observation import command, validate
+from adapters.native_feature_observation import decode, exact, fresh, integer, need, number
+from adapters.normal_feature_state import context
+from adapters.normal_ui import NativeUIError
+from feature_journeys.contract import typed_equal as same
+
+VERSION=1
+SOURCE='chat-actor-source.v1.json'
+COMMAND='chat-actor-command.v1.json'
+RESULT='feature-chat-observation.json'
+
+
+def encode(value):
+    return (json.dumps(value,sort_keys=True,separators=(',', ':'),ensure_ascii=False,allow_nan=False)+'\n').encode('utf-8')
+
+
+def node(info):
+    return dict(device=str(info.st_dev),inode=str(info.st_ino))
+
+
+def stamp(info):
+    return dict(node(info),size=info.st_size,mtimeNs=info.st_mtime_ns,ctimeNs=info.st_ctime_ns)
+
+
+def identity(value):
+    exact(value,{'device','inode'})
+    need(all(type(value[k]) is str and re.fullmatch('0|[1-9][0-9]{0,24}',value[k]) for k in value))
+    return value
+
+
+def validate_actor_source(source,pid,script_sha256,epoch):
+    need(type(source) is dict and type(source.get('actorVersion')) is int and source['actorVersion'] in (1,2))
+    exact(source,{'actorVersion','instance','processId','configuredEpochMs','scriptSha256'}|({'build'} if source['actorVersion']==2 else set()))
+    if source['actorVersion']==2:
+        build=source['build'];exact(build,{'cleanConfiguredSource','compiledSourceRevision'})
+        need(type(build['cleanConfiguredSource']) is bool and type(build['compiledSourceRevision']) is str
+            and (re.fullmatch('[0-9a-f]{40}',build['compiledSourceRevision']) is not None if build['cleanConfiguredSource'] else build['compiledSourceRevision']==''))
+    need(type(source['instance']) is str and re.fullmatch('[0-9a-f]{32}',source['instance'])
+        and integer(source['processId'],1) and source['processId']==pid
+        and integer(source['configuredEpochMs'],1) and source['configuredEpochMs']<=epoch+1000
+        and source['scriptSha256']==script_sha256)
+    return source
+
+
+def validate_input_lifetime(value,frame):
+    """Optional original actor resource extension; absence has no zero default."""
+    exact(value,{'inputLifetimeVersion','commandId','runId','instance','ownerRunId','sequence','scriptPolls',
+        'releaseConsumed','processId','capturedEpochMs','command','receipt','receiptHandle'})
+    need(type(value['inputLifetimeVersion']) is int and value['inputLifetimeVersion']==1
+        and value['commandId']==frame['commandId'] and value['runId']==frame['runId']
+        and integer(value['processId'],1) and value['processId']==frame['processId']
+        and type(value['instance']) is str and re.fullmatch('[0-9a-f]{32}',value['instance'])
+        and type(value['ownerRunId']) is str
+        and (value['ownerRunId']=='' or re.fullmatch('[0-9a-f]{32}',value['ownerRunId']))
+        and integer(value['sequence'],0,4096) and integer(value['scriptPolls'])
+        and type(value['releaseConsumed']) is bool
+        and integer(value['capturedEpochMs'],frame['capturedEpochMs'],frame['capturedEpochMs']+1500)
+        and bool(value['sequence'])==bool(value['ownerRunId'])
+        and (not value['releaseConsumed'] or value['sequence']>0))
+    for key,flag in (('command','present'),('receipt','present'),('receiptHandle','open')):
+        row=value[key];exact(row,{flag,'node'});need(type(row[flag]) is bool)
+        if row[flag]:identity(row['node'])
+        else:exact(row['node'],set())
+    need(not value['receiptHandle']['open'] or value['receipt']['present']
+        and value['receiptHandle']['node']==value['receipt']['node'])
+    return value
+
+
+def observation_envelope(raw,info):
+    envelope=decode(raw.decode('utf-8'));need(type(envelope) is dict)
+    exact(envelope,{'actorFileVersion','commandNode','resultNode','native'}|({'inputLifetime'}&set(envelope)))
+    need(type(envelope['actorFileVersion']) is int and envelope['actorFileVersion']==VERSION
+        and identity(envelope['resultNode'])==node(info))
+    identity(envelope['commandNode']);need(type(envelope['native']) is dict)
+    if 'inputLifetime' in envelope:validate_input_lifetime(envelope['inputLifetime'],envelope['native'])
+    return envelope
+
+
+class ChatActorFiles:
+    """One owned native actor and one run; uncertain writes remain journalled.
+
+    guard must requalify the actual actor process, start identity and executable.
+    released(node) must inspect that actor's actual open-file inventory, returning
+    True only after its original result FD has closed. Neither is an input ACK.
+    """
+    def __init__(self,directory,store,binding,script_sha256,guard,released,*,component_only=False,
+                 clock_ms=lambda:int(time.time()*1000),monotonic=time.monotonic,sleep=time.sleep,require_original_fd=False,file_originals=None):
+        need(os.name=='posix' and all(callable(v) for v in (guard,released,clock_ms,monotonic,sleep))
+             and type(script_sha256) is str and re.fullmatch('[0-9a-f]{64}',script_sha256) and type(require_original_fd) is bool)
+        if file_originals is not None:
+            from file_originals import ColdChatFileOriginals
+            need(type(file_originals) is ColdChatFileOriginals)
+        self.file_originals=self._file_originals=file_originals
+        self.path=Path(directory);self.store=store;self.guard=guard;self.released=released
+        self.clock_ms,self.monotonic,self.sleep=clock_ms,monotonic,sleep
+        self.binding=deepcopy(context(binding,component_only=component_only));self.component_only=component_only
+        pid=self.binding['processIdentity'].split(':',1)[0];need(re.fullmatch('[1-9][0-9]*',pid))
+        self.pid=int(pid);self.fd=-1;self.fd_owner=None
+        need(self.path.is_absolute() and self.path.resolve(strict=True)==self.path and self.guard() is not False)
