+"""PRIVATE numeric-only12-code diagnostic, no source/input/clock authority."""
+import sys,time,types
+CAPACITY=128
+CREDIT=65536
+MAX_NS=(1<<60)-1
+
+def selected():
+    from adapters.chat_journey.flow_inputs import ChatFlowInputs
+    from adapters.chat_journey.samples import _ChatSources
+    from adapters.chat_journey.script_source import ChatScriptSource
+    from adapters.pico4.audio_raw_archive import AudioRawArchive
+    from adapters.pico4.candidate_read_seal import CandidateReadSeal
+    from chat_bundle_owner import ChatBundleOwner1
+    from normal_model import NormalNativeModel1
+    from cold_model import NativeModel
+    from primary_process import ChatPrimaryProcess1
+    from frame_work import ChatFrameWork6
+    from common_case import CommonCase1
+    functions=(ChatFlowInputs.finish,_ChatSources.read,ChatScriptSource.capture,AudioRawArchive._verify,
+        ChatBundleOwner1.require,NormalNativeModel1.guard,ChatPrimaryProcess1.require_current,
+        CandidateReadSeal.check,ChatFrameWork6.retained_size,CommonCase1.base_resources,ChatFrameWork6.admit,NativeModel.shell)
+    return functions,tuple(fn.__code__ for fn in functions)
+
+class StepCosts1:
+    __slots__=('functions','codes','indices','labels','pins','stack','depth','calls','inclusive','exclusive',
+        'unwinds','invalid','overflow','tool','before','after','memory','policy')
+    def __init__(self):
+        self.functions,self.codes=selected()
+        if len(self.codes)!=12 or len({id(code) for code in self.codes})!=12:raise RuntimeError('Actual cost codes changed')
+        self.indices={id(code):index for index,code in enumerate(self.codes)}
+        self.labels=tuple(code.co_qualname for code in self.codes)
+        guarded=(*self.functions,StepCosts1.__init__,StepCosts1.require,StepCosts1.event,StepCosts1.started,StepCosts1.returned,StepCosts1.unwound,StepCosts1.start,StepCosts1.stop,StepCosts1.report,selected)
+        self.pins=tuple((fn,fn.__code__,fn.__defaults__,fn.__kwdefaults__,tuple((fn.__kwdefaults__ or {}).items())) for fn in guarded)
+        self.policy=(CAPACITY,CREDIT,MAX_NS,time.perf_counter_ns,sys.getsizeof)
+        self.stack=[None]*CAPACITY;self.depth=0
+        self.calls=[0]*12;self.inclusive=[0]*12;self.exclusive=[0]*12;self.unwinds=[0]*12
+        self.invalid=self.overflow=False;self.tool=None;self.before=self.after=None
+        arrays=(self.calls,self.inclusive,self.exclusive,self.unwinds)
+        control=sum(sys.getsizeof(v) for v in (self,self.functions,self.codes,self.indices,self.labels,self.pins,self.policy))
+        control+=sum(sys.getsizeof(k) for k in self.indices)+sum(sys.getsizeof(label) for label in self.labels)
+        control+=sum(sys.getsizeof(row)+sys.getsizeof(row[4])+sum(sys.getsizeof(i) for i in row[4]) for row in self.pins)
+        control+=sum(sys.getsizeof(a)+12*sys.getsizeof(MAX_NS) for a in arrays)
+        slots=sys.getsizeof(self.stack)
+        record=sys.getsizeof((0,MAX_NS,MAX_NS))+3*sys.getsizeof(MAX_NS)
+        # Numeric report/current stamps/callback scratch and nested parent-slot
+        # replacement are bounded independently of retained stack contents.
+        control+=16384
+        self.memory=dict(controlBytes=control,stackListBytes=slots,stackEntryBytes=record,
+            slots=CAPACITY,maximumBytes=control+slots+CAPACITY*record,credit=CREDIT)
+        self.memory['maximumBytes']+=sys.getsizeof(self.memory)+sum(sys.getsizeof(v) for v in self.memory.values())
+        if sys.maxsize!=(1<<63)-1 or self.memory['maximumBytes']>CREDIT:raise RuntimeError('Cost metadata exceeds actual credit')
+        self.require()
+    def require(self):
+        if any(type(a) is not int or a is not b for a,b in zip((CAPACITY,CREDIT,MAX_NS),self.policy[:3])) or time.perf_counter_ns is not self.policy[3] or sys.getsizeof is not self.policy[4]:raise RuntimeError('Cost policy changed')
+        functions,codes=selected()
+        if len(functions)!=12 or len(codes)!=12 or any(a is not b for a,b in zip(functions,self.functions)) or any(a is not b for a,b in zip(codes,self.codes)):raise RuntimeError('Original selected code changed')
+        for fn,code,defaults,kwargs,items in self.pins:
+            if fn.__code__ is not code or fn.__defaults__ is not defaults or fn.__kwdefaults__ is not kwargs:raise RuntimeError('Original code/default changed')
+            now=tuple((kwargs or {}).items())
+            if len(now)!=len(items) or any(k is not a or v is not b for (k,v),(a,b) in zip(now,items)):raise RuntimeError('Original keyword defaults changed')
+    def event(self,code,event):
+        index=self.indices.get(id(code))
+        if index is None or code is not self.codes[index] or self.invalid or self.overflow:return
+        stamp=time.perf_counter_ns()
+        if type(stamp) is not int or not 0<=stamp<=MAX_NS:self.overflow=True;return
+        if event==0:
+            if self.depth>=CAPACITY:self.overflow=True;return
+            self.stack[self.depth]=(index,stamp,0);self.depth+=1;self.calls[index]+=1
+            return
+        if not self.depth or self.stack[self.depth-1][0]!=index:self.invalid=True;return
+        self.depth-=1;old=self.stack[self.depth];self.stack[self.depth]=None
+        elapsed=stamp-old[1];own=elapsed-old[2]
+        if own<0 or self.inclusive[index]+elapsed>MAX_NS:self.invalid=True;return
+        self.inclusive[index]+=elapsed;self.exclusive[index]+=own
+        if event==2:self.unwinds[index]+=1
+        if self.depth:
