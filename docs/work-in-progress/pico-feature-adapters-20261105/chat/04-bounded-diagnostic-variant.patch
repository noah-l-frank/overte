+ 'create': ['objects', 'editor', 'picker', 'error', 'canRez', 'selection', 'textured', 'voxelValue'],
+ 'emotes': ['animation', 'sit', 'override', 'poseProgress','restoredBeforeNominalEnd'],
+ 'world-web': ['surface','text','page','bridgeMessages','bridgeEchoes','attemptedMessages','documentLoads','httpStatus','origin','documentKind','inlineLeases','deferredMessages','error','focused','open'],
+ 'tablet-web': ['surface','text','page','bridgeMessages','bridgeEchoes','attemptedMessages','documentLoads','httpStatus','origin','documentKind','inlineLeases','deferredMessages','error','focused','open'],
+ 'graphics': ['resolution', 'renderScale', 'haze', 'hazePass', 'mirror', 'mirrorPass'],
+ 'audio': ['recording', 'preview', 'muted', 'recordedFrames', 'playedFrames',
+           'bufferedFrames', 'phase', 'history', 'error'],
+ 'chat': ['draft', 'messages', 'localMessages', 'domainMessages', 'peerMessages', 'channel', 'mixerConnected', 'focused', 'keyboard', 'open'],
+ 'snapshots': ['open','pending','captureHistory','files','saved','uploads','shares','saveBackend','savePermission','saveSheet','shareSheet','error'],
+ 'scripts': ['running', 'effects', 'companions', 'picker', 'error', 'open'],
+ 'assets': ['mappings', 'selected', 'baking', 'bakeState', 'bakeAvailable', 'canWrite', 'deleteEnabled', 'error', 'open', 'sceneModel', 'companions', 'picker', 'pickerFile', 'stagedAvailable'],
