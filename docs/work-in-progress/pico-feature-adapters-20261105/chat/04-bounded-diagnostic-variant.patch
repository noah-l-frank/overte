+class CompiledChatSamples(_Compiled,ChatSamples):
+    journal_field='chatCompiledSamplesVersion'
+    journal_version=1
+
+
+class CompiledChatCacheAbsence(_Compiled,ChatCacheAbsence):
+    journal_field='chatCompiledCacheAbsenceVersion'
+    journal_version=1
