+class NormalSources1(PrepareSources):
+    def __init__(self,run,pid,self_uuid,widgets,*,instance=None):
+        super().__init__(run,pid,self_uuid,instance=instance)
+        self.widgets=self._widgets=widgets
+        self.present=self.retired=False;self.opened=0
