+
+class PrepareNativeModel(NativeModel):
+    def __init__(self, root, digest, budget, run, *, primary_process=None, source_factory=PrepareSources, widgets_factory=None):
+        super().__init__(root,digest,budget,primary_process=primary_process,**({} if widgets_factory is None else dict(widgets_factory=widgets_factory)))
+        self.sources = self.original_sources = source_factory(run,self.pid,self.bridge,instance='a'*32,**({} if source_factory is PrepareSources else dict(widgets=self.widgets)))
+        self.run = self.original_run = run
+
+    def current(self, kind):
+        self.guard()
+        need(self.sources is self.original_sources and self.run is self.original_run)
+        if kind in KINDS:
+            return self.sources.current(kind)
+        return super().current(kind)
+
+    def write_debug_app_file(self, target, package, path, raw):
+        need(target == self.target and package == 'org.overte.pico' and type(raw) is str)
+        self.guard()
+        request = json.loads(raw)
+        need(path == 'files/overte-e2e/android-control-command.json' and len(raw.encode('utf-8')) <= 4096
+             and self.sources is self.original_sources and self.run is self.original_run)
+        token = self.raw.archive.reserve('chat-prepare-control', request, 65536)
+        try:
+            self.guard()  # Actual original deadline after capacity/CAS.
+            if request.get('action') == 'normal-feature-observe':
+                need(set(request)=={'schemaVersion','commandId','action','includeAvatarEntities'}
+                     and type(request['schemaVersion']) is int and request['schemaVersion']==1
+                     and request['includeAvatarEntities'] is False)
+                self.sources.identity()
+                self.commands.append(request)
+                # Same actually configured model manager as the fresh V8
+                # snapshot; no empty-service-row shortcut for Chat guards.
+                self.diagnostic=dict(schemaVersion=1,requestId=request['commandId'],
+                    instance='f'*32,sampleSequence=len(self.commands),sampleEpochMs=time.time_ns()//1000000,
+                    complete=True,scripts=[dict(url=self.sources.physical,path=self.sources.physical)])
+            else:
+                self.sources.send(request)
+                self.commands.append(request)
+            self.raw.archive.retain(token, None)
+        except BaseException as error:
+            self.raw.fail(error)
+            raise
+
+    def execute_bytes(self, arguments, *, target, timeout, check=False):
+        import shlex,subprocess,os
+        from chat_bundle_protocol import ACTION,FILE,LABELS,KINDS,request,child,LIMIT
+        argv=shlex.split(arguments[1]) if type(arguments) is list and len(arguments)==2 else []
+        if len(argv)!=9 or argv[5]!='overte-pico-chat-source-bundle1':
+            return super().execute_bytes(arguments,target=target,timeout=timeout,check=check)
+        self.guard();need(target==self.target and arguments[0]=='exec-out' and check is False and 0<timeout<=1.5)
+        command=json.loads(argv[8]);request(command);epoch=time.time_ns()//1000000
+        # First failure/partial originals remain on this original model owner.
+        self.bundle_attempt=dict(command=command,raws={},failure=None)
+        try:
+            for label in LABELS:
+                kind=self.sources.send(child(command,label));need(kind==KINDS[label])
+                raw=json.dumps(self.sources.current(kind),ensure_ascii=True,separators=(',',':'))
+                need(len(raw.encode())<=262144);self.bundle_attempt['raws'][label]=raw
+            packet=dict(picoChatSourceBundleVersion=1,commandId=command['commandId'],runId=command['runId'],processId=self.pid,
+                requestedEpochMs=epoch,capturedEpochMs=time.time_ns()//1000000,status='ready')
+            packet.update({k+'Raw':v for k,v in self.bundle_attempt['raws'].items()})
+            raw=json.dumps(packet,ensure_ascii=True,separators=(',',':')).encode()
+            need(len(raw)<=LIMIT and packet['capturedEpochMs']-epoch<1500)
+            path=self.root/FILE
+            with path.open('wb') as stream:stream.write(raw);stream.flush();os.fsync(stream.fileno())
+            path.chmod(0o600)
+            result=subprocess.run(['sh','-c',argv[4],*argv[5:8]],cwd=self.root,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=timeout,check=False)
+            self.binary_calls.append(('bundle',len(result.stdout),result.returncode));self.commands.append(command)
+            return result.stdout
+        except BaseException as error:
+            self.bundle_attempt['failure']=(error,error.__traceback__);raise
