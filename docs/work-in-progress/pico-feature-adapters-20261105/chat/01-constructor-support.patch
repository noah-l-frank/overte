+            rawBill=self.raw.archive.bill(), otherBill=self.resources())
+
+    def finish(self):
+        if self.parent is not None:
+            try:
+                self.closed['parentHostDetach'] = self.parent.detach()
+            except BaseException as error:
+                self.closed['parentHostDetachError'] = type(error).__name__
+        if self.raw is not None:
+            try:
+                self.closed['rawHostClose'] = self.raw.archive.close_host()
+            except BaseException as error:
+                self.closed['rawHostCloseError'] = type(error).__name__
+        if self.worker is not None:
+            if self.worker.poll() is None:
+                self.worker.stdin.write('close\n')
+                self.worker.stdin.flush()
+            self.worker.wait(timeout=3)
+            self.closed['peerWaitStatus'] = self.worker.returncode
+            for stream in (self.worker.stdin, self.worker.stdout):
+                stream.close()
+            self.stderr.close()
+        return self.closed
+
