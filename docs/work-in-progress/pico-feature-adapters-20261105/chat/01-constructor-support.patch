+"""PRIVATE cold Chat source-byte custody; not an application-ready factory.
+
+Caller resource accounting is mandatory. This reader preserves the existing
+262144-byte leaf grammar, AudioRawArchive limits and original deadline. It
+does not bound historical decoded frames, Native builders, GPU memory or RSS.
+"""
+from types import MappingProxyType
+import shlex
+import subprocess
+import time
+import uuid
+
+from adapters.host_process_identity import host_identity
+from adapters.native_feature_observation import need, exact, integer, number
+from adapters.pico4.audio_raw_archive import AudioRawArchive, AudioRawSourceLock
+from adapters.pico4.emote_stream_model_raw import literal
+from adapters.pico4.emote_stream_wire import _BODY, physical_stamp
+from adapters.pico4.probe_originals import same_callable
+from adapters.script_journey.lock import ScriptSourceLock
+
+VERSION = 1
+LIMIT = 262144
+WIRE_LIMIT = LIMIT + 1 + 4096
+# Only the concurrently active wire/framing/UTF8 domain. The caller still
+# charges ALL source frames, original payloads, other metadata and Native files.
+LITERAL_WORK = 8 * WIRE_LIMIT
+CONTROL_WORK = 32768
+FILES = MappingProxyType({
+    'marker': 'files/overte-e2e/android-control.json',
+    'probe': 'files/overte-e2e/overte-probe.json',
+    'ui': 'files/overte-e2e/navigation-ui-observation.json',
+    'status': 'files/overte-e2e/navigation-ui-status.json',
+    'diagnostic': 'files/overte-e2e/normal-feature-observation.json',
+    'native': 'files/overte-e2e/feature-native-observation.json',
+    'roots': 'files/overte-e2e/feature-script-roots.json',
+    'scripts': 'files/overte-e2e/feature-script-observation.json',
+    'profile': 'files/overte-e2e/feature-chat-profile.json',
+    'chat': 'files/overte-e2e/feature-chat-observation.json',
+    'view': 'files/overte-e2e/feature-chat-view-observation.json',
+})
+OWNED = []
+
+
+def script(kind):
+    need(type(kind) is str and kind in FILES)
+    return 'stream_path=' + FILES[kind] + '\n' + _BODY.replace('CHECK_SAMPLE', '')
+
+
+class ColdChatOriginals:
+    """Birth-selected original SDK reader; unknown acquisition never replays.
+
+    No app getter is invoked by construction. `resources` must return the
+    complete other-domain prospective bill; no default/free allowance exists.
+    """
+    def __init__(self, path, run, role, target, binary, resources, budget, *,
+                 monotonic=time.monotonic):
+        need(type(run) is str and len(run) == 32 and all(c in '0123456789abcdef' for c in run)
+             and type(role) is str and role in ('primary', 'actor') and type(target) is str and target
+             and callable(binary) and callable(resources) and callable(monotonic)
+             and type(budget) is tuple and len(budget) == 2
+             and all(type(value) is float for value in budget)
+             and 0 < budget[1] - budget[0] <= 120)
+        self.run, self.role, self.target = run, role, target
+        self.binary, self.resources, self.monotonic = binary, resources, monotonic
+        self.budget = budget
+        self.host = host_identity()
+        self.failed = False
+        self.active = self.issued = self.first_error = None
+        self.root_node = None
+        self.references = []
+        self._config = self._original_config = (
+            run, role, target, binary, resources, monotonic, budget, self.host)
+        self.lock = ScriptSourceLock(path.with_name('chat-raw-sources.lock'))
+        self.raw_lock = AudioRawSourceLock(self.lock)
+        self._bill_callback = self.bill
+        self._identity_callback = self.identity
+        # Retain the actual delegated original owner BEFORE its constructor.
+        OWNED.append(self)
+        self.archive = object.__new__(AudioRawArchive)
+        try:
+            AudioRawArchive.__init__(self.archive, path,
+                dict(picoChatColdOriginalsVersion=VERSION, runId=run, role=role,
+                     target=target, hostProcessIdentity=self.host,
+                     originalStarted=budget[0], originalDeadline=budget[1]),
+                self.raw_lock, self._identity_callback, self._bill_callback, monotonic)
+        except BaseException as error:
+            self.fail(error)
+            raise
+
+    def configuration(self):
+        p = self._config
+        need(p is self._original_config and type(p) is tuple and len(p) == 8
+             and type(self.run) is type(self.role) is type(self.target) is str
+             and (self.run, self.role, self.target) == p[:3]
+             and same_callable(self.binary, p[3])
+             and same_callable(self.resources, p[4])
+             and same_callable(self.monotonic, p[5])
+             and self.budget is p[6] and self.host is p[7])
+
+    def identity(self):
+        # Resource identity intentionally does not call an app getter or the
+        # business clock. Already-issued raw bytes can survive business expiry.
+        self.configuration()
+        need(host_identity() == self.host)
+        return True
+
+    def live(self):
+        self.identity()
+        need(not self.failed)
+        now = self.monotonic()
+        need(number(now, self.budget[0], self.budget[1]) and now < self.budget[1])
+        return now
+
+    def bill(self):
+        self.identity()
+        value = self.resources()
+        exact(value, {'parts', 'storedBytes', 'decodedBytes'})
+        need(all(integer(value[key]) for key in value))
+        return dict(parts=value['parts'],
+            storedBytes=value['storedBytes'] + LITERAL_WORK + CONTROL_WORK,
+            decodedBytes=value['decodedBytes'] + LITERAL_WORK + CONTROL_WORK)
+
+    def fail(self, error):
+        # This precedes every later callback/normalization. Never replace an
+        # earlier original exception and its original stack with a later one.
+        if self.first_error is None:
+            self.first_error = (error, error.__traceback__)
+        self.failed = True
+
+    def retain(self, issued, wire):
+        archive, token, retainer = issued
+        # AudioRawArchive retains the genuine issued original before entering
+        # its file/OFD guard; overlong/foreign returns stay on this owner too.
+        if type(wire) is not bytes or len(wire) > WIRE_LIMIT:
+            self.unknown_return = (issued, wire)
+            need(False)
+        reference = retainer(token, wire)
+        self.references.append(reference)
+        need(self.issued is issued)
+        self.issued = None
+        return reference
+
+    def read(self, kind):
+        # Acquire ownership before ANY resource/clock/SDK callback. A nested
+        # refusal cannot clear this outer acquisition's claim.
+        need(type(kind) is str and kind in FILES)
+        if self.active is not None:
+            try:
+                need(False)
+            except BaseException as error:
+                self.fail(error)
+                raise
+        claim = object()
+        self.active = claim
+        try:
+            started = self.live()
+            nonce = uuid.uuid4().hex
+            command = dict(picoChatColdOriginalVersion=VERSION, runId=self.run,
+                role=self.role, kind=kind, wireNonce=nonce)
+            archive = self.archive
+            token = archive.reserve('chat-cold-source', command, WIRE_LIMIT)
+            issued = (archive, token, archive.retain)
+            self.issued = issued
+            remote = ' '.join(shlex.quote(value) for value in (
+                'run-as', 'org.overte.pico', 'sh', '-c', script(kind),
+                'overte-pico-chat-cold-source', nonce, str(LIMIT + 1)))
+            now = self.live()
+            remaining = min(started + 5, self.budget[1]) - now
+            need(0 < remaining <= 5)
+            try:
+                wire = self.binary(['exec-out', remote], target=self.target,
+                    timeout=remaining, check=False)
+            except BaseException as error:
+                partial = (subprocess.TimeoutExpired, subprocess.CalledProcessError)
+                cause = error if isinstance(error, partial) else error.__cause__
+                if isinstance(cause, partial) and type(cause.output) is bytes:
+                    self.retain(issued, cause.output)
+                raise
+            self.retain(issued, wire)  # BEFORE framing, UTF8 or source parsing.
+            now = self.live()
+            need(self.active is claim and now - started < 5)
+            body, physical = literal(wire, nonce)
+            node = tuple(physical_stamp(physical[0])[:5])
+            if self.root_node is None:
+                self.root_node = node
+            need(node == self.root_node)
+            value = body.decode('utf-8', errors='strict')
+            now = self.live()
+            need(self.active is claim and now - started < 5)
+            return value
+        except BaseException as error:
+            self.fail(error)
+            raise
+        finally:
+            if self.active is claim:
+                self.active = None
+
+    def original_reader(self, target, package, path, *, attempts=1, **options):
+        try:
+            need(type(target) is type(package) is type(path) is str
+                 and target == self.target and package == 'org.overte.pico'
+                 and type(attempts) is int and attempts == 1 and not options)
+            kinds = [kind for kind, fixed in FILES.items() if path == fixed]
+            need(len(kinds) == 1)
+            return self.read(kinds[0])
+        except BaseException as error:
+            self.fail(error)
+            raise
