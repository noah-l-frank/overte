+def snapshot(paths):
+    rows = {}
+    for path in sorted(set(paths)):
+        if path.is_file():
+            first = path.stat()
+            raw = path.read_bytes()
+            second = path.stat()
+            stamp = lambda value: [value.st_dev, value.st_ino, value.st_uid,
+                value.st_mode, value.st_nlink, value.st_size, value.st_mtime_ns, value.st_ctime_ns]
+            if stamp(first) != stamp(second):
+                raise RuntimeError('Source changed during the original snapshot')
+            rows[str(path)] = dict(sha256=hashlib.sha256(raw).hexdigest(), stat8=stamp(second))
+    return rows
