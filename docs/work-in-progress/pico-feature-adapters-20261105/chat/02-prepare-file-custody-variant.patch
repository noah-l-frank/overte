+"""PRIVATE fresh born source builders for actual Chat prepare/baseline owners.
+
+These are declared Native/Qt/V8 model producers, not device attestations. Every
+request creates a new original model packet before its actual file publication.
+No returned packet is retimed and no requested checkpoint facts are consulted.
+"""
+from copy import deepcopy
+import hashlib
+import json
+import time
+import uuid
+import re
+
+from adapters.native_chat_observation import command as chat_command, identity
+from adapters.native_chat_profile import command as profile_command
+from adapters.native_feature_observation import exact, integer, need
+from adapters.chat_journey.source_chunks import json_digest
+from adapters.pico4.probe_originals import same_callable
+from adapters.chat_journey.script_source import pins
+from self_tests.test_native_feature_observation import Boundary as NativeFeatureBuilder
+from self_tests.test_pico_chat_keyboard import keyboard
+
+
+class PrepareSources:
+    """Closed UI, empty initial cache and original compiled-code context."""
+    def __init__(self, run, pid, self_uuid, *, instance=None):
+        need(type(run) is str and len(run) == 32 and integer(pid, 1)
+             and type(self_uuid) is str and str(uuid.UUID(self_uuid)) == self_uuid)
+        self.run, self.pid, self.self_uuid = run, pid, self_uuid
+        self.created_epoch = time.time_ns() // 1000000
+        self.instance = uuid.uuid4().hex if instance is None else instance
+        self.manager = uuid.uuid4().hex
+        self.profile_instance, self.settings_instance = uuid.uuid4().hex, uuid.uuid4().hex
+        self.settings_writer, self.view_instance = uuid.uuid4().hex, uuid.uuid4().hex
+        self.session_instance, self.connection_birth = uuid.uuid4().hex, uuid.uuid4().hex
+        self.root = 'file:///actual/configured/cache/scripts'
+        self.physical = self.root + '/communityScripts/armored-chat/armored_chat.js'
+        self.code = pins()  # Actual unchanged reviewed Script source bytes.
+        self.domain_uuid = '33333333-3333-4333-8333-333333333333'
+        empty = hashlib.sha256(b'[]').hexdigest()
+        config = hashlib.sha256(b'{}').hexdigest()
+        self.fingerprints = dict(cache={'ArmoredChat-Messages': empty, 'ArmoredChat-Config': config},
+            worker={'ArmoredChat-Messages': empty, 'ArmoredChat-Config': config},
+            physical={'ArmoredChat-Messages': dict(present=False, empty=True, sha256=empty),
+                'ArmoredChat-Config': dict(present=True, sha256=config)})
+        self.profile_owned = False
+        self.requests = []
+        self.values = {}
+        self.sequences = {}
+        self.native = NativeFeatureBuilder(pid=pid, epoch_ms=lambda: time.time_ns() // 1000000)
+        self._config = self._original_config = (run, pid, self_uuid, self.instance, self.manager,
+            self.created_epoch, self.root, self.physical, self.code)
+        self.code_sha=json_digest(self.code)
+        self.fingerprints_sha=json_digest(self.fingerprints)
+        self.native_epoch=self.native.epoch_ms
+
+    def identity(self):
+        p=self._config
+        need(p is self._original_config and self.run is p[0] and self.pid is p[1]
+            and self.self_uuid is p[2] and self.instance is p[3] and self.manager is p[4]
+            and self.created_epoch is p[5] and self.root is p[6] and self.physical is p[7]
+            and self.code is p[8] and json_digest(self.code)==self.code_sha
+            and json_digest(self.fingerprints)==self.fingerprints_sha
+            and type(self.native) is NativeFeatureBuilder and self.native.pid is self.pid
+            and self.native.mutate is None and self.native.ignored is False
+            and same_callable(self.native.epoch_ms,self.native_epoch))
+
+    def sequence(self, kind):
+        self.sequences[kind] = self.sequences.get(kind, 0) + 1
+        return self.sequences[kind]
+
+    def send(self, request):
+        self.identity()
+        need(type(request) is dict and type(request.get('action')) is str)
+        need(type(request.get('commandId')) is str and re.fullmatch('[0-9a-f]{32}',request['commandId']))
+        action = request['action']
+        epoch = time.time_ns() // 1000000
+        if action == 'feature-chat-profile':
+            profile_command(request)
+            need(request['runId'] == self.run and request['operation'] in ('acquire', 'inspect'))
+            if request['operation'] == 'acquire':
+                need(not self.profile_owned)
+                self.profile_owned = True
+            need(self.profile_owned)
+            sequence = self.sequence('profile')
+            value = dict(chatProfileVersion=1, commandId=request['commandId'], runId=self.run,
+                instance=self.profile_instance, sequence=sequence, processId=self.pid,
+                capturedEpochMs=epoch, owned=True, restoreAttempted=False, restored=False,
+                original=deepcopy(self.fingerprints), current=deepcopy(self.fingerprints),
+                settings=dict(instance=self.settings_instance, writerInstance=self.settings_writer,
+                    mutationSequence=sequence, capturedEpochMs=epoch),
+                view=dict(instance=self.view_instance, sequence=sequence, capturedEpochMs=epoch))
+            kind = 'profile'
+        elif action == 'feature-chat-observe':
+            chat_command(request)
+            # Actual cache activation belongs to the later ordinary Open path.
+            # This finite provider cannot silently satisfy an Observe/Retire.
+            need(request['runId'] == self.run and request['operation'] == 'inspect')
+            value = dict(chatVersion=3, commandId=request['commandId'], runId=self.run,
+                operation='inspect', instance=self.instance, sequence=self.sequence('chat'),
+                processId=self.pid, capturedEpochMs=epoch,
+                source=dict(scopePresent=False, retired=False, selfSha256=identity(self.run, self.self_uuid),
+                    mixerPresent=True, mixerSha256='d'*64, openedEpochMs=0,
+                    eventSequence=0, droppedEvents=0, events=[], openedCommandId='', retiredCommandId='',
+                    session=dict(domainSessionVersion=1, instance=self.session_instance, revision=1,
+                        connected=True, domainSha256=identity(self.run, self.domain_uuid),
+                        connectionBirth=self.connection_birth, connectedEpochMs=self.created_epoch, mixerActive=True)))
+            kind = 'chat'
+        elif action == 'feature-chat-view-observe':
+            exact(request, {'schemaVersion', 'commandId', 'runId', 'action'})
+            need(type(request['schemaVersion']) is int and request['schemaVersion'] == 1 and request['runId'] == self.run)
+            sequence = self.sequence('view')
+            keys = keyboard(False)
+            keys['sequence'] = sequence
+            value = dict(chatViewVersion=2, commandId=request['commandId'], runId=self.run,
+                instance=self.view_instance, sequence=sequence, processId=self.pid, capturedEpochMs=epoch,
+                source=dict(tabletShown=False, editorFocused=False, editorHasDraft=False,
+                    keyboard=keys, ui={'present': False},
+                    storage=dict(kind='array', count=0, unowned=0, events=[],
+                        configSha256=self.fingerprints['cache']['ArmoredChat-Config'])))
+            kind = 'view'
+        elif action == 'feature-native-observe':
+            exact(request, {'schemaVersion', 'commandId', 'action'})
+            need(type(request['schemaVersion']) is int and request['schemaVersion'] == 1)
+            self.native.send(request)
+            value = self.native.sample
+            kind = 'native'
+        elif action in ('feature-script-roots-observe', 'feature-script-observe'):
+            exact(request, {'schemaVersion', 'commandId', 'action'})
+            need(type(request['schemaVersion']) is int and request['schemaVersion'] == 1
+                 and type(request['commandId']) is str and len(request['commandId']) == 32)
+            if action == 'feature-script-roots-observe':
+                kind = 'roots'
+                value = dict(scriptRootsVersion=1, commandId=request['commandId'], instance=self.instance,
+                    sequence=self.sequence(kind), processId=self.pid, requestedEpochMs=epoch,
+                    capturedEpochMs=epoch, source=dict(defaultScriptsUrl=self.root))
+            else:
+                kind = 'scripts'
+                code = {key: self.code[key] for key in ('encoding', 'codeUnits', 'sha256')}
+                engine = dict(url=self.physical, running=True, stopping=False, finished=False,
