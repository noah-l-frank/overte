+"""PRIVATE typed native-file originals, before the existing Chat parser.
+
+The same AudioRawArchive stores genuinely new SOURCE/RESULT originals. Every
+immutable reread still opens its own paired OFD and reads/compares full bytes.
+This is byte custody, never a cached Chat verdict or an SDK-return relabeling.
+"""
+import hashlib
+import os
+from pathlib import Path
+import stat
+import time
+
+from adapters.chat_journey.archive_file import signature
+from adapters.native_fd_owner import OriginalDescriptor, require_directory
+from adapters.native_feature_observation import exact, integer, need
+from adapters.pico4.probe_originals import same_callable
+from cold_originals import ColdChatOriginals
+
+SOURCE = 'chat-actor-source.v1.json'
+COMMAND = 'chat-actor-command.v1.json'
+RESULT = 'feature-chat-observation.json'
+LIMITS = {SOURCE: 4096, COMMAND: 2048, RESULT: 131072}
+FILE_WORK = 8 * 131072 + 32768
+OWNED = []
+
+
+class FileCredit:
+    """Additive permanent file domain, selected before RawArchive birth."""
+    def __init__(self, base):
+        need(callable(base))
+        self.base = self._base = base
+        self.work = self._work = FILE_WORK
+
+    def identity(self):
+        need(same_callable(self.base, self._base) and type(self.work) is int
+             and self.work is self._work and self.work == FILE_WORK)
+
+    def bill(self):
+        self.identity()
+        value = self.base()
+        exact(value, {'parts', 'storedBytes', 'decodedBytes'})
+        need(all(integer(value[key]) for key in value))
+        return dict(parts=value['parts'], storedBytes=value['storedBytes']+self.work,
+            decodedBytes=value['decodedBytes']+self.work)
+
+
+class _Window:
+    def __init__(self, name, limit):
+        self.name, self.limit = name, limit
+        self.owner = self.raw = self.token = self.reference = self.before = None
+        self.known = None
+
+
+class ColdChatFileOriginals:
+    """Actual native directory, one warm file owner and one original budget."""
+    def __init__(self, directory, scope, credit, source_reference, source_stamp):
+        need(type(scope) is ColdChatOriginals and type(credit) is FileCredit
+             and same_callable(scope.resources, credit.bill))
+        self.directory = directory
+        self.scope, self.credit = scope, credit
+        self._config = self._original_config = (directory, scope, credit, scope.archive, scope.budget)
+        self.files = self._files = None
+        self.active = None
+        self.failed = False
+        self.first_error = None
+        self.closed_windows = self.fresh_windows = 0
+        self.known = {SOURCE: (tuple(source_stamp), source_reference, None)}
+        self._known = self.known
+        OWNED.append(self)
+        self.root = object.__new__(OriginalDescriptor)
+        try:
+            OriginalDescriptor.__init__(self.root, directory,
+                os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC)
+            self.original_root = self.root
+            self.identity()
+        except BaseException as error:
+            self.fail(error)
+            raise
+
+    def identity(self):
+        p = self._config
+        need(p is self._original_config and self.directory is p[0] and self.scope is p[1] and self.credit is p[2]
+             and self.scope.archive is p[3] and self.scope.budget is p[4]
+             and self.root is self.original_root and self.files is self._files
+             and self.known is self._known and type(self.known) is dict
+             and same_callable(self.scope.resources, self.credit.bill))
+        self.scope.identity()
+        self.credit.identity()
+        require_directory(self.root, self.directory)
+
+    def bind_files(self, files):
+        from adapters.chat_actor_files import ChatActorFiles
+        self.identity()
+        need(not self.failed and self.files is None and type(files) is ChatActorFiles
+             and files.path == self.directory)
+        self.files = self._files = files
+
+    def fail(self, error):
+        if self.first_error is None:
+            self.first_error = (error, error.__traceback__)
+        self.failed = True
+
+    def _live(self, started=None):
+        self.identity()
+        need(not self.failed)
+        now = self.scope.live()
+        if started is not None:
+            need(0 <= now-started < 5)
+        return now
+
+    def require_source(self):
+        # Before OwnedChatPeer's first SOURCE JSON parser. No new observation
+        # or source ID is invented by rereading the already admitted original.
+        need(self.files is None)
+        self.read(None, SOURCE, LIMITS[SOURCE])
+
+    def read(self, files, name, limit):
+        need(type(name) is str and name in LIMITS and type(limit) is int and limit == LIMITS[name])
+        if self.active is not None:
+            try:
+                need(False)
+            except BaseException as error:
+                self.fail(error)
+                raise
+        window = self.active = _Window(name, limit)
+        try:
+            started = self._live()
+            need(files is self.files and (files is not None or name == SOURCE))
+            if files is not None:
+                files._check_root()  # ORIGINAL process/root guard.
+            # Permanent FILE_WORK was part of every earlier raw reservation;
+            # refresh the complete compound bill before opening this window.
+            self.scope.bill()
+            require_directory(self.root, self.directory)  # AFTER admission callbacks, BEFORE dirfd-based open.
+            window.owner = object.__new__(OriginalDescriptor)
+            OriginalDescriptor.__init__(window.owner,
+                '/proc/self/fd/'+str(self.root.fd)+'/'+name,
+                os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK|os.O_CLOEXEC)
+            info = window.before = os.fstat(window.owner.fd)
+            need(stat.S_ISREG(info.st_mode) and stat.S_IMODE(info.st_mode) == 0o600
+                 and info.st_uid == os.geteuid() and info.st_nlink == 1 and 0 < info.st_size <= limit)
+            stamp = tuple(signature(info))
+            previous = self.known.get(name)
+            if previous is not None:
+                need(type(previous) is tuple and len(previous) == 3 and type(previous[0]) is tuple
+                     and len(previous[0]) == 8 and all(type(value) is int for value in previous[0]))
+            request_id = None
+            if name == RESULT:
+                request = files._owned()['request']
+                need(type(request) is dict)
+                request_id = request['commandId']
+            if previous is not None and stamp == previous[0]:
+                window.known = previous
+            elif name == SOURCE:
+                # The immutable origin cannot be replaced by a new version.
+                need(False)
+            elif name == RESULT:
+                need(previous is None or request_id != previous[2])
+                window.token = self.scope.archive.reserve('chat-peer-native-file',
+                    dict(picoChatFileOriginalVersion=1, runId=self.scope.run,
+                        file=name, requestId=request_id), limit)
+            # COMMAND is original host policy, not a native source return.
+            # Its original caller still performs its exact full-byte match.
+            window.owner.require(window.owner.fd)  # After ALL admission callbacks, before actual IO.
+            window.raw = os.pread(window.owner.fd, limit+1, 0)
+            if window.token is not None:
+                window.reference = self.scope.archive.retain(window.token, window.raw)
+            elif window.known is not None:
+                need(self.scope.archive.literal(window.known[1]) == window.raw)
+            # No envelope, UTF8 or native JSON parser has run above this line.
+            current = os.stat(name, dir_fd=self.root.fd, follow_symlinks=False)
+            need(tuple(signature(os.fstat(window.owner.fd))) == tuple(signature(current)) == stamp
+                 and len(window.raw) == info.st_size)
+            if files is not None:
+                files._check_root()
+            self._live(started)
+            window.owner.require(window.owner.fd)
+            need(window.owner.close())
+            if window.reference is not None:
+                self.known[name] = (stamp, window.reference, request_id)
+                self.fresh_windows += 1
+            self.closed_windows += 1
+            self.active = None
+            return window.raw, info
+        except BaseException as error:
+            # Keep exact original exception/TB/window/FD/raw bytes. A test's
+            # external reference is not the owner of this unresolved lifetime.
+            self.fail(error)
+            raise
+
+    def close_host(self):
+        results = []
+        if self.active is not None and self.active.owner is not None:
+            results.append(self.active.owner.close())
+        results.append(self.root.close())
+        return all(results)
