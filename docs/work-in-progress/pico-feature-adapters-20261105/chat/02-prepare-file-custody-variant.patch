+            ownerToken=self.processes.owner,configHome=self.processes.config_home),None)
+        original = ClosedOriginalFile(self.root/'actor'/'chat-actor-source.v1.json',0o600,self.scope.live)
+        token = self.scope.archive.reserve('native-peer-origin',dict(runId=RUN,kind='source'),65536)
+        result = []
+        original.read(lambda raw:result.append(self.scope.archive.retain(token,raw)))
+        self.gate = object.__new__(ColdChatFileOriginals)
+        ColdChatFileOriginals.__init__(self.gate,self.root/'actor',self.scope,self.credit,result[0],original.stamp)
+        self.peer = OwnedChatPeer(self.config,PrivateFeatureState(self.root/'state'/'actor-files.json'),file_originals=self.gate)
+
+    def run(self, kind):
+        self.setup()
+        with self.peer.lock.held():
+            reader = self.peer.reader()
+            frame = reader.perform(RUN,'inspect')
+        before = self.scope.archive.state['reads']
+        fact = dict(operation=frame['operation'],fileOriginalWindows=self.gate.closed_windows,
+            newNativeOriginals=self.gate.fresh_windows,rawReads=before,
+            sourcePayloadBytes=self.scope.archive.bill()['literalBytes'],sdkCalls=self.forbidden_sdk,
+            fileWork=FILE_WORK,normalFramePidMatches=frame['processId']==self.worker.pid)
+        result_path=self.root/'actor'/'feature-chat-observation.json'
+        fact['rawEnvelopeMatchesActualFile']=self.scope.archive.literal(self.gate.known[result_path.name][1])==result_path.read_bytes()
+        fact['rawEnvelopeStampMatchesActualFile']=self.gate.known[result_path.name][0]==tuple(signature(result_path.stat()))
+        if kind == 'normal':return fact
+        if kind == 'source-change':
+            source = self.root/'actor'/'chat-actor-source.v1.json'
+            old = source.read_bytes()
+            protected = self.root/'retained-original-source.json'
+            os.replace(source,protected)
+            descriptor = os.open(source,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
+            with os.fdopen(descriptor,'wb') as stream:stream.write(old);stream.flush();os.fsync(stream.fileno())
+            descriptor = os.open(source.parent,os.O_RDONLY|os.O_DIRECTORY);os.fsync(descriptor);os.close(descriptor)
+            fact['oldBytesRetained'] = protected.read_bytes()==old
+        elif kind == 'credit-change':
+            self.credit.work = True  # Data only, no code/class/global changes.
+        else:raise RuntimeError('Unknown finite counter')
+        error_seen = False
+        try:self.peer.guard()
+        except BaseException:error_seen=True
+        gc.collect()  # The actual owner must retain failure without test refs.
+        first = self.gate.first_error
+        fact.update(refused=error_seen,ownerFailed=self.gate.failed,
+            firstErrorOwned=first is not None,firstTracebackOwned=first is not None and first[1] is not None,
+            unresolvedWindowOwned=self.gate.active is not None,
+            actualWindowDescriptorOwned=self.gate.active is not None and self.gate.active.owner is not None
+                and self.gate.active.owner.closed is False,
+            rawReadsAfter=self.scope.archive.state['reads'],sdkCallsAfter=self.forbidden_sdk)
+        return fact
+
+    def close(self):
+        for label,owner,method in (('peerHost',self.peer,'close_host'),('fileHost',self.gate,'close_host')):
+            if owner is not None:
+                try:self.closed[label]=getattr(owner,method)()
+                except BaseException as error:self.closed[label]=type(error).__name__
+        if self.scope is not None:
+            try:self.closed['rawHost']=self.scope.archive.close_host()
+            except BaseException as error:self.closed['rawHost']=type(error).__name__
+        if self.worker is not None:
+            if self.worker.poll() is None:self.worker.stdin.write('close\n');self.worker.stdin.flush()
+            self.worker.wait(timeout=3)
+            self.closed['workerExit']=self.worker.returncode
+            self.closed['workerAbsent']=not Path('/proc',str(self.worker.pid)).exists()
+            for stream in (self.worker.stdin,self.worker.stdout,self.stderr):stream.close()
+
+
+def main():
+    parser=argparse.ArgumentParser()
+    parser.add_argument('--case',choices=('normal','source-change','credit-change'),required=True)
+    parser.add_argument('--output',type=Path,required=True)
+    args=parser.parse_args()
+    args.output.mkdir(mode=0o700,exist_ok=False)
+    case=Case(args.output.resolve())
+    paths=list(REPO.rglob('*.py'))+list(HERE.rglob('*.py'))+[OLD/'cold_originals.py']
+    before=snapshot(paths)
+    head=subprocess.check_output(['git','rev-parse','HEAD'],cwd=REPO,text=True).strip()
+    if head!='b6355270c8e2afffbdeda95430638a2c8fd7a089' or subprocess.check_output(['git','status','--porcelain'],cwd=REPO,text=True):
+        raise RuntimeError('Original reviewed source epoch is unavailable')
+    report=dict(case=args.case,sourceBefore=before,nativeQualified=False,parentQualified=False,
+        baselineQualified=False,wholeQualified=False,applicationReady=False,head=head)
+    try:report['actual']=case.run(args.case)
+    except BaseException as error:
+        import traceback
+        case.first_error=(error,error.__traceback__)
+        report['error']=''.join(traceback.format_exception(error))
+    finally:
+        try:case.close()
+        except BaseException as error:report['cleanupError']=type(error).__name__
+        report['closed']=case.closed
+        report['sourceAfter']=snapshot(paths)
+        report['sourceStable']=report['sourceAfter']==before
+        report['headAfter']=subprocess.check_output(['git','rev-parse','HEAD'],cwd=REPO,text=True).strip()
+        report['elapsed']=time.monotonic()-case.budget[0]
+        report['originals']=snapshot(args.output.rglob('*'))
+        (args.output/'result.json').write_text(json.dumps(report,indent=2)+'\n')
+    # All final checks are outside SourceLock, native reader and guarded calls.
+    actual=report.get('actual',{})
+    okay=(case.first_error is None and report['sourceStable'] and report['headAfter']==head and actual.get('normalFramePidMatches') is True
+        and actual.get('rawEnvelopeMatchesActualFile') is True and actual.get('rawEnvelopeStampMatchesActualFile') is True
+        and actual.get('newNativeOriginals')==1 and actual.get('rawReads')==2 and actual.get('sdkCalls')==0
+        and all(case.closed.get(key) is True for key in ('peerHost','fileHost','rawHost','workerAbsent'))
+        and case.closed.get('workerExit')==0 and time.monotonic()<case.budget[1])
+    if args.case!='normal':okay=okay and all(actual.get(key) is True for key in ('refused','ownerFailed','firstErrorOwned','firstTracebackOwned','unresolvedWindowOwned')) and actual['rawReadsAfter']==actual['rawReads'] and actual['sdkCallsAfter']==0
+    if args.case=='source-change':okay=okay and actual.get('actualWindowDescriptorOwned') is True and actual.get('oldBytesRetained') is True
+    if args.case=='credit-change':okay=okay and actual.get('actualWindowDescriptorOwned') is False
+    if not okay:raise RuntimeError('Finite file-original counter unresolved; originals retained')
+    print(json.dumps(dict(case=args.case,sourceStable=True,rawReads=actual['rawReads'],applicationReady=False)))
+
+
+if __name__=='__main__':main()
