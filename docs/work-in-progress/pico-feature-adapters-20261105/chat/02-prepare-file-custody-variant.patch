+"""PRIVATE exact proposed cold factory call, with actual fresh Parent ctor.
+
+No public Binding mutation is applied. This is the same constructor call the
+later optional Binding hunk would forward; there is no prepared-owner adoption.
+"""
+from adapters.native_feature_observation import need
+from adapters.pico4.chat_composition import PicoChatComposition
+from file_originals import ColdChatFileOriginals
+
