+"""PRIVATE explicit born Native source extension, still closed/no normal input.
+
+The old constructor model/defaults are frozen. This new class is selected at
+birth, before any app getter. Every source reply comes from its actual command.
+"""
+import json
+import time
+
+from adapters.native_feature_observation import need
+from cold_model import NativeModel
+from native_sources import PrepareSources
+
+KINDS = frozenset(('native','roots','scripts','profile','chat','view'))
+
+
+class PrepareNativeModel(NativeModel):
+    def __init__(self, root, digest, budget, run):
+        super().__init__(root, digest, budget)
+        self.sources = self.original_sources = PrepareSources(run, self.pid, self.bridge)
+        self.run = self.original_run = run
+
+    def current(self, kind):
+        self.guard()
+        need(self.sources is self.original_sources and self.run is self.original_run)
+        if kind in KINDS:
+            return self.sources.current(kind)
+        return super().current(kind)
+
+    def write_debug_app_file(self, target, package, path, raw):
+        need(target == self.target and package == 'org.overte.pico' and type(raw) is str)
+        self.guard()
+        request = json.loads(raw)
+        need(path == 'files/overte-e2e/android-control-command.json' and len(raw.encode('utf-8')) <= 4096
+             and self.sources is self.original_sources and self.run is self.original_run)
+        token = self.raw.archive.reserve('chat-prepare-control', request, 65536)
+        try:
+            self.guard()  # Actual original deadline after capacity/CAS.
+            if request.get('action') == 'normal-feature-observe':
+                need(set(request)=={'schemaVersion','commandId','action','includeAvatarEntities'}
+                     and type(request['schemaVersion']) is int and request['schemaVersion']==1
+                     and request['includeAvatarEntities'] is False)
+                self.sources.identity()
+                self.commands.append(request)
+                # Same actually configured model manager as the fresh V8
+                # snapshot; no empty-service-row shortcut for Chat guards.
+                self.diagnostic=dict(schemaVersion=1,requestId=request['commandId'],
+                    instance='f'*32,sampleSequence=len(self.commands),sampleEpochMs=time.time_ns()//1000000,
+                    complete=True,scripts=[dict(url=self.sources.physical,path=self.sources.physical)])
+            else:
+                self.sources.send(request)
+                self.commands.append(request)
+            self.raw.archive.retain(token, None)
+        except BaseException as error:
+            self.raw.fail(error)
+            raise
