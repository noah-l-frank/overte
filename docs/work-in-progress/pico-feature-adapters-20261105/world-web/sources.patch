+"""Source-pinned single approved private finite component. No retry."""
+import ast,hashlib,importlib,json,os,subprocess,sys,time,traceback
+from pathlib import Path
+BASE=Path('/home/user/.local/state/pico-world-web-unicode-audit-20261104-Y7hm6Y/resource1')
+REPO=Path('/home/user/Documents/github/overte-pico-consolidated-20261027')
+EXPECTED='a9c5f9449f9c0843973501b2e6d9543b1a97387d'
+sys.dont_write_bytecode=True
+sys.path.insert(0,str(REPO/'tests/device'))
+import adapters.pico4
+adapters.pico4.__path__.insert(0,str(BASE/'runtime/adapters/pico4'))
+sys.path.insert(0,str(BASE))
+from test_world_root_resource import normal_cold_parent_census
+from adapters.pico4.world_web_prefix import PicoWorldWebPrefix
+from adapters.pico4.world_web_binding import PicoWorldWebBinding
+from adapters.pico4.world_root_resource import WorldRootParticipant1
+
+def git(*args):return subprocess.check_output(['git',*args],cwd=REPO,text=True).strip()
+def stamp(path):
+    info=path.stat();raw=path.read_bytes();after=path.stat()
+    fields=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_uid,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
+    if fields(info)!=fields(after):raise RuntimeError('Source changed while pinning')
+    return {'sha256':hashlib.sha256(raw).hexdigest(),'stat8':fields(info)}
+def loaded():
+    paths=set()
+    for module in tuple(sys.modules.values()):
+        value=getattr(module,'__file__',None)
+        if value and value.endswith('.py') and Path(value).is_file():paths.add(str(Path(value).resolve()))
+    return paths
+
+def main():
+    if git('rev-parse','HEAD')!=EXPECTED or git('status','--porcelain'):raise RuntimeError('Actual source epoch differs')
+    origins=json.loads((BASE/'origins.json').read_text())
+    for rel,record in origins.items():
+        if stamp(REPO/rel)['sha256']!=record['beforeSha256']:raise RuntimeError('Afterimage base changed')
+        if stamp(Path(record['afterimage']))['sha256']!=record['afterSha256']:raise RuntimeError('Afterimage changed')
+    for cls,name in ((PicoWorldWebPrefix,'world_web_prefix.py'),(PicoWorldWebBinding,'world_web_binding.py'),(WorldRootParticipant1,'world_root_resource.py')):
+        code=cls.__init__.__code__;actual=Path(code.co_filename).resolve()
+        if actual!=BASE/'runtime/adapters/pico4'/name:raise RuntimeError('Cold source selection differs')
+    paths={p.resolve() for p in REPO.rglob('*.py') if '.git' not in p.parts}
+    paths.update(p.resolve() for p in BASE.rglob('*') if p.is_file() and p.suffix in ('.py','.md','.diff','.json') and 'results' not in p.parts)
+    paths.update(Path(p) for p in loaded())
+    # Original non-Python fixture code is also pinned BEFORE Parent reviewed().
+    resource_manifest=REPO/'tests/device/feature_journeys/resource-pins.v1.json'
+    paths.add(resource_manifest)
+    resource=json.loads(resource_manifest.read_text())['resources']['web-source/client.js']
+    paths.add((REPO/resource['source']).resolve())
+    before={str(p):stamp(p) for p in sorted(paths)};initial_loaded=loaded()
+    tag=time.strftime('%Y%m%dT%H%M%S');out=BASE/'results'/tag;out.mkdir(mode=0o700,parents=True)
+    (out/'source-before.json').write_text(json.dumps(before,indent=2)+'\n')
+    artifacts=out/'originals';artifacts.mkdir(mode=0o700)
+    started=time.perf_counter();proof=None;failure=None
+    try:proof=normal_cold_parent_census(artifacts)
+    except BaseException as error:
+        failure={'type':type(error).__name__,'message':str(error),'traceback':traceback.format_exc()}
+    elapsed=time.perf_counter()-started
+    after_loaded=loaded();late=after_loaded-initial_loaded
+    comparisons={path:stamp(Path(path))==value for path,value in before.items()}
+    unpinned_late=sorted(late-set(before))
+    stable=all(comparisons.values()) and not unpinned_late and git('rev-parse','HEAD')==EXPECTED and not git('status','--porcelain')
+    originals={str(p):stamp(p) for p in artifacts.rglob('*') if p.is_file()}
+    final={'case':'normal_cold_parent_census','green':failure is None and stable,'elapsed':elapsed,
+        'head':EXPECTED,'repoPythonSources':sum(str(REPO) in p and p.endswith('.py') for p in before),
+        'initialLoaded':len(initial_loaded),'lateLoadedCovered':len(late),'unpinnedLate':unpinned_late,
+        'allSourcesStable':stable,'changedSources':[p for p,ok in comparisons.items() if not ok],
+        'proof':proof,'failure':failure,'originals':originals,
+        'noSDKInput':True,'nativeDeviceQualified':False,'wholeClaim':False}
+    (out/'result.json').write_text(json.dumps(final,indent=2)+'\n')
+    (out/'source-after.json').write_text(json.dumps({p:stamp(Path(p)) for p in before},indent=2)+'\n')
+    print(json.dumps({'green':final['green'],'elapsed':elapsed,'output':str(out),'failure':failure,
+        'initialLoaded':len(initial_loaded),'lateLoaded':len(late),'allSourcesStable':stable,'proof':proof},indent=2))
+    return 0 if final['green'] else 1
+if __name__=='__main__':raise SystemExit(main())
