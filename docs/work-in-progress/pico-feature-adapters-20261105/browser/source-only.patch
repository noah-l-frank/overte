+"""PRIVATE bounded kernel publication counter; no code/method instrumentation."""
+import ctypes,errno,fcntl,os,struct
+from pathlib import Path
+
+class RootPublications:
+    MASK=0x00000040|0x00000080 # MOVED_FROM + MOVED_TO preserve unique source events.
+    def __init__(self,path):
+        self.path=Path(path);self.fd=self.anchor=-1;self.lost=False
+        libc=ctypes.CDLL(None,use_errno=True)
+        descriptor=libc.inotify_init1(os.O_NONBLOCK|os.O_CLOEXEC)
+        if descriptor<0:raise OSError(ctypes.get_errno(),'Private inotify unavailable')
+        self.fd=descriptor
+        try:
+            self.anchor=fcntl.fcntl(descriptor,fcntl.F_DUPFD_CLOEXEC,0)
+            self.node=(os.fstat(descriptor).st_dev,os.fstat(descriptor).st_ino);self.guard()
+            watch=libc.inotify_add_watch(descriptor,ctypes.c_char_p(os.fsencode(self.path.parent)),ctypes.c_uint32(self.MASK))
+            if watch<0:raise OSError(ctypes.get_errno(),'Private inotify watch refused')
+            self.watch=watch
+        except BaseException:
+            if self.anchor>=0:os.close(self.anchor)
+            os.close(descriptor);self.fd=self.anchor=-1;raise
+    def guard(self):
+        assert not self.lost and self.fd>=0 and self.anchor>=0 and self.fd!=self.anchor
+        current=os.fstat(self.fd)
+        assert (current.st_dev,current.st_ino)==self.node and fcntl.fcntl(self.fd,fcntl.F_DUPFD_QUERY,self.anchor)==1
+    def count(self):
+        sources=set();targets=set();events=0
+        while True:
+            self.guard()
+            try:raw=os.read(self.fd,8192)
+            except BlockingIOError:break
+            self.guard();assert raw
+            offset=0
+            while offset<len(raw):
+                watch,mask,cookie,size=struct.unpack_from('iIII',raw,offset);offset+=16
+                name=raw[offset:offset+size].split(b'\0',1)[0];offset+=size;events+=1
+                assert events<=4096 and watch==self.watch and mask in (0x40,0x80) and offset<=len(raw)
+                if mask==0x40 and name.startswith(os.fsencode(self.path.name+'.pending-')):sources.add(cookie)
+                if mask==0x80 and name==os.fsencode(self.path.name):targets.add(cookie)
+        assert sources==targets and 0 not in sources
+        return len(sources)
+    def close(self):
+        self.guard();os.close(self.fd);os.close(self.anchor);self.fd=self.anchor=-1
