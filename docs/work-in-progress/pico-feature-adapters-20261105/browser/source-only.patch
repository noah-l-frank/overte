+    def pico_peer_entry_same(self,left,right):
+        # Fixed admitted tablet-web scalar schema, not arbitrary JSON equality.
+        if type(left) is not dict or type(right) is not dict or left.keys()!=right.keys():return False
+        for key in ('ticket','actor','actorSequence','capturedEpochMs','sequence','receivedEpochMs'):
+            a,b=left[key],right[key]
+            if type(a) is not type(b) or a!=b:return False
+        a,b=left['facts'],right['facts']
+        if type(a) is not dict or type(b) is not dict or a.keys()!=b.keys():return False
+        for key in a:
+            if type(a[key]) is not type(b[key]) or a[key]!=b[key]:return False
+        return True
