+    def wait(self, label, ticket, barrier, expected, kinds, *, duration=0.5):
+        peer=self.pico_peer_policy()
+        graphs=None if peer is None else peer.fixed_current_graphs()
+        if graphs is not None:graphs.enter_wait(self)
+        try:
+            value=self._wait_body(label,ticket,barrier,expected,kinds,duration=duration)
+            if graphs is not None:graphs.leave_wait(self)
+            return value
+        except BaseException as error:
+            if graphs is not None:graphs.fail(error)
+            raise
