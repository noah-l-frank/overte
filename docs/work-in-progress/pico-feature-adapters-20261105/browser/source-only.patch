+    def pico_peer_after_primary(self,original,ticket,barrier,expected):
+        # Original preview constrains history at its ORIGINAL receipt. The one
+        # new GET has its own body/arrival; no pre-read timestamp is renewed.
+        peer=self.pico_peer_policy()
+        if peer is None or not peer.scope.refresh_after_primary:raise ValueError('Cold after-Primary peer policy is absent')
+        try:
+            preview,received,epoch,cursor=original
+            if cursor!=(self.witness_sequence,self.last_actor_sequence,self.last_actor_epoch):
+                raise ValueError('Independent journal cursor changed during product acquisition')
+            if peer.scope.defer_wire:peek,old,fresh=peer.read_after_primary_values(preview,ticket)
+            else:
+                peek=peer.read_after_primary(preview,ticket)
+                old=preview.original_value();fresh=peek.original_value()
+            preview_okay,_prior=self.observed_witness(ticket,barrier,expected,original=old,consume=False,receipt_epoch=epoch,pico_server_history=peer.scope.server_receipts)
+            # Already consumed history has no NEW contradiction. It remains an
+            # immutable prefix constraint, never a current candidate.
+            preview_okay=preview_okay or _prior is None
+            prior=old['entries'];rows=fresh['entries'];new=[];position=0;last=0
+            cutoff=prior[-1]['sequence'] if prior else 0
+            first=rows[0]['sequence'] if rows else None
+            for row in rows:
+                sequence=row['sequence']
+                if type(sequence) is not int or sequence<=last:raise ValueError('Independent peek history order changed')
+                last=sequence
+                while position<len(prior) and prior[position]['sequence']<sequence:
+                    # Only the original server's full512-entry suffix can evict an
+                    # older prefix; all evicted originals remain validated/held.
+                    if len(rows)!=512 or prior[position]['sequence']>=first:
+                        raise ValueError('Independent peek discarded retained history')
+                    position+=1
+                if position<len(prior) and prior[position]['sequence']==sequence:
+                    if not self.pico_peer_entry_same(prior[position],row):
+                        raise ValueError('Independent peek changed an original history row')
+                    position+=1
+                elif sequence<=cutoff:raise ValueError('Independent peek inserted unknown old history')
+                else:new.append(row)
+            if position!=len(prior):raise ValueError('Independent peek lost retained history')
+            # Prevalidate the genuine new suffix against the previous preview's
+            # actual Actor order without modifying the real cursor yet.
+            previous_actor=self.last_actor_sequence;previous_epoch=self.last_actor_epoch;previous_received=None
+            for row in prior:
+                if row['ticket']==ticket and row['capturedEpochMs']>=barrier:
+                    previous_received=row['receivedEpochMs']
+                    if row['sequence']>self.witness_sequence:
+                        previous_actor=row['actorSequence'];previous_epoch=row['capturedEpochMs']
+            for row in new:
+                if row['ticket']==ticket and row['capturedEpochMs']>=barrier:
+                    if (row['actorSequence']<=previous_actor or row['capturedEpochMs']<previous_epoch
+                            or peer.scope.server_receipts and previous_received is not None and row['receivedEpochMs']<previous_received):
+                        raise ValueError('Independent peek source history regressed')
+                    previous_actor=row['actorSequence'];previous_epoch=row['capturedEpochMs'];previous_received=row['receivedEpochMs']
+            view=dict(fresh,entries=new)
+            new_okay,witness=self.observed_witness(ticket,barrier,expected,original=view,consume=False,receipt_epoch=peek.receipt[1],pico_server_history=peer.scope.server_receipts)
+            # Commit only after both full original constraints/prefix and the new
+            # suffix passed; contradictions still reject this acquired pair.
+            self.observed_witness(ticket,barrier,expected,original=old,receipt_epoch=epoch,pico_server_history=peer.scope.server_receipts)
+            self.observed_witness(ticket,barrier,expected,original=view,receipt_epoch=peek.receipt[1],pico_server_history=peer.scope.server_receipts)
+            return preview_okay and new_okay,witness,(peek,peek.receipt[0],peek.receipt[1],cursor)
+        except BaseException as error:peer.fail(error);raise
