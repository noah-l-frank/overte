+class FooterCost(AfterPrimary):
+    def test_actual_parent_guard_root_read_and_exact_previous_byte_cost(self):
+        root,archive,peer,server,ticket,run=self.fixture()
+        for number in range(83):archive.put('synthetic-metadata-'+str(number)+'.bin',b'metadata-only-'+str(number).encode())
