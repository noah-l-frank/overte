+            self.writes.append((name,payload));return b''
+        assert command[0]=='exec-out' and not payload
+        expected=f"file='{REMOTE_DIRECTORY}/status.json'; "+'[ -f "$file" ] && [ ! -L "$file" ] && cat "$file"'
+        assert script==expected and self.status is not None
+        assert not self.lose_status
