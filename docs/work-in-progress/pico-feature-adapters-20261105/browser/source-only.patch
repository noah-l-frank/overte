+        self.status=dict(schemaVersion=1,buildMarker=BUILD_MARKER,consumer=CONSUMER,profileId=PROFILE_ID,
+            bindingProfileSha256=PROFILE_SHA256,enabled=True,acceptedSequence=sequence,acceptedNonce=grant['sessionNonce'],
+            activeCommandId=command['id'],state='active',detail='declared-model-only',updatedEpochMs=int(time.time()*1000),
+            viewAppliedSequence=0,viewAppliedYawDegrees=0,viewAppliedPitchDegrees=0,vectorAppliedSequence=0,
+            leftThumbstickAppliedX=0,leftThumbstickAppliedY=0,booleanAppliedSequence=sequence,leftSecondaryApplied=True,rightSecondaryApplied=False)
