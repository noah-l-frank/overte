+    def atomic_script(self,name,count):
+        return ('umask 077; '+f"directory='{REMOTE_DIRECTORY}'; "+f'expected={count}; '+
+            'mkdir -p "$directory" && chmod 700 "$directory" || exit 20; '+
+            f'temporary="$directory/{name}.tmp"; '+f'destination="$directory/{name}"; '+
+            'rm -f "$temporary"; '+'dd bs=1 count="$expected" of="$temporary" 2>/dev/null '+
+            '&& actual=$(wc -c < "$temporary") && [ "$actual" -eq "$expected" ] '+
+            '&& chmod 600 "$temporary" && mv -f "$temporary" "$destination"')
+    def commit(self,grant):
+        assert self.commands is not None and type(grant) is dict
+        assert set(grant)=={'schemaVersion','buildMarker','testBuild','runtimeOptIn','channel','consumer','bindingProfileSha256','sessionNonce','sequence','expiresEpochMs'}
+        assert grant['schemaVersion']==1 and grant['buildMarker']==BUILD_MARKER and grant['testBuild'] is True and grant['runtimeOptIn'] is True
+        assert grant['channel']==CHANNEL and grant['consumer']==CONSUMER and grant['bindingProfileSha256']==PROFILE_SHA256
+        assert grant['sessionNonce']==self.commands['sessionNonce'] and grant['sequence']==self.commands['sequence']
+        assert type(grant['expiresEpochMs']) is int and time.time()*1000<grant['expiresEpochMs']
