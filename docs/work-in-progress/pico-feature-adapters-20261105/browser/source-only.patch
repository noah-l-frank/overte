+    def capture_video(self, target: str, duration_seconds: float) -> dict:
+        seconds = int(math.ceil(duration_seconds))
+        remote = "/data/local/tmp/overte-e2e-screen.mp4"
+        self.adb.shell(target, "rm", "-f", remote, check=False)
+        try:
+            self.adb.shell(
