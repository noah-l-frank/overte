+"""Private real-kernel boundary investigation; no source/product qualification."""
+import fcntl,os,stat,tempfile,unittest
+from pathlib import Path
+from adapters.native_fd_owner import OriginalDescriptor,require_directory
+from adapters.chat_journey.archive_file import signature
+
+class AppendPolicy:
+    def __init__(self,path):
+        self.path=path;self.owner=OriginalDescriptor(path,os.O_RDWR|os.O_APPEND|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW|os.O_CLOEXEC)
+        os.fchmod(self.owner.fd,0o400);self.flags=fcntl.fcntl(self.owner.fd,fcntl.F_GETFL)
+        self.raw=b'';self.physical=signature(os.fstat(self.owner.fd));self.failed=False
+    def guard(self):
+        try:
+            assert not self.failed
+            self.owner.require(self.owner.fd)
+            assert fcntl.fcntl(self.owner.fd,fcntl.F_GETFL)==self.flags
+            assert self.flags & os.O_APPEND and self.flags & os.O_ACCMODE==os.O_RDWR
+            assert os.pread(self.owner.fd,65537,0)==self.raw
+            assert signature(os.fstat(self.owner.fd))==signature(self.path.lstat())==self.physical
+            assert stat.S_IMODE(os.fstat(self.owner.fd).st_mode)==0o400
+            self.owner.require(self.owner.fd)
+        except BaseException:self.failed=True;raise
+    def append(self,raw,*,positional=False):
+        self.guard();old=self.raw
+        written=os.pwrite(self.owner.fd,raw,0) if positional else os.write(self.owner.fd,raw)
+        assert written==len(raw);os.fsync(self.owner.fd)
+        actual=os.pread(self.owner.fd,65537,0);assert actual==old+raw
+        self.raw=actual;self.physical=signature(os.fstat(self.owner.fd));self.guard()
+
+class KernelAppendTests(unittest.TestCase):
+    def setUp(self):
+        tmp=tempfile.TemporaryDirectory(prefix='browser-kernel-append-');self.addCleanup(tmp.cleanup)
+        self.root=Path(tmp.name);self.root.chmod(0o700);self.writer=AppendPolicy(self.root/'original.bin')
+        self.addCleanup(self.close_owned)
+    def close_owned(self):
+        owner=self.writer.owner
+        if not owner.lost:assert owner.close()
+    def test_actual_linux_pwrite_appends_and_past_extent_bytes_remain_original(self):
+        w=self.writer;w.append(b'original prefix');old=list(w.physical);w.append(b' plus suffix',positional=True)
+        self.assertEqual(b'original prefix plus suffix',os.pread(w.owner.fd,65536,0))
+        self.assertNotEqual(old,w.physical);self.assertEqual(b'original prefix',os.pread(w.owner.fd,15,0))
+        with self.assertRaises(PermissionError):os.open(w.path,os.O_WRONLY)
+    def test_flag_removal_is_detected_even_without_an_inode_stat_change_and_is_sticky(self):
+        w=self.writer;w.append(b'original');old=list(w.physical)
+        fcntl.fcntl(w.owner.fd,fcntl.F_SETFL,w.flags & ~os.O_APPEND)
+        self.assertEqual(old,signature(w.path.lstat()))
+        with self.assertRaises(AssertionError):w.guard()
+        fcntl.fcntl(w.owner.fd,fcntl.F_SETFL,w.flags)
+        with self.assertRaises(AssertionError):w.guard()
+    def test_actual_truncation_cannot_be_hidden_by_retaining_append_flags(self):
+        w=self.writer;w.append(b'original prefix');os.ftruncate(w.owner.fd,3)
+        self.assertEqual(w.flags,fcntl.fcntl(w.owner.fd,fcntl.F_GETFL))
+        with self.assertRaises(AssertionError):w.guard()
+        self.assertEqual(b'ori',os.pread(w.owner.fd,65536,0))
+    def test_actual_foreign_prefix_write_cannot_hide_after_permission_restoration(self):
+        w=self.writer;w.append(b'original prefix');os.chmod(w.path,0o600)
+        foreign=os.open(w.path,os.O_WRONLY|os.O_CLOEXEC)
+        try:os.pwrite(foreign,b'X',0);os.fsync(foreign)
+        finally:os.close(foreign)
+        os.chmod(w.path,0o400)
+        with self.assertRaises(AssertionError):w.guard()
+        self.assertEqual(b'Xriginal prefix',os.pread(w.owner.fd,65536,0))
+    def test_same_inode_independent_ofd_recycle_is_not_adopted_or_closed(self):
+        w=self.writer;w.append(b'original');foreign=os.open(w.path,os.O_RDONLY|os.O_CLOEXEC)
+        fd,anchor=w.owner.fd,w.owner.anchor
+        try:
+            os.dup2(foreign,fd)
+            with self.assertRaises(Exception):w.guard()
+            self.assertTrue(w.owner.lost);self.assertFalse(w.owner.close());os.fstat(fd)
+            self.assertEqual(b'original',os.pread(foreign,65536,0))
+        finally:
+            # These are only independently created descriptors owned by this
+            # test, closed outside the refusing component after its assertions.
+            os.close(foreign);os.close(fd);os.close(anchor)
