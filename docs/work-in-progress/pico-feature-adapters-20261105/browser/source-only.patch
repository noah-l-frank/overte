+from adapters.pico4.operation_protocol import need,BYTE_LIMIT,FILE_LIMIT
+from adapters.json_original_value import container_dimensions
+from peer_predecoder import canonical_size,raw_counts
+
+def current_plan(peer):
+    need(type(peer) is ParentPeerCredits);archive=peer.archive;archive.guard()
+    need(peer.active is None and peer.pending_header is None and peer.wire_pending is None
+        and type(peer.root_meta_totals) is tuple and peer.root_meta_totals is peer._root_meta_totals
+        and len(peer.root_meta_totals)==4 and all(type(x) is int and x>=0 for x in peer.root_meta_totals)
+        and type(peer.header) is dict and len(peer.header)<=64 and type(archive.journal.raw) is bytes
+        and 0<len(archive.journal.raw)<=65536 and archive.state is peer.root_state
+        and archive.state['parentPeerDecoded'] is peer.header is peer.root_header)
+    # Add proposed fixed counter fields as ordinary exact integers only. This
+    # is a NEW diagnostic dict under the cold allowance, not an adopted Root.
+    proposed=dict(peer.header,rootMetaIssuedBytes=peer.root_meta_totals[1],rootMetaRetainedBytes=0,
+        rootMetaRetiredBytes=0,rootMetaBookCount=peer.root_meta_totals[0])
+    plan=container_dimensions(proposed,max_nodes=65536,max_depth=8);need(plan is not None)
+    size,_=canonical_size(proposed)
+    # 64 extra ASCII digits conservatively cover the eventual four counter
+    # updates in this finite diagnostic. No release policy relies on it yet.
+    candidate=4*(size+64)+256*plan[0]+plan[3]
+    root_parse=raw_counts(archive.journal.raw)['decoderUpper']
+    root_extra=candidate+plan[4]+root_parse
+    files=archive.names();used=sum((archive.path/name).stat().st_size for name in files)
+    peak=used+FORWARD_BYTES+peer.effective_charge()+root_extra
+    return dict(actualHeld=peer.held,physicalFiles=len(files),physicalBytes=used,forwardBytes=FORWARD_BYTES,
+        issuedRootMetadata=peer.root_meta_totals[1],newCandidateRetained=candidate,newCandidateSealPeak=plan[4],
+        actualOldRootParserUpper=root_parse,additionalRootOverlap=root_extra,actualProspectivePeak=peak,
+        originalByteLimit=BYTE_LIMIT,wouldAdmit=peak<=BYTE_LIMIT and len(files)+FORWARD_FILES<=FILE_LIMIT,
