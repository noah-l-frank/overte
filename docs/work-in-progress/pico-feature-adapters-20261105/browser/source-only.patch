+"""PRIVATE one actual journal publication inside an original source lock."""
+import hashlib,json,os,select,sys,threading,time
+from copy import deepcopy
+from pathlib import Path
+from adapters.normal_feature_state import PrivateFeatureState
+from adapters.script_journey.lock import ScriptSourceLock
+from feature_journeys.scenarios import SCENARIOS
+from feature_journeys.witness import Client,projection
+
+def pin(path):
+    info=path.lstat()
+    return dict(sha256=hashlib.sha256(path.read_bytes()).hexdigest(),physical=[info.st_dev,info.st_ino,info.st_mode,info.st_uid,info.st_nlink,info.st_size,info.st_mtime_ns,info.st_ctime_ns])
+
+def main():
+    config=PrivateFeatureState(Path(sys.argv[1])).read();manifest=Path(sys.argv[2])
+    lock=ScriptSourceLock(config['lockPath']);client=Client(config['url'],config['actorToken'])
+    with lock.held():
+        lock.assert_held();descriptor=lock._owner[1];info=os.fstat(descriptor)
+        facts=projection('tablet-web',deepcopy(SCENARIOS['tablet-web']['baseline']))
+        ack=client.request('/runs/'+config['run']+'/samples',dict(ticket=config['ticket'],actor='owned-observer',
+            actorSequence=1,capturedEpochMs=int(time.time()*1000),facts=facts))
+        if ack!={}:raise ValueError('Original publication acknowledgment is invalid')
+        print(json.dumps(dict(phase='published-inside-lock',node=[info.st_dev,info.st_ino],pid=os.getpid(),thread=threading.get_ident())),flush=True)
+        if not select.select([sys.stdin.buffer],[],[],5)[0]:raise ValueError('Finite source lock control timed out')
+        control=sys.stdin.buffer.readline(17)
+        if control not in (b'release\n',b'publish-release\n'):raise ValueError('Invalid finite source lock control')
+        if control==b'publish-release\n':
+            ack=client.request('/runs/'+config['run']+'/samples',dict(ticket=config['ticket'],actor='owned-observer',
+                actorSequence=2,capturedEpochMs=int(time.time()*1000),facts=facts))
+            if ack!={}:raise ValueError('Second original publication acknowledgment is invalid')
+        lock.assert_held()
+    loaded={}
+    for module in tuple(sys.modules.values()):
+        filename=getattr(module,'__file__',None)
+        if filename:
+            path=Path(filename).resolve()
+            if path.suffix=='.py' and ('overte-pico-consolidated-20261027' in path.parts or path.is_relative_to(Path(__file__).resolve().parent.parent)):
+                loaded[str(path)]=pin(path)
+    manifest.write_text(json.dumps(loaded,sort_keys=True))
+    print(json.dumps(dict(phase='released',pid=os.getpid())),flush=True)
+
+if __name__=='__main__':main()
