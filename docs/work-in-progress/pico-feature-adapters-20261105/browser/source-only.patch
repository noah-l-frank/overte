+"""PRIVATE cold local archive cost; no Source/Native/CLI qualification."""
+import json,tempfile,time,unittest
+from pathlib import Path
+from adapters.pico4.operation_archive import OperationArchive
+from operation_raw_banks import CoupledOperationBanks
+
+class ColdPackingCost(unittest.TestCase):
+    def test_actual_new_local_32_transaction_archives_preserve_originals(self):
+        temporary=tempfile.TemporaryDirectory(prefix='browser-cold-packing-cost-');self.addCleanup(temporary.cleanup)
+        root=Path(temporary.name);root.chmod(0o700)
+        data={};self.owners=[]
+        def close():
+            for kind,owner in self.owners:
+                if kind=='packed':self.assertTrue(owner.close_known())
+                else:owner.close()
+        self.addCleanup(close)
+        scope=dict(privateColdCost=True)
+        zero=lambda:dict(parts=0,files=0,storedBytes=0,decodedBytes=0)
+        for kind in ('legacy','packed'):
+            path=root/kind;path.mkdir(mode=0o700)
+            owner=(OperationArchive(path,scope) if kind=='legacy' else CoupledOperationBanks(path,scope,lambda:True,zero,time.monotonic))
+            self.owners.append((kind,owner));times=[];originals=[]
+            for ordinal in range(32):
+                started=time.monotonic()
+                command=dict(requestId=format(ordinal+1,'032x'),operation='app.process')
+                request=json.dumps(command,sort_keys=True,separators=(',',':')).encode()+b'\n'
+                response=json.dumps(dict(running=True,identity='31:456',ordinal=ordinal),sort_keys=True,separators=(',',':')).encode()+b'\n'
+                if kind=='legacy':
+                    owner.reserve(command);a=owner.put('request-%03d.bin'%ordinal,request);b=owner.put('response-%03d.bin'%ordinal,response)
+                    owner.finish(dict(picoOperationReceiptVersion=1,request=a,response=[b],stderr=[]))
+                    originals.append((a,b))
+                else:
+                    owner.begin(command);owner.append('request',request);a=owner.finish_channel('request')
+                    owner.append('response',response);b=owner.finish_channel('response');c=owner.finish_channel('stderr')
+                    owner.finish(dict(picoOperationReceiptVersion=2,request=a,response=b,stderr=c))
+                    originals.append((a,b))
+                times.append(time.monotonic()-started)
+            if kind=='packed':
+                first=owner.banks['response'].literal(originals[0][1]['reference'])
+                owner.seal();owner.guard()
+            else:
+                first=owner.rows[originals[0][1]['name']].read()[0];owner.guard()
+            self.assertEqual(0,json.loads(first)['ordinal'])
+            data[kind]=dict(seconds=times,totalSeconds=sum(times),files=len(list(path.iterdir())),
+                storedBytes=sum(f.stat().st_size for f in path.iterdir()))
+        data.update(actualNewLocalArchives=True,transactionsPerArchive=32,nativeDispatches=0,
+            wholeFitQualified=False,sourceQualified=False)
+        (root/'cost-result.json').write_text(json.dumps(data,indent=2))
+        print(json.dumps(dict(coldPackingResult=str(root/'cost-result.json'),
+            legacySeconds=data['legacy']['totalSeconds'],packedSeconds=data['packed']['totalSeconds'])),flush=True)
