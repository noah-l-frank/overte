+    def wait_for_text(self, predicate: Callable[[dict], bool], description: str) -> dict:
+        deadline = time.monotonic() + self.timeout_seconds
+        last = None
+        while time.monotonic() < deadline:
+            last = self.text_snapshot()
+            if predicate(last):
+                return last
+            time.sleep(self.poll_seconds)
