+"""PRIVATE full original OperationArchive bill, no public transport change."""
+import os,stat
+from pathlib import Path
+from adapters.native_feature_observation import need
+from adapters.native_fd_owner import OriginalDescriptor,require_directory
+from adapters.pico4.operation_archive import OperationArchive
+from adapters.pico4.operation_protocol import RESPONSE_LIMIT,REQUEST_LIMIT,STDERR_LIMIT
+from adapters.script_journey.history import canonical
+
+FORWARD_BYTES=RESPONSE_LIMIT+REQUEST_LIMIT+STDERR_LIMIT+2*65536
+FORWARD_FILES=64+1+1+1+1
+
+class ArchiveNamespaceBill:
+    def __init__(self,archive,peer_directory,inputs):
+        need(type(archive) is OperationArchive and type(inputs) is tuple)
+        self.archive=self._archive=archive
+        self.root=archive.state;self.pending=self.root['pending'];need(type(self.pending) is dict)
+        self.peer_directory=Path(peer_directory)
+        self.directory=OriginalDescriptor(self.peer_directory,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC)
+        require_directory(self.directory,self.peer_directory)
+        self.inputs=self._inputs=inputs
+        self.last=None;self.snapshot()
+    def snapshot(self):
+        need(self.archive is self._archive and self.inputs is self._inputs)
+        archive=self.archive;archive.guard()
+        need(archive.state is self.root and archive.state['pending'] is self.pending)
+        need(archive.journal.raw==canonical(archive.state)+b'\n')
+        require_directory(self.directory,self.peer_directory)
+        archive_names=archive.names();physical_files=len(archive_names)
+        used=sum((archive.path/name).stat().st_size for name in archive_names)
+        for path in self.inputs:
+            info=Path(path).lstat();need(stat.S_ISREG(info.st_mode) and info.st_nlink==1 and info.st_uid==os.geteuid())
+            physical_files+=1;used+=info.st_size
+        for path in self.peer_directory.iterdir():
+            need(path.name=='decoder-root.json')
+            info=path.lstat();need(stat.S_ISREG(info.st_mode) and info.st_nlink==1 and info.st_uid==os.geteuid())
+            physical_files+=1;used+=info.st_size
+        # PeerPredecoder.base already keeps this exact original forward byte
+        # allowance. Return actual disk bytes here, without charging it twice.
+        # Its source/root/helper allowances remain additive in that same SUM.
+        self.last=dict(files=physical_files+FORWARD_FILES,decodedBytes=used,
+            physicalFiles=physical_files,pendingFiles=FORWARD_FILES,pendingBytes=FORWARD_BYTES,
+            pendingRequestId=self.pending['requestId'])
+        return self.last
+    def close_known(self):return self.directory.close()
