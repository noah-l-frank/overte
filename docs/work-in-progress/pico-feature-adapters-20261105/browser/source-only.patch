+    def poll_independent_witness(self,deadline,ticket,barrier,expected):
+        # Await an actual NEW peer original BEFORE acquiring another Primary
+        # original. Select any valid new publication, including contradictions;
+        # no requested fact is a readiness predicate or sent to the producer.
+        peer=self.pico_peer_policy()
+        if peer is not None and peer.scope.refresh_after_primary:
+            if self.now()>=deadline:raise AssertionError('Independent journal exceeded original checkpoint deadline')
+            record=peer.historical_preview(ticket);original=record.original_value()
+            self.observed_witness(ticket,barrier,expected,original=original,consume=False,receipt_epoch=record.receipt[1],pico_server_history=peer.scope.server_receipts)
+            cursor=(self.witness_sequence,self.last_actor_sequence,self.last_actor_epoch)
+            return record,record.receipt[0],record.receipt[1],cursor
+        while True:
+            if self.now()>=deadline:raise AssertionError('Independent journal exceeded original checkpoint deadline')
+            peer=self.pico_peer_policy()
+            record=None
+            if peer is None:
+                original=self.witness()
+                received=self.now();epoch_at_receipt=number(self.epoch_ms(),1)
+            else:
