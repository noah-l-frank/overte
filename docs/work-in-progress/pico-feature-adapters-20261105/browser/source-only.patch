+"""PRIVATE immutable originals with lifetime-held original OFD/anchor.
+EVERY read still acquires full current bytes, fullstat8/path/parent, original
+kernel OFD proof before/after. No current-source verdict is cached.
+"""
+import os,stat
+from adapters.native_fd_owner import OriginalDescriptor
+from adapters.native_feature_observation import need
+from adapters.chat_journey.archive_file import signature
+
+class RetainedOriginal:
+    __slots__=('path','mode','parent_guard','raw','stamp','owner','_owner','birth','failed','first_failure','closed','unconfirmed')
+    def __init__(self,path,mode,parent_guard):
+        need(type(mode) is int and mode==0o400 and callable(parent_guard))
+        self.path,self.mode,self.parent_guard=path,mode,parent_guard
+        self.raw=self.stamp=self.birth=self.unconfirmed=None;self.failed=self.closed=False;self.first_failure=None
+        self.owner=self._owner=object.__new__(OriginalDescriptor)
+        try:
+            self.parent_guard()
+            OriginalDescriptor.__init__(self.owner,path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK|os.O_CLOEXEC)
+            raw,original=self._read_current()
+            self.raw,self.stamp=raw,original
+            self.birth=(self.path,self.mode,self.parent_guard,self.owner,self.raw,self.stamp)
+            self.unconfirmed=None
+        except BaseException as error:self._fail(error);raise
+    def _fail(self,error):
+        self.failed=True
+        if self.first_failure is None:self.first_failure=(error,error.__traceback__)
+    def _guard_fields(self):
+        need(type(self) is RetainedOriginal and not self.failed and not self.closed
+            and type(self.owner) is OriginalDescriptor and self.owner is self._owner
+            and type(self.birth) is tuple and len(self.birth)==6
+            and self.path is self.birth[0] and self.mode is self.birth[1] and self.parent_guard is self.birth[2]
+            and self.owner is self.birth[3] and self.raw is self.birth[4] and self.stamp is self.birth[5])
+    def _read_current(self):
+        self.parent_guard();owner=self.owner;owner.require(owner.fd);info=os.fstat(owner.fd)
+        need(stat.S_ISREG(info.st_mode) and info.st_uid==os.geteuid() and stat.S_IMODE(info.st_mode)==self.mode
+            and info.st_nlink==1 and 0<info.st_size<=65536)
+        raw=os.pread(owner.fd,65537,0);self.unconfirmed=raw;original=signature(info)
+        need(len(raw)==info.st_size and signature(self.path.lstat())==signature(os.fstat(owner.fd))==original)
+        self.parent_guard();owner.require(owner.fd)
+        need(signature(self.path.lstat())==signature(os.fstat(owner.fd))==original)
+        return raw,original
+    def read(self):
+        try:
+            self._guard_fields();raw,original=self._read_current()
+            need(original==self.stamp and raw==self.raw)
+            self.unconfirmed=None;return raw,original
+        except BaseException as error:
+            self._fail(error)
+            # Keep original/uncertain handles and actual returned bytes; never
+            # adopt after birth loss or close a recycled half.
+            raise
+    def close(self):
+        if self.closed:return True
+        if self.failed:return False
+        try:self.read()
+        except BaseException:return False
+        if not self.owner.close():return False
+        self.closed=True;return True
