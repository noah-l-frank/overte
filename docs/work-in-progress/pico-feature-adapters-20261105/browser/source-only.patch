+            if self.now()>=deadline:raise AssertionError('Independent journal exceeded original checkpoint deadline')
+            record=peer.historical_preview(ticket);original=record.original_value()
+            self.observed_witness(ticket,barrier,expected,original=original,consume=False,receipt_epoch=record.receipt[1],pico_server_history=peer.scope.server_receipts)
