+"""PRIVATE finite retained-prefix counter, never a public history policy."""
+import os,stat
+from pathlib import Path
+from adapters.native_feature_observation import need
+from adapters.native_fd_owner import OriginalDescriptor,require_directory
+from adapters.script_journey.history import canonical
+from feature_journeys.contract import json_document,exact
+
+class PairBill:
+    """Keep the first complete granted SUM when admitting the second reader."""
+    def __init__(self,original,other_directory,prior=None,*,extras=(),optional=()):
+        self.original=original;self.other=Path(other_directory);self.prior=prior
+        self.extras=extras;self.optional=optional
+        self.directory=OriginalDescriptor(self.other,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC)
+    def snapshot(self):
+        if self.prior is not None:self.prior.guard()
+        value=dict(self.original.snapshot());require_directory(self.directory,self.other)
+        for path in self.extras:
+            if not path.exists():
+                need(path in self.optional);value['files']+=1;continue
+            info=path.lstat();need(stat.S_ISREG(info.st_mode) and info.st_nlink==1 and info.st_uid==os.geteuid() and stat.S_IMODE(info.st_mode)==0o600)
+            value['files']+=1;value['decodedBytes']+=info.st_size
+        for path in self.other.iterdir():
+            need(path.name=='decoder-root.json');info=path.lstat()
+            need(stat.S_ISREG(info.st_mode) and info.st_nlink==1 and info.st_uid==os.geteuid() and stat.S_IMODE(info.st_mode)==0o600)
+            value['files']+=1;value['decodedBytes']+=info.st_size
+        if self.prior is not None:value['decodedBytes']+=self.prior.held
+        return value
+    def close_known(self):return self.directory.close()
+
+def fixed_pair(journey,ticket,barrier,expected,preview_raw,preview_receipt,peek_raw,peek_receipt):
+    """Finite two-packet counter: preserve all retained prefix references.
+
+    This deliberately is not a public replacement for observed_witness. It
+    handles the small retained-prefix fixtures only, has no rollover policy,
+    never commits a cursor and never grants current product permission.
+    """
+    before=(journey.witness_sequence,journey.last_actor_sequence,journey.last_actor_epoch)
+    preview=json_document(preview_raw);peek=json_document(peek_raw)
+    journey.observed_witness(ticket,barrier,expected,original=preview,consume=False,receipt_epoch=preview_receipt)
+    old={entry['sequence']:entry for entry in preview['entries']}
+    need(len(old)==len(preview['entries']))
+    exact(peek,{'schemaVersion','runId','area','ticket','sampleEpochMs','entries'},'independent journal')
+    need(type(peek['entries']) is list and len(peek['entries'])<=512)
+    known=set();new=[];last=0;cutoff=max(old,default=0)
+    for entry in peek['entries']:
+        exact(entry,{'ticket','actor','actorSequence','capturedEpochMs','facts','sequence','receivedEpochMs'},'independent raw observation')
+        sequence=entry['sequence'];need(type(sequence) is int and sequence>last);last=sequence
+        if sequence in old:
+            need(canonical(entry)==canonical(old[sequence]));known.add(sequence)
+        else:
+            need(sequence>cutoff);new.append(entry)
+    # Explicitly limited to this finite retained-prefix counter. A full
+    # 512-entry rollover requires a separately reviewed history policy.
+    need(known==set(old))
+    if new:
+        eligible=[entry for entry in preview['entries'] if entry['sequence']>journey.witness_sequence
+            and entry['ticket']==ticket and entry['capturedEpochMs']>=barrier]
+        if eligible:
+            need(new[0]['actorSequence']>eligible[-1]['actorSequence']
+                and new[0]['capturedEpochMs']>=eligible[-1]['capturedEpochMs'])
+        view=dict(peek,entries=new)
+        journey.observed_witness(ticket,barrier,expected,original=view,consume=False,receipt_epoch=peek_receipt)
+        selected=new[-1];receipt=peek_receipt;source='peek'
+    else:
+        need(bool(preview['entries']));selected=preview['entries'][-1];receipt=preview_receipt;source='preview'
+        # Validate the actual current snapshot metadata without making old
+        # history first-seen at the later receipt.
+        journey.observed_witness(ticket,barrier,expected,original=dict(peek,entries=[]),consume=False,receipt_epoch=peek_receipt)
+    need(before==(journey.witness_sequence,journey.last_actor_sequence,journey.last_actor_epoch))
+    # Scalar-only descriptive handback, not a current/freshness verdict.
+    return source,selected['sequence'],selected['capturedEpochMs'],receipt,preview_receipt,peek_receipt
