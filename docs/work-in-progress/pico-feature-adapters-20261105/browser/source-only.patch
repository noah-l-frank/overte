+    def observed_witness(self, ticket, barrier, expected, *, original=None, consume=True, receipt_epoch=None,pico_server_history=False):
+        if type(consume) is not bool or type(pico_server_history) is not bool:raise ValueError('Invalid independent journal cursor policy')
+        if pico_server_history:
+            peer=self.pico_peer_policy()
+            if peer is None or not peer.scope.server_receipts or original is None:
