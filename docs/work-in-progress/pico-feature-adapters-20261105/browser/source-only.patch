+#!/usr/bin/env python3
+"""Execute one common feature extension through the existing OverteSession seam."""
+# Copyright 2026 Overte contributors.
+# SPDX-License-Identifier: Apache-2.0
+import argparse
+import json
+import os
+from pathlib import Path
+import sys
+import time
+import uuid
+from feature_journeys.engine import Journey
+from feature_journeys.evidence import read_private_artifact
+from feature_journeys.scenarios import SCENARIOS
+from feature_journeys.session import prepare
+from feature_journeys.witness import Client
+from module_support import (ARTIFACT_DIR, AssertionFailure, InfrastructureError,
+    assert_foreground, assert_process, module_main, process_identity, write_json)
+from overte_session import OverteSession
+
+
+def main():
+    whole_started=time.monotonic()
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--area', choices=sorted(SCENARIOS), required=True)
+    args = parser.parse_args()
+    policy = json.loads(Path(os.environ['OVERTE_E2E_FEATURE_IMAGE_POLICY']).read_text())[args.area]
+    fixture_options={}
+    if args.area=='graphics' and type(policy) is dict and type(policy.get('screen')) is dict and 'profile' in policy['screen']:
+        from feature_journeys.stereo_graphics_evidence import policy as stereo_policy,SURFACE_PROFILE
+        from feature_journeys.graphics_fixture import PICO_PROFILE
+        stereo_policy(policy['screen'])
+        if policy['screen']==SURFACE_PROFILE:fixture_options['graphics_profile']=PICO_PROFILE
+    client = Client(os.environ.get('OVERTE_E2E_FEATURE_FIXTURE_URL', ''),
+                    os.environ.get('OVERTE_E2E_FEATURE_READER_TOKEN', ''))
+    run, url = client.register(args.area,**fixture_options)
+    session = OverteSession()
+    identity = old_identity = None
+    browser=None
+    try:
+        def continuity(phase, verb):
+            nonlocal identity, old_identity
+            if browser is not None and browser.operation_version==3:
+                if phase=='after' and verb=='restart-app':
+                    raise AssertionFailure('Fixed tablet browser continuity does not register application restart')
+                value=browser.continuity(phase)
+                # Compare each fresh original record immediately and in the
+                # unchanged original order. No result becomes later permission.
+                for index,record in enumerate(value['records']):
+                    observed=record['result']
+                    if record['operation']=='app.process':
+                        label='before normal feature input' if phase=='before' and index==0 else 'normal feature observation'
+                        if observed.get('running') is not True:raise AssertionFailure(f'{label}: application process exited')
+                        if observed.get('identity')!=identity:raise AssertionFailure(f'{label}: application process restarted')
+                        if phase=='before' and index==0:old_identity=identity
+                    elif observed.get('foreground') is not True:
+                        raise AssertionFailure('normal feature observation: application is not foregrounded')
+                if not value['complete']:raise AssertionFailure('Original fixed browser continuity answer is incomplete')
+                return
+            if phase == 'before':
+                assert_process(identity, 'before normal feature input')
+                old_identity = identity
+            if phase == 'after' and verb == 'restart-app':
+                identity = process_identity()
+                if identity == old_identity:
+                    raise AssertionFailure('Normal restart did not replace the application process')
+            assert_process(identity, 'normal feature observation')
+            assert_foreground('normal feature observation')
+
+        def invoke(operation, fields):
+            prefix, area, kind = operation.split('.')
+            return session.feature_operation(area, kind, fields)
+
+        def execute():
+            journey=Journey(args.area, run, url, invoke=invoke, witness=client.observe, activate=client.activate,
+                read_artifact=lambda name: read_private_artifact(ARTIFACT_DIR, name), image_policy=policy,
+                continuity=continuity, monotonic=time.monotonic, epoch_ms=lambda: time.time() * 1000,
+                sleep=time.sleep, report=lambda value: write_json('feature-journey-observation.json', value),
+                navigation_source=client.navigation_status if args.area=='world-navigation' else None,
+                after_cleanup_baseline=None if browser is None else browser.export.callback,
+                input_context=None if browser is None else browser.input_context,
+                poll_work_inclusive=browser is not None,
+                pico_peer_originals=None if browser is None or browser.peer_scope is None else browser.owner.archive.peer)
+            if browser is not None:browser.export.attach(journey)
+            journey.execute()
+
+        if args.area=='tablet-web' and session.pico_openxr and os.environ.get('OVERTE_PICO_FEATURE_TABLET_WEB')=='1':
+            from adapters.pico4.browser_session import PicoBrowserSession
+            whole=dict(id=uuid.uuid4().hex,startedMonotonic=whole_started,deadlineMonotonic=whole_started+120)
+            peer_scope=None
+            from adapters.normal_feature_state import PrivateFeatureState
+            selected=PrivateFeatureState(Path(os.environ.get('OVERTE_PICO_BROWSER_RUN_CONFIG',''))).read()
+            if type(selected) is dict and selected.get('picoBrowserRunConfigVersion')==3:
+                import hashlib
+                from module_support import TARGET
+                from adapters.pico4.parent_peer_credit import FixedParentPeerScope
+                peer_scope=FixedParentPeerScope(client.url,client.token,run,hashlib.sha256(TARGET.encode()).hexdigest(),wire_settlement=True,refresh_after_primary=True,server_receipts=True,defer_wire=True,poll_trace=True,decoder_workspace=True,closed_parts=True,joined_guards=True,literal_roots=True,joined_wire=True,root_io=True,current_graphs=True)
