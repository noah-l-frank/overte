+"""PRIVATE finite metadata sizing; a conservative bound, never budget authority.
+
+The caller must already own the fixed traversal scratch. Count aliases more
+than once rather than allocating a per-node identity table. No payload copy,
+current product sample, clock call, parser or builder runs during traversal.
+"""
+import sys
+from adapters.native_feature_observation import need
+
+SCRATCH=131072
+MAX_NODES=65536
+MAX_DEPTH=32
+
+def _walk(value,depth,counts):
+    counts[0]+=1;need(counts[0]<=MAX_NODES and depth<=MAX_DEPTH)
+    kind=type(value)
+    need(kind is dict or kind is list or kind is tuple or kind is str or kind is int
+        or kind is float or kind is bool or kind is type(None))
+    counts[1]+=sys.getsizeof(value)
+    if kind is dict:
+        for key,child in value.items():_walk(key,depth+1,counts);_walk(child,depth+1,counts)
+    elif kind is list or kind is tuple:
+        for child in value:_walk(child,depth+1,counts)
+
+def resident_upper(value):
+    counts=[0,0];_walk(value,0,counts)
+    return counts[1]
+
+def construction_bound(root,pages,command,maximum_new_parts,maximum_new_ranges,scope):
+    """Before candidate copies: bound fixed-profile root/page work lifetimes.
+
+    Six additional root/page representations conservatively cover the
+    existing prediction, CAS preparation/readback and exact-current check.
+    The part/range units exceed their complete64-bit scalar/container layouts.
+    This policy still needs independent review before runtime adoption.
+    """
+    need(type(maximum_new_parts) is int and 0<=maximum_new_parts<=512
+        and type(maximum_new_ranges) is int and 0<=maximum_new_ranges<=512)
+    root_bytes=resident_upper(root);scope_bytes=resident_upper(scope)
+    page_bytes=0
+    for page in pages:page_bytes=max(page_bytes,resident_upper(page))
+    command_bytes=resident_upper(command)
+    # No future graph is allocated to calculate these integers.2048 covers
+    # a part dict, all keys/hash/scalars and eight unsigned64-bit stat fields;
+    #256 covers a three-integer born-range list with its allocated capacity.
+    projected_root=root_bytes+scope_bytes+maximum_new_parts*2048+command_bytes+32768
+    projected_page=page_bytes+maximum_new_ranges*256+command_bytes+32768
+    return SCRATCH+6*projected_root+6*projected_page+8*65536
+
+def build_with_credit(bound,credit,builder):
+    need(type(bound) is int and type(credit) is int and SCRATCH<=bound<=credit)
+    return builder()
