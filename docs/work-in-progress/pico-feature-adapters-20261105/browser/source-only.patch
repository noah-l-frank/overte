+    def atomic_script(self,name,count):
+        return ('umask 077; '+f"directory='{REMOTE_DIRECTORY}'; "+f'expected={count}; '+
+            'mkdir -p "$directory" && chmod 700 "$directory" || exit 20; '+
+            f'temporary="$directory/{name}.tmp"; '+f'destination="$directory/{name}"; '+
+            'rm -f "$temporary"; '+'dd bs=1 count="$expected" of="$temporary" 2>/dev/null '+
+            '&& actual=$(wc -c < "$temporary") && [ "$actual" -eq "$expected" ] '+
+            '&& chmod 600 "$temporary" && mv -f "$temporary" "$destination"')
