+class DeclaredOpenXr:
+    def __init__(self,backend,*,lose_status=False):
+        assert type(lose_status) is bool
+        self.backend=backend;self.lose_status=lose_status
+        self.commands=None;self.grant=None;self.status=None;self.writes=[];self.failures=[];self.calls=[];self.acquired=[];self.consumer=None;self.produced=[]
+        self.profile=json.loads((Path(__file__).resolve().parents[0]/'profile.json').read_bytes())
+    def dispatch(self,value):
+        try:
+            raw=self.execute(value);self.produced.append(raw)
+            destination=self.backend.root/('openxr-cli-produced-'+str(len(self.produced))+'.bin')
+            with destination.open('xb') as stream:stream.write(raw);stream.flush();os.fsync(stream.fileno())
+            return dict(code=0,stdoutHex=raw.hex())
+        except BaseException as error:
+            self.failures.append((error,error.__traceback__));return dict(code=97,stdoutHex='')
+    def execute(self,value):
+        assert type(value) is dict and set(value)=={'argv','payloadHex'}
+        args=value['argv'];assert type(args) is list and all(type(x) is str for x in args)
+        assert type(value['payloadHex']) is str and len(value['payloadHex'])<=131072
+        payload=bytes.fromhex(value['payloadHex']);self.calls.append((tuple(args),payload))
+        assert args[:2]==['-P','5038']
+        target=self.backend.target
+        if args==['-P','5038','devices']:
+            assert not payload;return ('List of devices attached\n'+target+'\tdevice\n').encode()
+        assert args[2:4]==['-s',target]
+        command=args[4:]
+        if command==['get-state']:assert not payload;return b'device\n'
+        assert len(command) in (2,3)
+        remote=command[-1];parts=shlex.split(remote)
+        assert len(parts)==5 and parts[:4]==['run-as','org.overte.pico','sh','-c']
+        script=parts[4]
+        if command[:2]==['shell','-T']:
+            assert 0<len(payload)<=65536
+            name='commands.json' if '/commands.json.tmp' in script else 'grant.json' if '/grant.json.tmp' in script else None
+            assert name is not None
+            expected=self.atomic_script(name,len(payload));assert script==expected
+            self.acquired.append(payload)
+            destination=self.backend.root/('openxr-cli-original-'+str(len(self.acquired))+'.bin')
+            with destination.open('xb') as stream:stream.write(payload);stream.flush();os.fsync(stream.fileno())
+            original=json.loads(payload)
+            if name=='commands.json':
