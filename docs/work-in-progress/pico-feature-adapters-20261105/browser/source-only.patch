+#!/usr/bin/python3 -S
+"""Owned declared SDK executable; never invokes ADB or an external selector."""
+import json,os,socket,sys
+from pathlib import Path
+
+def main():
+    config=json.loads((Path(os.environ['OVT_CANONICAL_PREFIX_ROOT'])/'sdk-config.json').read_bytes())
+    argv=sys.argv[1:]
+    write=len(argv)>=6 and argv[4:6]==['shell','-T']
+    payload=sys.stdin.buffer.read(65537) if write else b''
+    if len(payload)>65536:raise ValueError('Declared bounded payload refused')
+    request=dict(token=config['token'],action='declared-openxr',value=dict(argv=argv,payloadHex=payload.hex()))
+    encoded=json.dumps(request,separators=(',',':')).encode()+b'\n'
+    if len(encoded)>262144:raise ValueError('Declared request bound refused')
+    with socket.create_connection(('127.0.0.1',config['port']),timeout=5) as stream:
+        stream.sendall(encoded)
+        with stream.makefile('rb') as source:raw=source.readline(262145)
+    if not raw.endswith(b'\n') or len(raw)>262144:raise ValueError('Declared response bound refused')
+    result=json.loads(raw)
+    if type(result) is not dict or set(result)!={'code','stdoutHex'} or type(result['code']) is not int or type(result['stdoutHex']) is not str:
+        raise ValueError('Declared response type refused')
+    output=bytes.fromhex(result['stdoutHex'])
+    if len(output)>65536:raise ValueError('Declared output bound refused')
+    sys.stdout.buffer.write(output);sys.stdout.buffer.flush();return result['code']
+
+if __name__=='__main__':
+    try:sys.exit(main())
+    except BaseException as error:
+        if type(error) is SystemExit:raise
+        sys.stderr.write('Declared SDK CLI refused\n');sys.exit(97)
