+"""PRIVATE failure-only actual byte custody + fixed numeric operand report.
+No runtime guard or first exception is replaced; no post-failure object mutation.
+"""
+import hashlib,http.client,io,json,os,socket,sys
+from pathlib import Path
+from test_after_primary import AfterPrimary,OWNERS
+
+ERRORS=[]
+
+def write_original(path,raw):
+    fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW|os.O_CLOEXEC,0o600)
+    try:
+        offset=0
+        while offset<len(raw):
+            count=os.write(fd,memoryview(raw)[offset:]);assert count>0;offset+=count
+        os.fsync(fd)
+    finally:os.close(fd)
+
+
+def preserve_failure(archive,error):
+    peer=archive._peer_registration[1];root=archive.path.parent
+    # Actual returned raw FIRST, before any diagnostic scalar/source access.
+    raw=peer.unconfirmed
+    if type(raw) is bytes:write_original(root/'failure-actual-unconfirmed.bin',raw)
+    report=dict(actualReturnedRawRetained=type(raw) is bytes,bodyBytes=len(raw) if type(raw) is bytes else None,
+        bodySha256=hashlib.sha256(raw).hexdigest() if type(raw) is bytes else None,
+        firstErrorIsOwner=peer.first_failure is not None and peer.first_failure[0] is error,
+        firstTracebackStrong=peer.first_failure is not None and peer.first_failure[1] is not None,
+        held=peer.held,issuedGrantSum=sum(peer.grants),raws=len(peer.raws),records=len(peer.records),
+        wireSettlements=[list(row) for row in peer.wire_settled],claims=[],locations=[],
+        diagnosticOnly=True,newRuntimeGuard=False,publicPrefix=False,globalNativeMemoryProof=False)
+    tb=error.__traceback__;frames=0
+    while tb is not None and frames<64:
+        report['locations'].append(dict(file=tb.tb_frame.f_code.co_filename,line=tb.tb_lineno,function=tb.tb_frame.f_code.co_name))
+        tb=tb.tb_next;frames+=1
+    for claim in peer.wire.claims:
+        row=dict(ordinal=claim.ordinal,finished=claim.finished,firstFailureNone=claim.first_failure is None,
+            exactResponse=type(claim.response) is http.client.HTTPResponse,responseFpNone=claim.response.fp is None,
+            responseClosed=claim.response.closed,exactFp=type(claim.fp) is io.BufferedReader,
+            exactRawIo=type(claim.raw_io) is socket.SocketIO,rawClosed=claim.raw_io.closed,rawSockNone=claim.raw_io._sock is None,
+            bufferSize=io.BufferedReader.__sizeof__(claim.fp),bufferBase=peer.wire.buffer_base,
+            metadataRecorded=claim.metadata_bytes,metadataFresh=peer.wire.metadata_extent(claim),
+            responseDictSize=sys.getsizeof(vars(claim.response)),headersDictSize=sys.getsizeof(vars(claim.response.headers)),
+            fpDictSize=sys.getsizeof(vars(claim.fp)),rawIoDictSize=sys.getsizeof(vars(claim.raw_io)),
+            capturedOriginal=claim.captured is claim._captured,
+            capturedResponse=claim.captured[0] is claim.response,capturedFp=claim.captured[1] is claim.fp,capturedRawIo=claim.captured[2] is claim.raw_io,
+            bodyIsRecordedRaw=claim.ordinal<len(peer.raws) and claim.body is peer.raws[claim.ordinal][0])
+        report['claims'].append(row)
+    write_original(root/'failure-numeric-operands.json',json.dumps(report,sort_keys=True).encode())
+
