<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>@OVT_SNAPSHOT_COMPANION_BUNDLE_ID@</string>
<key>CFBundleExecutable</key><string>overte-snapshot-companion</string>
<key>CFBundleName</key><string>Overte Snapshot Test Companion</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>OVTSnapshotCompanionContractVersion</key><integer>1</integer>
<key>OVTSnapshotCompanionRole</key><string>photos</string>
<key>CFBundleShortVersionString</key><string>1.0</string>
<key>CFBundleVersion</key><string>1</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>NSPhotoLibraryUsageDescription</key><string>Read and remove only the Snapshot asset explicitly selected by this test run.</string>
<key>UIFileSharingEnabled</key><true/>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
</dict></plist>
