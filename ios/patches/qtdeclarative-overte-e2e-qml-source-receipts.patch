+std::atomic<bool> overteE2eSourceEnabled { false };
+std::atomic<quint64> overteE2eSourceSequence { 0 };
+
+QVariantMap overteE2eCompilerInput(const QString &source, const QString &requested,
+                                 const QString &resolved)
+{
+    QT_TRY {
+    if (!overteE2eSourceEnabled.load(std::memory_order_acquire)
+            || source.isEmpty() || source.size() > 1024 * 1024)
+        return {};
+    static const QString instance = QUuid::createUuid().toString(QUuid::WithoutBraces)
+            .remove(QLatin1Char('-'));
+    const auto before = QDateTime::currentMSecsSinceEpoch();
+    QCryptographicHash hash(QCryptographicHash::Sha256);
+    // Exact decoded QString code units, not a guessed QFile encoding.
+    for (const QChar character : source) {
+        const auto unit = character.unicode();
+        const char bytes[2] { char(unit & 255), char(unit >> 8) };
+        hash.addData(QByteArrayView(bytes, 2));
+    }
+    const auto sequence = overteE2eSourceSequence.fetch_add(1) + 1;
+    if (sequence == 0 || sequence > 1000000000) {
+        overteE2eSourceEnabled.store(false, std::memory_order_release);
+        return {};
+    }
+    return {{QStringLiteral("qtOverteQmlCompilerInputVersion"), 1},
+            {QStringLiteral("instance"), instance},
+            {QStringLiteral("sequence"), qulonglong(sequence)},
+            {QStringLiteral("processId"), QCoreApplication::applicationPid()},
+            {QStringLiteral("qtVersion"), QString::fromLatin1(qVersion())},
+            {QStringLiteral("encoding"), QStringLiteral("utf16-le-code-units")},
+            {QStringLiteral("codeUnits"), qlonglong(source.size())},
+            {QStringLiteral("sha256"), QString::fromLatin1(hash.result().toHex())},
+            {QStringLiteral("requestedUrl"), requested},
+            {QStringLiteral("resolvedUrl"), resolved},
+            {QStringLiteral("sourceBeforeEpochMs"), before}};
+    } QT_CATCH (...) {
+        // Observation failure never changes the actual compiler input/result.
+        return {};
+    }
+}
+}
