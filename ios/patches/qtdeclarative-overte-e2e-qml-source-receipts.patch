+int QQmlTypeData::overteE2eSourceObservationApiVersion()
+{
+    return 1;
+}
+
+void QQmlTypeData::setOverteE2eSourceObservationEnabled(bool enabled)
+{
+    overteE2eSourceEnabled.store(false, std::memory_order_release);
+    QV4::OverteCacheOriginals::setEnabled(false);
+    QT_TRY {
+    const bool admitted = enabled && QCoreApplication::instance()
+            && QCoreApplication::arguments().contains(QStringLiteral("--testScript"));
+    overteE2eSourceEnabled.store(admitted, std::memory_order_release);
+    QV4::OverteCacheOriginals::setEnabled(admitted);
+    } QT_CATCH (...) {
+        // Remain disabled without changing ordinary application loading.
+    }
+}
+
+QVariantMap QQmlTypeData::overteE2eSourceReceiptForObject(
+        const QObject *object, const QQmlComponent *component)
+{
+    QT_TRY {
+        if (!overteE2eSourceEnabled.load(std::memory_order_acquire)
+                || !QCoreApplication::instance() || !object
+                || object->thread() != QThread::currentThread())
+            return {};
+        const auto *data = QQmlData::get(object);
+        if (!data || !data->compilationUnit)
+            return {};
+        const auto actual = data->compilationUnit;
+        if (component) {
+            if (component->thread() != QThread::currentThread()
+                    || !component->isReady() || component->isError())
+                return {};
+            const auto owner = QQmlComponentPrivate::get(
+                    const_cast<QQmlComponent *>(component))->compilationUnit();
+            if (owner.data() != actual.data())
+                return {};
+        }
+        const auto receipt = actual->overteE2eSourceReceipt();
+        const auto *unit = actual->unitData();
+        if (receipt.isEmpty() || !unit || unit->unitSize < sizeof(QV4::CompiledData::Unit)
+                || unit->unitSize > 4 * 1024 * 1024
+                || (unit->flags & QV4::CompiledData::Unit::PendingTypeCompilation)
+                || receipt.value(QStringLiteral("unitBytes")).toLongLong() != qint64(unit->unitSize)
+                || receipt.value(QStringLiteral("processId")).toLongLong() != QCoreApplication::applicationPid())
+            return {};
+        const auto bytes = QByteArray::fromRawData(reinterpret_cast<const char *>(unit),
+                                                  qsizetype(unit->unitSize));
+        const auto digest = QString::fromLatin1(QCryptographicHash::hash(
+                bytes, QCryptographicHash::Sha256).toHex());
+        if (receipt.value(QStringLiteral("unitSha256")).toString() != digest)
+            return {};
+        return receipt;
+    } QT_CATCH (...) {
+        return {};
+    }
+}
