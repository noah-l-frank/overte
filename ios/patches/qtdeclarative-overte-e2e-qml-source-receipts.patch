+{
+    QT_TRY {
+        if (!overteE2eSourceEnabled.load(std::memory_order_acquire)
+                || !QV4::OverteCacheOriginals::active() || !QCoreApplication::instance()
+                || !object || object->thread()!=QThread::currentThread()) return {};
+        QPointer<const QObject> weakObject(object);
+        QPointer<const QQmlComponent> weakComponent(component);
+        const auto *data=QQmlData::get(object);
+        if (!data || !data->compilationUnit) return {};
+        const auto *actual=data->compilationUnit.data();
+        if (component && (component->thread()!=QThread::currentThread() || !component->isReady()
+                || component->isError() || QQmlComponentPrivate::get(const_cast<QQmlComponent *>(component))
+                    ->overteE2eCompilationUnitIdentity()!=actual)) return {};
+        const auto unit=actual->overteE2eCacheOriginal();
+        const auto executableId=actual->overteE2eExecutableIdentity();
+        if (executableId.isEmpty() || unit.isEmpty() || unit.value(QStringLiteral("processId")).toLongLong()!=QCoreApplication::applicationPid()) return {};
+        const auto sourceUrl=actual->url().toString(QUrl::FullyEncoded);
+        const auto finalUrl=actual->finalUrl().toString(QUrl::FullyEncoded);
+        if (!weakObject || (component && !weakComponent)) return {};
+        const auto *current=QQmlData::get(object);
+        if (!current || current->compilationUnit.data()!=actual) return {};
+        if (component && QQmlComponentPrivate::get(const_cast<QQmlComponent *>(component))
+                    ->overteE2eCompilationUnitIdentity()!=actual) return {};
+        const auto reread=actual->overteE2eCacheOriginal();
+        auto originalIdentity=unit;auto currentIdentity=reread;
+        for (const auto &name : {QStringLiteral("unitReadBefore"),QStringLiteral("unitReadAfter")}) {
+            originalIdentity.remove(name);currentIdentity.remove(name);
+        }
+        if (reread.isEmpty() || originalIdentity!=currentIdentity || !weakObject
+                || actual->overteE2eExecutableIdentity()!=executableId) return {};
+        const auto *last=QQmlData::get(object);
+        if (!last || last->compilationUnit.data()!=actual || (component && (!weakComponent
+                || QQmlComponentPrivate::get(const_cast<QQmlComponent *>(component))
+                    ->overteE2eCompilationUnitIdentity()!=actual))) return {};
+        return {{QStringLiteral("qtOverteQmlObjectCacheReceiptVersion"),1},
+            {QStringLiteral("processId"),QCoreApplication::applicationPid()},
+            {QStringLiteral("executableUnitId"),executableId},
+            {QStringLiteral("componentMatched"),component!=nullptr},
+            {QStringLiteral("unitSourceUrl"),sourceUrl},{QStringLiteral("unitFinalUrl"),finalUrl},
+            {QStringLiteral("unit"),reread}};
+    } QT_CATCH (...) { QV4::OverteCacheOriginals::fail();return {}; }
+}
